APP_NAME=NovaNuke
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_KEY=

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=novanuke
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME=NovaNuke
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_TIMEOUT=15

SESSION_NAME=novanuke_session
SESSION_SECURE=false
SESSION_SAME_SITE=Lax
SESSION_LIFETIME=7200
SESSION_IDLE_TIMEOUT=1800
SESSION_ROTATION_INTERVAL=900
SESSION_PATH=/
SESSION_DOMAIN=

SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
