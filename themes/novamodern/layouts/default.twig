<!doctype html>
<html lang="{{ cms_locale|default('en') }}" style="--nova-accent: {{ theme.settings.accent_color|default('#5b8def') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ cms_name|default('NovaNuke') }}{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/app.css">
    <link rel="stylesheet" href="{{ theme.asset_base }}/css/novamodern.css?v={{ theme.version|default('1')|url_encode }}">
    {% if news_rss_url|default(null) %}<link rel="alternate" type="application/rss+xml" title="{{ cms_name|default('NovaNuke') }} News" href="{{ news_rss_url }}">{% endif %}
    {% block meta %}{% if cms_description|default('') %}<meta name="description" content="{{ cms_description }}">{% endif %}{% endblock %}
</head>
<body class="nova-modern {{ admin_area|default(false) ? 'nova-admin' : 'nova-public' }}" data-ajax-failed="{{ trans('common.ajax.failed') }}" data-ajax-refresh-failed="{{ trans('common.ajax.refresh_failed') }}" data-ajax-completed="{{ trans('common.ajax.completed') }}" data-ajax-attention="{{ trans('common.ajax.attention') }}" data-ajax-network-error="{{ trans('common.ajax.network_error') }}">
{% if admin_area|default(false) %}
    {% include 'partials/admin-header.twig' %}
    <div class="nova-workspace">
        {% include 'partials/admin-sidebar.twig' %}
        <main class="nova-content" id="main-content">
{% else %}
    {% include "blocks/region.twig" with {items: blocks['header']|default([]), position: 'header'} %}
    {% include 'partials/public-header.twig' %}
    <div class="nova-workspace">
        {% include 'partials/public-sidebar.twig' %}
        <main class="nova-public-main" id="main-content">
            {% include "blocks/region.twig" with {items: blocks['before-content']|default([]), position: 'before-content'} %}
            <div class="nova-content-grid {{ blocks['left-sidebar']|default([]) ? 'has-left-blocks' : '' }} {{ blocks['right-sidebar']|default([]) ? 'has-right-blocks' : '' }}">
                {% if blocks['left-sidebar']|default([]) %}<aside class="nova-block-column">{% include "blocks/region.twig" with {items: blocks['left-sidebar'], position: 'left-sidebar'} %}</aside>{% endif %}
                <section class="nova-page-content">
{% endif %}
{% block content %}{% endblock %}
{% if admin_area|default(false) %}
        </main>
    </div>
{% else %}
                </section>
                {% if blocks['right-sidebar']|default([]) %}<aside class="nova-block-column">{% include "blocks/region.twig" with {items: blocks['right-sidebar'], position: 'right-sidebar'} %}</aside>{% endif %}
            </div>
            {% include "blocks/region.twig" with {items: blocks['after-content']|default([]), position: 'after-content'} %}
        </main>
    </div>
    {% include "blocks/region.twig" with {items: blocks['footer']|default([]), position: 'footer'} %}
    {% include 'partials/public-footer.twig' %}
{% endif %}
<div class="nova-nav-overlay" data-nav-overlay hidden></div>
<script src="{{ theme.asset_base }}/js/navigation.js?v={{ theme.version|default('1')|url_encode }}" defer></script>
    <script src="/assets/js/progressive-actions.js" defer></script>
</body>
</html>
