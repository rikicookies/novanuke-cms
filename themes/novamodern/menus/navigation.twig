{% macro render(items, level = 0, asset_base = '') %}{% import 'partials/icon.twig' as icons %}{% if items %}<ul class="nova-menu nova-menu-level-{{ level }}">{% for item in items %}<li class="{{ item.children ? 'has-children' : '' }} {{ item.active ? 'is-active' : '' }}"><a href="{{ item.url }}" title="{{ item.title }}"{% if item.new_window %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ icons.render(item.icon|default(level == 0 ? 'link' : 'chevron'), asset_base) }}<span>{{ item.title }}</span></a>{% if item.children %}{{ _self.render(item.children, level + 1, asset_base) }}{% endif %}</li>{% endfor %}</ul>{% endif %}{% endmacro %}
