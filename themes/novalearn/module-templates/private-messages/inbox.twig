{% extends "layouts/default.twig" %}
{% block title %}{{ trans('private-messages::title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="messages-page nl-comms-page module-page">
    {% include 'components/breadcrumbs.twig' with {items: [{label: trans('private-messages::title')}]} only %}
    {% include 'components/page-header.twig' with {eyebrow: trans('private-messages::account'), title: trans('private-messages::title'), description: trans('private-messages::inbox.description')} only %}
    {% include "@private-messages/_nav.twig" %}
    {% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}
    {% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}

    <div class="nl-message-app">
        <aside class="nl-message-sidebar" aria-label="{{ trans('private-messages::title') }}">
            <a class="nl-compose-cta" href="/messages/compose">+ {{ trans('private-messages::nav.new') }}</a>
            <nav class="nl-message-folders">
                <a class="is-active" href="/messages"><span>✉</span>{{ trans('private-messages::nav.inbox') }}</a>
                <a href="/messages/sent"><span>↗</span>{{ trans('private-messages::nav.sent') }}</a>
                <a href="/messages/blocks"><span>⊘</span>{{ trans('private-messages::nav.blocked') }}</a>
            </nav>
        </aside>

        <div class="nl-message-panel">
            <div class="nl-message-panel-head">
                <div><span class="nl-kicker">{{ trans('private-messages::account') }}</span><h2>{{ trans('private-messages::nav.inbox') }}</h2></div>
                <a class="nl-quiet-action" href="/messages/compose">{{ trans('private-messages::nav.new') }}</a>
            </div>
            {% if conversations %}
            <div class="nl-conversation-list">
                {% for item in conversations %}
                <a class="nl-conversation-row {{ item.unread ? 'is-unread' : '' }}" href="/messages/{{ item.id }}">
                    <span class="nl-person-avatar" aria-hidden="true">{{ item.other_username|slice(0,1)|upper }}</span>
                    <span class="nl-conversation-main">
                        <span class="nl-conversation-top"><strong>{{ item.other_username }}</strong><time>{{ item.last_message_at }}</time></span>
                        <span class="nl-conversation-subject">{{ item.subject }}</span>
                    </span>
                    {% if item.unread %}<span class="nl-unread-dot" aria-hidden="true"></span>{% endif %}
                </a>
                {% endfor %}
            </div>
            {% else %}
                {% include 'components/empty-state.twig' with {title: trans('private-messages::inbox.empty'), message: trans('private-messages::inbox.empty_help'), action_url: '/messages/compose', action_label: trans('private-messages::inbox.start')} only %}
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
