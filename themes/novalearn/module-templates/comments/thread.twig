{% macro branch(items, content_type, content_id, csrf_token, return_to, current_user, guests_allowed, depth) %}
    {% import _self as tree %}
    {% for comment in items %}
        <article class="nl-comment nl-comment-depth-{{ depth }}" id="comment-{{ comment.id }}">
            <div class="nl-comment-avatar" aria-hidden="true">{{ comment.username|default(comment.guest_name|default(trans('comments::former_member'), true), true)|slice(0,1)|upper }}</div>
            <div class="nl-comment-main">
                <header class="nl-comment-header">
                    <div><strong>{{ comment.username|default(comment.guest_name|default(trans('comments::former_member'), true), true) }}</strong><small>{{ comment.created_at|date(cms_date_format, cms_timezone) }}{% if comment.edited_at %} · {{ trans('comments::edited') }}{% endif %}</small></div>
                </header>
                <div class="nl-comment-body">{{ comment.body_html }}</div>
                <div class="nl-comment-actions">
                    {% if current_user %}
                        <form method="post" action="/comments/{{ comment.id }}/react" data-ajax-action data-ajax-replace="#comment-{{ comment.id }}" data-ajax-success="{{ trans('comments::reaction_updated') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="{{ return_to }}"><input type="hidden" name="reaction" value="like"><button type="submit" class="nl-comment-action {{ comment.viewer_reaction == 'like' ? 'is-active' : '' }}">♡ {{ trans('comments::like') }} <span>{{ comment.like_count }}</span></button></form>
                        <form method="post" action="/comments/{{ comment.id }}/react" data-ajax-action data-ajax-replace="#comment-{{ comment.id }}" data-ajax-success="{{ trans('comments::reaction_updated') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="{{ return_to }}"><input type="hidden" name="reaction" value="dislike"><button type="submit" class="nl-comment-action {{ comment.viewer_reaction == 'dislike' ? 'is-active' : '' }}">↓ {{ trans('comments::dislike') }} <span>{{ comment.dislike_count }}</span></button></form>
                    {% else %}<span class="nl-comment-stat">♡ {{ trans('comments::like') }} · {{ comment.like_count }}</span><span class="nl-comment-stat">↓ {{ trans('comments::dislike') }} · {{ comment.dislike_count }}</span>{% endif %}
                    {% if current_user or guests_allowed %}<details class="nl-comment-menu"><summary>{{ trans('comments::reply') }}</summary><div class="nl-comment-popover"><form class="nl-comment-inline-form" method="post" action="/comments/{{ content_type }}/{{ content_id }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="{{ return_to }}"><input type="hidden" name="parent_id" value="{{ comment.id }}">{% if not current_user %}<label>{{ trans('comments::name') }}<input name="guest_name" required minlength="2" maxlength="100"></label>{% endif %}<label>{{ trans('comments::format') }}<select name="body_format"><option value="markdown">{{ trans('comments::markdown') }}</option><option value="html">{{ trans('comments::sanitized_html') }}</option></select></label><label>{{ trans('comments::reply_field') }}<textarea name="body" required minlength="2" maxlength="5000"></textarea></label><button type="submit">{{ trans('comments::submit_reply') }}</button></form></div></details>{% endif %}
                    {% if current_user and comment.user_id == current_user.id %}<details class="nl-comment-menu"><summary>{{ trans('comments::edit') }}</summary><div class="nl-comment-popover"><form class="nl-comment-inline-form" method="post" action="/comments/{{ comment.id }}/edit"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="{{ return_to }}"><label>{{ trans('comments::format') }}<select name="body_format"><option value="markdown">{{ trans('comments::markdown') }}</option><option value="html" {{ comment.body_format == 'html' ? 'selected' : '' }}>{{ trans('comments::sanitized_html') }}</option></select></label><label>{{ trans('comments::comment') }}<textarea name="body" required minlength="2" maxlength="5000">{{ comment.body }}</textarea></label><button type="submit">{{ trans('comments::save') }}</button></form></div></details>{% endif %}
                    <details class="nl-comment-menu nl-comment-report"><summary>{{ trans('comments::report') }}</summary><div class="nl-comment-popover"><form class="nl-comment-inline-form" method="post" action="/comments/{{ comment.id }}/report"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="{{ return_to }}"><label>{{ trans('comments::reason') }}<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><button type="submit">{{ trans('comments::send_report') }}</button></form></div></details>
                </div>
                {% if comment.children %}<div class="nl-comment-children">{{ tree.branch(comment.children, content_type, content_id, csrf_token, return_to, current_user, guests_allowed, depth + 1) }}</div>{% endif %}
            </div>
        </article>
    {% endfor %}
{% endmacro %}
{% import _self as tree %}
<section class="nl-comment-thread comments-section" id="comments">
    <header class="nl-comment-section-header"><div><p class="nl-eyebrow">{{ trans('comments::eyebrow') }}</p><h2>{{ trans('comments::title') }}</h2></div></header>
    {% if message %}<div class="nl-comment-notice is-success">{{ message }}</div>{% endif %}
    {% if error %}<div class="nl-comment-notice is-error">{{ error }}</div>{% endif %}
    {% if current_user or guests_allowed %}
        <form class="nl-comment-composer" method="post" action="/comments/{{ content_type }}/{{ content_id }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="{{ return_to }}">
            <div class="nl-comment-composer-top"><div class="nl-comment-avatar">{{ current_user ? current_user.username|default('U')|slice(0,1)|upper : '?' }}</div><label class="nl-comment-write"><span>{{ trans('comments::your_comment') }}</span><textarea name="body" required minlength="2" maxlength="5000"></textarea></label></div>
            <div class="nl-comment-composer-footer">{% if not current_user %}<label>{{ trans('comments::name') }}<input name="guest_name" required minlength="2" maxlength="100"></label>{% endif %}<label>{{ trans('comments::format') }}<select name="body_format"><option value="markdown">{{ trans('comments::markdown') }}</option><option value="html">{{ trans('comments::sanitized_html') }}</option></select></label><button type="submit">{{ trans('comments::post_comment') }}</button></div>
        </form>
    {% else %}<div class="nl-comment-signin"><a href="/login">{{ trans('comments::sign_in') }}</a> {{ trans('comments::sign_in_help') }}</div>{% endif %}
    {% if comments is not empty %}<div class="nl-comment-list">{{ tree.branch(comments, content_type, content_id, csrf_token, return_to, current_user, guests_allowed, 0) }}</div>{% else %}{% include 'components/empty-state.twig' with {title: trans('comments::empty'), message: trans('comments::empty_help')} only %}{% endif %}
</section>
