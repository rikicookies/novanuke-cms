{% extends "layouts/default.twig" %}
{% block title %}{{ trans('news::title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="nl-news-index">
    {% include 'components/breadcrumbs.twig' with {items: [{label: trans('news::title')}]} only %}
    <header class="nl-page-heading">
        <div><span class="nl-eyebrow">{{ trans('news::latest') }}</span><h1>{{ trans('news::title') }}</h1><p>{{ trans('news::description') }}</p></div>
        <div class="nl-heading-actions">{% if manage_url %}<a href="{{ manage_url }}">{{ trans('news::manage') }}</a>{% endif %}<a href="/news/rss.xml">RSS</a></div>
    </header>
    <nav class="nl-filter-tabs" aria-label="{{ trans('news::title') }}"><a class="{{ not selected_category ? 'is-active' : '' }}" href="/news">{{ trans('news::all') }}</a>{% for category in categories %}<a class="{{ selected_category == category.slug ? 'is-active' : '' }}" href="/news/category/{{ category.slug }}">{{ category.name }}</a>{% endfor %}</nav>

    {% if result.items|length %}
        {% set featured = result.items|first %}
        <article class="nl-feature-story {{ featured.featured_image ? 'has-image' : '' }}">
            <div class="nl-feature-copy">
                <div class="nl-kicker">{% if featured.is_featured %}<span class="nl-badge nl-badge-blue">{{ trans('news::featured') }}</span>{% endif %}<span class="nl-category-pill">{{ featured.category_name|default(trans('news::latest'), true) }}</span></div>
                <h2><a href="/news/{{ featured.slug }}">{{ featured.title }}</a></h2>
                <div class="nl-summary">{{ featured.summary_html }}</div>
                <div class="nl-story-meta"><span class="nl-avatar">{{ featured.username|slice(0,1)|upper }}</span><strong>{{ featured.username }}</strong><span>•</span><span>{{ featured.published_at|date(cms_date_format, cms_timezone) }}</span><span>•</span><span>{{ trans('news::views', {count: featured.view_count}) }}</span></div>
                <a class="nl-primary-button" href="/news/{{ featured.slug }}">{{ trans('news::read') }} <span>→</span></a>
            </div>
            <a class="nl-feature-media" href="/news/{{ featured.slug }}" aria-label="{{ featured.title }}">
                {% if featured.featured_image %}<img src="{{ featured.featured_image }}" alt="">{% else %}<div class="nl-code-art"><span>&lt;/&gt;</span></div>{% endif %}
            </a>
        </article>

        {% if categories|length %}<section class="nl-topic-strip"><div class="nl-section-heading"><div><span class="nl-eyebrow">{{ trans('theme::explore_topics') }}</span><h2>{{ trans('theme::categories') }}</h2></div></div><div class="nl-topic-grid">{% for category in categories|slice(0,4) %}<a class="nl-topic-card nl-topic-{{ (loop.index0 % 4) + 1 }}" href="/news/category/{{ category.slug }}"><span class="nl-topic-icon">{{ category.name|slice(0,2)|upper }}</span><strong>{{ category.name }}</strong><small>{{ trans('theme::browse_topic') }}</small></a>{% endfor %}</div></section>{% endif %}

        {% if result.items|length > 1 %}<section class="nl-latest-section"><div class="nl-section-heading"><div><span class="nl-eyebrow">{{ trans('news::more') }}</span><h2>{{ trans('news::latest_from') }}</h2></div><span class="nl-count">{{ trans('news::published', {count: result.total}) }}</span></div><div class="nl-story-grid">{% for article in result.items|slice(1) %}<article class="nl-story-card">
            <a class="nl-story-image" href="/news/{{ article.slug }}">{% if article.featured_image %}<img src="{{ article.featured_image }}" alt="">{% else %}<div class="nl-story-placeholder"><span>&lt;/&gt;</span></div>{% endif %}</a>
            <div class="nl-story-body"><div class="nl-kicker"><span class="nl-category-pill">{{ article.category_name|default(trans('news::uncategorized'), true) }}</span>{% if article.is_featured %}<span class="nl-badge nl-badge-blue">{{ trans('news::featured') }}</span>{% endif %}</div><h3><a href="/news/{{ article.slug }}">{{ article.title }}</a></h3><div class="nl-summary nl-card-summary">{{ article.summary_html }}</div><div class="nl-story-meta"><span class="nl-avatar nl-avatar-small">{{ article.username|slice(0,1)|upper }}</span><span>{{ article.username }}</span><span>•</span><span>{{ article.published_at|date(cms_date_format, cms_timezone) }}</span></div></div>
        </article>{% endfor %}</div></section>{% endif %}
    {% else %}{% include 'components/empty-state.twig' with {title: trans('news::empty'), message: trans('news::empty_help')} only %}{% endif %}
    {% include 'components/pagination.twig' with {current_page: result.page, total_pages: result.pages, url_template: '?page={page}', label: trans('news::pagination')} only %}
</section>
{% endblock %}
