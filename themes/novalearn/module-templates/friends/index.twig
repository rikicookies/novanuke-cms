{% extends "layouts/default.twig" %}
{% block title %}{{ trans('friends::title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="friends-page module-page nl-account-page nl-friends-page">
{% include 'components/breadcrumbs.twig' with {items: [{label: trans('friends::title')}]} only %}
<header class="nl-account-hero"><div><span class="nl-kicker">{{ trans('friends::eyebrow') }}</span><h1>{{ trans('friends::title') }}</h1><p>{{ trans('friends::description') }}</p></div></header>
<div class="nl-profile-nav nl-account-tabs">{% include "auth/_social-nav.twig" %}</div>
{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}
{% set groups=[{slug:'received',title:trans('friends::group.received'),people:received},{slug:'friends',title:trans('friends::group.friends'),people:friends},{slug:'sent',title:trans('friends::group.sent'),people:sent},{slug:'blocked',title:trans('friends::group.blocked'),people:blocked}] %}
<div class="nl-friend-groups">{% for group in groups %}<section class="nl-surface nl-friend-group"><div class="nl-friend-group-head"><div><h2>{{ group.title }}</h2><p>{{ group.people|length == 1 ? trans('friends::person') : trans('friends::people', {count: group.people|length}) }}</p></div><span class="nl-friend-count">{{ group.people|length }}</span></div>{% if group.people %}<div class="nl-friend-list">{% for person in group.people %}<article class="nl-friend-card"><a href="/users/{{ person.username }}">{% if person.avatar_path %}<img class="nl-profile-avatar nl-profile-avatar-small" src="{{ person.avatar_path }}" alt="">{% else %}<div class="nl-profile-avatar nl-profile-avatar-small nl-profile-avatar-placeholder">{{ person.display_name|default(person.username,true)|slice(0,1)|upper }}</div>{% endif %}</a><div class="nl-friend-person"><h3><a href="/users/{{ person.username }}">{{ person.display_name|default(person.username,true) }}</a></h3><p>@{{ person.username }}</p></div><div class="nl-friend-actions">{% if group.slug == 'received' %}<form method="post" action="/friends/accept/{{ person.id }}" data-ajax-action data-ajax-replace=".friends-page" data-ajax-success="{{ trans('friends::accepted_ajax') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="nl-btn nl-btn-primary">{{ trans('friends::accept') }}</button></form><form method="post" action="/friends/decline/{{ person.id }}" data-ajax-action data-ajax-replace=".friends-page" data-ajax-success="{{ trans('friends::declined_ajax') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="nl-btn nl-btn-quiet">{{ trans('friends::decline') }}</button></form>{% elseif group.slug == 'friends' %}<a class="nl-btn nl-btn-secondary" href="/messages/compose?recipient={{ person.username|url_encode }}">{{ trans('friends::message') }}</a><form method="post" action="/friends/remove/{{ person.id }}" data-ajax-action data-ajax-replace=".friends-page" data-ajax-success="{{ trans('friends::removed_ajax') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="nl-btn nl-btn-quiet">{{ trans('friends::remove') }}</button></form>{% elseif group.slug == 'blocked' %}<form method="post" action="/friends/unblock/{{ person.id }}" data-ajax-action data-ajax-replace=".friends-page" data-ajax-success="{{ trans('friends::unblocked_ajax') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="nl-btn nl-btn-secondary">{{ trans('friends::unblock') }}</button></form>{% endif %}</div></article>{% endfor %}</div>{% else %}<div class="nl-friend-empty"><span>○</span><strong>{{ trans('friends::empty') }}</strong><p>{{ group.slug == 'friends' ? trans('friends::empty_friends') : trans('friends::empty_group') }}</p></div>{% endif %}</section>{% endfor %}</div>
</section>
{% endblock %}
