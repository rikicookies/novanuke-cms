{% extends "layouts/default.twig" %}
{% block title %}{{ trans('web-links::submit') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="nl-link-submit">
  {% include 'components/breadcrumbs.twig' with {items: [{label: trans('web-links::title'), url: '/links'}, {label: trans('web-links::submit')}]} only %}
  <header class="nl-page-heading nl-links-heading"><div><span class="nl-eyebrow">{{ trans('web-links::submit.eyebrow') }}</span><h1>{{ trans('web-links::submit') }}</h1><p>{{ trans('web-links::submit.description') }}</p></div></header>
  {% if error %}<div class="form-errors"><p>{{ error }}</p></div>{% endif %}
  <form class="nl-link-submit-form" method="post" action="/links/submit"><input type="hidden" name="_token" value="{{ csrf_token }}">
    <div class="nl-link-submit-grid"><label>{{ trans('web-links::field.title') }}<input name="title" required maxlength="200" value="{{ link.title|default('') }}"></label><label>{{ trans('web-links::field.slug') }}<input name="slug" required maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ link.slug|default('') }}"></label><label>{{ trans('web-links::field.url') }}<input type="url" name="url" required maxlength="2048" value="{{ link.url|default('') }}"></label><label>{{ trans('web-links::field.category') }}<select name="category_id"><option value="">{{ trans('web-links::field.none') }}</option>{% for category in categories %}<option value="{{ category.id }}" {{ link.category_id|default(null) == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></label><label>{{ trans('web-links::field.image_path') }}<input name="image_path" maxlength="255" placeholder="{{ trans('web-links::field.image_placeholder') }}" value="{{ link.image_path|default('') }}"></label><label>{{ trans('web-links::field.content_format') }}<select name="description_format"><option value="markdown" {{ link.description_format|default('markdown') == 'markdown' ? 'selected' : '' }}>{{ trans('web-links::field.markdown') }}</option><option value="html" {{ link.description_format|default('markdown') == 'html' ? 'selected' : '' }}>{{ trans('web-links::field.html') }}</option></select></label></div>
    <label class="nl-link-submit-description">{{ trans('web-links::field.description') }}<textarea name="description" required rows="8">{{ link.description|default('') }}</textarea><small>{{ trans('web-links::field.sanitized_help') }}</small></label>
    <div class="nl-link-submit-actions"><button class="nl-primary-button" type="submit">{{ trans('web-links::submit_for_review') }}</button><a href="/links">{{ trans('web-links::cancel') }}</a></div>
  </form>
</section>
{% endblock %}
