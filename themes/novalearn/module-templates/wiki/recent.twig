{% extends "layouts/default.twig" %}{% block title %}{{ trans('wiki::recent.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}<section class="nl-wiki-utility">{% include 'components/breadcrumbs.twig' with {items: [{label: trans('wiki::index.title'), url: '/wiki'}, {label: trans('wiki::recent.title')}]} only %}<header class="nl-wiki-hero"><div class="nl-wiki-hero-copy"><p class="nl-wiki-kicker">{{ trans('wiki::index.eyebrow') }}</p><h1>{{ trans('wiki::recent.title') }}</h1><p>{{ trans('wiki::recent.description') }}</p></div></header><div class="nl-wiki-page-list">{% for page in pages %}<a class="nl-wiki-page-row" href="/wiki/{{ page.namespace ? page.namespace ~ ':' : '' }}{{ page.slug }}"><span><h2>{{ page.title }}</h2><small class="nl-wiki-page-path">{{ page.updated_at|date(cms_date_format, cms_timezone) }}{% if page.audience != 'public' %}<span class="nl-wiki-audience">{{ page.audience == 'vip' ? trans('wiki::audience.vip') : trans('wiki::audience.members') }}</span>{% endif %}</small></span><span class="nl-wiki-arrow">→</span></a>{% else %}<div class="nl-wiki-empty">{{ trans('wiki::recent.empty') }}</div>{% endfor %}</div></section>{% endblock %}
