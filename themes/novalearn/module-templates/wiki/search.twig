{% extends "layouts/default.twig" %}{% block title %}{{ trans('wiki::search.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}<section class="nl-wiki-utility">{% include 'components/breadcrumbs.twig' with {items: [{label: trans('wiki::index.title'), url: '/wiki'}, {label: trans('wiki::search.title')}]} only %}<header class="nl-wiki-hero"><div class="nl-wiki-hero-copy"><p class="nl-wiki-kicker">{{ trans('wiki::index.eyebrow') }}</p><h1>{{ trans('wiki::search.title') }}</h1><p>{{ trans('wiki::search.description') }}</p></div></header><div class="nl-wiki-utility-card"><form class="nl-wiki-search-form" method="get" action="/wiki/search"><label>{{ trans('wiki::search.label') }}<input type="search" name="q" value="{{ term }}" minlength="2" maxlength="100" required></label><button type="submit">{{ trans('wiki::action.search') }}</button></form>{% if error %}<div class="form-errors"><ul><li>{{ error }}</li></ul></div>{% endif %}</div>{% if searched %}<div class="nl-wiki-page-list">{% for page in results %}<a class="nl-wiki-page-row" href="/wiki/{{ page.namespace ? page.namespace ~ ':' : '' }}{{ page.slug }}"><span><h2>{{ page.title }}</h2><small class="nl-wiki-page-path">{{ page.updated_at|date(cms_date_format, cms_timezone) }}{% if page.audience != 'public' %}<span class="nl-wiki-audience">{{ page.audience == 'vip' ? trans('wiki::audience.vip') : trans('wiki::audience.members') }}</span>{% endif %}</small></span><span class="nl-wiki-arrow">→</span></a>{% else %}<div class="nl-wiki-empty">{{ trans('wiki::search.empty') }} {{ trans('wiki::search.empty_help') }}</div>{% endfor %}</div>{% endif %}</section>{% endblock %}
