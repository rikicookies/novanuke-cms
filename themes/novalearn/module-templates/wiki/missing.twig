{% extends "layouts/default.twig" %}{% block title %}{{ trans('wiki::missing.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}<section class="nl-wiki-missing">{% include 'components/breadcrumbs.twig' with {items: [{label: trans('wiki::index.title'), url: '/wiki'}, {label: trans('wiki::missing.title')}]} only %}<div class="nl-wiki-missing-card"><span class="nl-wiki-article-path">{{ path }}</span><h1>{{ trans('wiki::missing.title') }}</h1><p>{{ trans('wiki::missing.description') }}</p><div class="nl-wiki-actions" style="justify-content:center">{% if action_url %}<a class="nl-wiki-btn nl-wiki-btn-primary" href="{{ action_url }}">{{ trans(draft_exists ? 'wiki::missing.edit_draft' : 'wiki::missing.create') }}</a>{% endif %}<a class="nl-wiki-btn" href="/wiki">{{ trans('wiki::action.return') }}</a></div></div></section>{% endblock %}
