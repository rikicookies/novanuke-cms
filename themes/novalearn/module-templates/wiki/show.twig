{% extends "layouts/default.twig" %}
{% block title %}{{ page.title }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block meta %}<link rel="canonical" href="{{ cms_url }}/wiki/{{ page.path }}">{% if page.audience != 'public' %}<meta name="robots" content="noindex,nofollow">{% endif %}{% endblock %}
{% block content %}
<section class="nl-wiki-show">
{% include 'components/breadcrumbs.twig' with {items: breadcrumbs} only %}
<div class="nl-wiki-toolbar"><a class="nl-wiki-btn" href="/wiki">{{ trans('wiki::action.return') }}</a><a class="nl-wiki-btn" href="/wiki/search">{{ trans('wiki::action.search') }}</a><a class="nl-wiki-btn" href="/wiki/map">{{ trans('wiki::action.map') }}</a>{% if edit_url %}<a class="nl-wiki-btn nl-wiki-btn-primary" href="{{ edit_url }}">{{ trans('wiki::action.edit') }}</a>{% endif %}</div>
<div class="nl-wiki-reader">
  <aside class="nl-wiki-reader-nav"><section class="nl-wiki-sidecard"><h2 class="nl-wiki-sidecard-title">{{ trans('theme::wiki_navigation') }}</h2><nav class="nl-wiki-side-links"><a class="is-current" href="/wiki">{{ trans('wiki::index.title') }}</a><a href="/wiki/search">{{ trans('wiki::action.search') }}</a><a href="/wiki/map">{{ trans('wiki::action.map') }}</a><a href="/wiki/recent">{{ trans('wiki::action.recent') }}</a></nav></section><section class="nl-wiki-sidecard"><h2 class="nl-wiki-sidecard-title">{{ trans('theme::wiki_current_path') }}</h2><nav class="nl-wiki-tree-path">{% for item in breadcrumbs %}{% if item.url %}<a href="{{ item.url }}">{{ item.label }}</a>{% else %}<span>{{ item.label }}</span>{% endif %}{% endfor %}</nav></section></aside>
  <main class="nl-wiki-reader-main"><article class="nl-wiki-article"><header class="nl-wiki-article-head"><p class="nl-wiki-article-path">{{ page.path }}</p><h1>{{ page.title }}</h1><div class="nl-wiki-meta"><span>{{ trans('wiki::page.updated', {date: page.updated_at|date(cms_date_format, cms_timezone), author: page.username}) }}</span>{% if page.audience != 'public' %}<span class="nl-wiki-audience">{{ page.audience == 'vip' ? trans('wiki::audience.vip') : trans('wiki::audience.members') }}</span>{% endif %}</div></header><div class="nl-wiki-reading" data-wiki-reading>{{ page.content_html }}</div></article>
    {% if comments_available %}<div class="nl-wiki-comments">{% include '@comments/thread.twig' with {content_type:'wiki',content_id:page.id,comments:comments,guests_allowed:comments_guests_allowed,csrf_token:comments_csrf_token,return_to:comments_return_to,message:comments_message,error:comments_error,current_user:comments_user} only %}</div>{% elseif page.comments_enabled|default(0) %}<p class="comments-unavailable">{{ trans('wiki::comments_unavailable') }}</p>{% endif %}</main>
  <aside class="nl-wiki-reader-toc"><section class="nl-wiki-sidecard"><h2 class="nl-wiki-sidecard-title">{{ trans('theme::wiki_contents') }}</h2><ul class="nl-wiki-toc-list" data-wiki-toc data-empty-label="{{ trans('theme::wiki_no_headings') }}"></ul></section>{% if attachments %}<section class="nl-wiki-sidecard"><h2 class="nl-wiki-sidecard-title">{{ trans('wiki::attachments.title') }}</h2><ul class="nl-wiki-resource-list">{% for attachment in attachments %}<li><a href="/wiki/attachments/{{ attachment.id }}">{{ attachment.original_name }}<br><small>{{ trans('wiki::attachments.size', {size: attachment.file_size}) }}</small></a></li>{% endfor %}</ul></section>{% endif %}{% if backlinks %}<section class="nl-wiki-sidecard"><h2 class="nl-wiki-sidecard-title">{{ trans('wiki::backlinks.title') }}</h2><ul class="nl-wiki-resource-list">{% for backlink in backlinks %}<li><a href="/wiki/{{ backlink.path }}">{{ backlink.title }}<br><small>{{ backlink.path }}</small></a></li>{% endfor %}</ul></section>{% endif %}</aside>
</div>
<script src="{{ theme.asset_base }}/js/wiki-toc.js?v={{ theme.version|default('1')|url_encode }}" defer></script>
</section>
{% endblock %}
