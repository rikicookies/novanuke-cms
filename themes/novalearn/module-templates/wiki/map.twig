{% extends "layouts/default.twig" %}{% macro namespace_tree(namespaces) %}<ul class="nl-wiki-map-tree">{% for namespace in namespaces %}<li><details open><summary><a href="/wiki?namespace={{ namespace.path|url_encode }}">{{ namespace.label }}</a></summary>{% if namespace.pages %}<ul>{% for page in namespace.pages %}<li><a href="/wiki/{{ page.path }}">{{ page.title }}</a>{% if page.audience != 'public' %} <span class="nl-wiki-audience">{{ page.audience == 'vip' ? trans('wiki::audience.vip') : trans('wiki::audience.members') }}</span>{% endif %}</li>{% endfor %}</ul>{% endif %}{% if namespace.namespaces %}{{ _self.namespace_tree(namespace.namespaces) }}{% endif %}</details></li>{% endfor %}</ul>{% endmacro %}{% block title %}{{ trans('wiki::map.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}<section class="nl-wiki-utility">{% include 'components/breadcrumbs.twig' with {items: [{label: trans('wiki::index.title'), url: '/wiki'}, {label: trans('wiki::map.title')}]} only %}<header class="nl-wiki-hero"><div class="nl-wiki-hero-copy"><p class="nl-wiki-kicker">{{ trans('wiki::index.eyebrow') }}</p><h1>{{ trans('wiki::map.title') }}</h1><p>{{ trans('wiki::map.description') }}</p></div></header><div class="nl-wiki-utility-card">{% if map.pages %}<section><h2>{{ trans('wiki::map.root') }}</h2><ul class="nl-wiki-map-root">{% for page in map.pages %}<li><a href="/wiki/{{ page.path }}">{{ page.title }}</a>{% if page.audience != 'public' %} <span class="nl-wiki-audience">{{ page.audience == 'vip' ? trans('wiki::audience.vip') : trans('wiki::audience.members') }}</span>{% endif %}</li>{% endfor %}</ul></section>{% endif %}{% if map.namespaces %}{{ _self.namespace_tree(map.namespaces) }}{% endif %}{% if not map.pages and not map.namespaces %}<div class="nl-wiki-empty">{{ trans('wiki::map.empty') }} {{ trans('wiki::map.empty_help') }}</div>{% endif %}</div></section>{% endblock %}
