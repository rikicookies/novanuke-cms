{% extends "layouts/default.twig" %}
{% block title %}{{ trans('notifications::title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="notifications-page nl-comms-page module-page">
    {% include 'components/breadcrumbs.twig' with {items: [{label: trans('notifications::title')}]} only %}
    {% include 'components/page-header.twig' with {eyebrow: trans('notifications::account'), title: trans('notifications::title'), description: trans('notifications::unread_count', {count: notification_unread_count})} only %}
    {% include "auth/_social-nav.twig" %}
    {% if marked_count is not null %}<p class="alert alert-success">{{ trans('notifications::marked', {count: marked_count}) }}</p>{% endif %}

    <div class="nl-notification-shell">
        <div class="nl-notification-head"><div><span class="nl-kicker">{{ trans('notifications::account') }}</span><h2>{{ trans('notifications::title') }}</h2></div>{% if notification_unread_count > 0 %}<form id="notification-read-all" method="post" action="/notifications/read-all" data-ajax-action data-ajax-replace=".notifications-page" data-ajax-success="{{ trans('notifications::marked_all') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="nl-quiet-action" type="submit">{{ trans('notifications::mark_all') }}</button></form>{% endif %}</div>
        {% if notifications %}
        <div class="nl-activity-feed">
            {% for item in notifications %}
            <article class="nl-activity-item {{ item.read_at ? '' : 'is-unread' }}" id="notification-{{ item.id }}">
                <div class="nl-activity-marker"><span>{{ item.type|default('•')|slice(0,1)|upper }}</span></div>
                <div class="nl-activity-copy"><div class="nl-activity-top"><h3>{{ item.title }}</h3><time>{{ item.created_at }}</time></div><p>{{ item.message }}</p><div class="nl-activity-actions">{% if item.url %}<a href="{{ item.url }}">{{ trans('notifications::open') }}</a>{% endif %}{% if not item.read_at %}<form method="post" action="/notifications/{{ item.id }}/read" data-ajax-action data-ajax-replace=".notifications-page" data-ajax-success="{{ trans('notifications::marked_one') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><button type="submit">{{ trans('notifications::mark_read') }}</button></form>{% endif %}</div></div>
            </article>
            {% endfor %}
        </div>
        {% else %}{% include 'components/empty-state.twig' with {title: trans('notifications::empty'), message: trans('notifications::empty_help')} only %}{% endif %}
    </div>
</section>
{% endblock %}
