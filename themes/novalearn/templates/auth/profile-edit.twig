{% extends "layouts/default.twig" %}
{% block title %}{{ trans('account.profile.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="nl-account-page nl-account-settings">
    {% include 'components/breadcrumbs.twig' with {items: [{label: trans('theme::account_center')}]} only %}
    <header class="nl-account-hero"><div><span class="nl-kicker">{{ trans('account.settings') }}</span><h1>{{ trans('account.profile.title') }}</h1><p>{{ trans('theme::account_intro') }}</p></div>{% if profile.username|default('') %}<a class="nl-btn nl-btn-secondary" href="/users/{{ profile.username }}">{{ trans('account.profile.public') }}</a>{% endif %}</header>
    <div class="nl-profile-nav nl-account-tabs">{% include "auth/_social-nav.twig" %}</div>
    {% if current_user.must_change_password|default(false) %}<div class="alert alert-warning">{{ trans('account.profile.must_change_password') }}</div>{% endif %}
    {% if message|default(null) %}<div class="alert alert-success">{{ message }}</div>{% endif %}
    <div class="nl-account-summary">
        <div class="nl-account-avatar-summary">{% if profile.avatar_path|default(null) %}<img class="nl-profile-avatar nl-profile-avatar-small" src="{{ profile.avatar_path }}" alt="">{% else %}<div class="nl-profile-avatar nl-profile-avatar-small nl-profile-avatar-placeholder">{{ profile.display_name|default(profile.username)|slice(0,1)|upper }}</div>{% endif %}<div><strong>{{ profile.display_name|default(profile.username) }}</strong><span>@{{ profile.username|default('') }}</span></div></div>
        <div class="nl-membership-chip">{% if membership.vip|default(false) %}<strong>{{ trans('account.membership.active', {name: membership.name|default(trans('profile.vip'))}) }}</strong>{% if membership.lifetime|default(false) %}<span>{{ trans('account.membership.lifetime') }}</span>{% else %}<span>{{ trans('account.membership.expires', {date: membership.expires_at|date(cms_date_format ~ ' H:i', cms_timezone)}) }}</span>{% endif %}{% else %}<strong>{{ trans('account.membership.free') }}</strong><span>{{ trans('account.membership.free_help') }}</span>{% endif %}</div>
    </div>
    {% if scheduled_membership|default(null) %}<div class="notice-message"><strong>{{ trans('account.membership.scheduled', {name: scheduled_membership.name|default(trans('profile.vip'))}) }}</strong> {{ trans('account.membership.starts', {date: scheduled_membership.starts_at|date(cms_date_format ~ ' H:i', cms_timezone)}) }} {% if scheduled_membership.lifetime|default(false) %}{{ trans('account.membership.lifetime_after') }}{% elseif scheduled_membership.expires_at|default(null) %}{{ trans('account.membership.ends', {date: scheduled_membership.expires_at|date(cms_date_format ~ ' H:i', cms_timezone)}) }}{% endif %}</div>{% endif %}
    <div class="nl-account-grid">
        <section class="nl-surface nl-account-main"><div class="nl-section-heading"><span class="nl-section-icon">✎</span><div><h2>{{ trans('theme::profile_information') }}</h2><p>{{ trans('theme::profile_information_help') }}</p></div></div>
            <form method="post" action="/account/profile" class="settings-form nl-form"><input type="hidden" name="_token" value="{{ csrf_token }}">
                <label>{{ trans('account.profile.display_name') }}<input name="display_name" value="{{ profile.display_name|default('') }}" minlength="2" maxlength="100" required>{% if errors.display_name|default(null) %}<small class="field-error">{{ errors.display_name }}</small>{% endif %}</label>
                <div class="nl-form-grid"><label>{{ trans('account.profile.bio_format') }}<select name="bio_format"><option value="markdown" {{ profile.bio_format|default('markdown') == 'markdown' ? 'selected' : '' }}>{{ trans('account.profile.markdown') }}</option><option value="html" {{ profile.bio_format|default('markdown') == 'html' ? 'selected' : '' }}>{{ trans('account.profile.sanitized_html') }}</option></select></label><label>{{ trans('account.profile.visibility') }}<select name="profile_visibility"><option value="public"{% if profile.profile_visibility|default('public') == 'public' %} selected{% endif %}>{{ trans('account.profile.visibility_public') }}</option><option value="members"{% if profile.profile_visibility|default('public') == 'members' %} selected{% endif %}>{{ trans('account.profile.visibility_members') }}</option></select></label></div>
                <label>{{ trans('account.profile.bio') }}<textarea name="bio" rows="7" maxlength="2000">{{ profile.bio|default('') }}</textarea><small>{{ trans('account.profile.bio_help') }}</small>{% if errors.bio|default(null) %}<small class="field-error">{{ errors.bio }}</small>{% endif %}</label>
                <div class="nl-form-grid"><label>{{ trans('account.profile.website') }}<input type="url" name="website" maxlength="255" placeholder="https://example.com" value="{{ profile.website|default('') }}">{% if errors.website|default(null) %}<small class="field-error">{{ errors.website }}</small>{% endif %}</label><label>{{ trans('account.profile.location') }}<input name="location" maxlength="120" value="{{ profile.location|default('') }}">{% if errors.location|default(null) %}<small class="field-error">{{ errors.location }}</small>{% endif %}</label></div>
                <div class="nl-form-grid"><label>{{ trans('account.profile.language') }}<select name="locale">{% for code, label in cms_locales %}<option value="{{ code }}"{% if profile.locale|default('en') == code %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><label>{{ trans('account.profile.timezone') }}<select name="timezone">{% for timezone in timezones %}<option value="{{ timezone }}"{% if profile.timezone|default('UTC') == timezone %} selected{% endif %}>{{ timezone }}</option>{% endfor %}</select></label></div>
                <button class="nl-btn nl-btn-primary" type="submit">{{ trans('account.profile.save') }}</button>
            </form>
        </section>
        <aside class="nl-account-side">
            <section class="nl-surface"><div class="nl-section-heading compact"><span class="nl-section-icon">●</span><div><h2>{{ trans('account.avatar.title') }}</h2><p>{{ trans('theme::avatar_intro') }}</p></div></div>{% if avatar_error|default(null) %}<div class="alert alert-error">{{ avatar_error }}</div>{% endif %}{% if profile.avatar_path|default(null) %}<div class="nl-avatar-preview"><img class="nl-profile-avatar" src="{{ profile.avatar_path }}" alt=""><form method="post" action="/account/avatar/remove"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="nl-btn nl-btn-quiet" type="submit">{{ trans('account.avatar.remove') }}</button></form></div>{% endif %}<form method="post" action="/account/avatar" enctype="multipart/form-data" class="settings-form nl-form"><input type="hidden" name="_token" value="{{ csrf_token }}"><label class="nl-file-field">{{ trans('account.avatar.title') }}<input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" required><small>{{ trans('account.avatar.help') }}</small></label><button class="nl-btn nl-btn-secondary" type="submit">{{ trans('account.avatar.save') }}</button></form></section>
            <section class="nl-surface"><div class="nl-section-heading compact"><span class="nl-section-icon">⌁</span><div><h2>{{ trans('account.password.title') }}</h2><p>{{ trans('theme::password_intro') }}</p></div></div>{% if password_error|default(null) %}<div class="alert alert-error">{{ password_error }}</div>{% endif %}<form method="post" action="/account/password" class="settings-form nl-form"><input type="hidden" name="_token" value="{{ csrf_token }}"><label>{{ trans('account.password.current') }}<input type="password" name="current_password" required autocomplete="current-password"></label><label>{{ trans('account.password.new') }}<input type="password" name="password" minlength="12" required autocomplete="new-password"></label><label>{{ trans('auth.register.confirm_password') }}<input type="password" name="password_confirmation" minlength="12" required autocomplete="new-password"></label><button class="nl-btn nl-btn-secondary" type="submit">{{ trans('account.password.save') }}</button></form></section>
            <div class="nl-account-links">
                <a class="nl-security-link is-email" href="/account/email"><span><strong>{{ trans('account.email.link') }}</strong><small>{{ trans('theme::email_intro') }}</small></span><b>→</b></a>
                <a class="nl-security-link" href="/account/security"><span><strong>{{ trans('account.security.link') }}</strong><small>{{ trans('theme::security_intro') }}</small></span><b>→</b></a>
            </div>
        </aside>
    </div>
</section>
{% endblock %}
