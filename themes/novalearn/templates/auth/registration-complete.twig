{% extends "layouts/default.twig" %}
{% block title %}{{ trans('auth.registration_complete.title', {site_name: cms_name|default('NovaNuke')}) }}{% endblock %}
{% block content %}
<section class="nl-auth-status-page"><div class="nl-auth-status-card nl-auth-status-card-success"><span class="nl-auth-status-symbol">✓</span><span class="nl-login-kicker">{{ trans('auth.registration_complete.eyebrow') }}</span><h1>{{ trans('auth.registration_complete.title', {site_name: cms_name|default('NovaNuke')}) }}</h1>{% if verification_required %}<p>{{ trans('auth.registration_complete.verify') }}</p><a class="nl-auth-primary nl-auth-primary-link" href="/resend-verification">{{ trans('auth.verification.resend_link') }}</a>{% else %}<p>{{ trans('auth.registration_complete.active') }}</p><a class="nl-auth-primary nl-auth-primary-link" href="/login">{{ trans('common.sign_in') }}</a>{% endif %}</div></section>
{% endblock %}
