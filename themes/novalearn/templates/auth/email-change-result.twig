{% extends "layouts/default.twig" %}
{% block title %}{{ trans(verified ? 'account.email.changed_title' : 'account.email.invalid_title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}<section class="nl-auth-status-page"><div class="nl-auth-status-card {{ verified ? 'nl-auth-status-card-success' : 'nl-auth-status-card-warning' }}"><span class="nl-auth-status-symbol">{{ verified ? '✓' : '!' }}</span><span class="nl-login-kicker">{{ trans('account.settings') }}</span><h1>{{ trans(verified ? 'account.email.changed_title' : 'account.email.invalid_title') }}</h1><p>{{ trans(verified ? 'account.email.changed' : 'account.email.invalid') }}</p><a class="nl-auth-primary nl-auth-primary-link" href="/login">{{ trans('auth.login.heading') }}</a></div></section>{% endblock %}
