{% extends "layouts/default.twig" %}
{% block title %}{{ trans('account.email.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="nl-account-page">
  <nav class="breadcrumbs" aria-label="{{ trans('common.navigation') }}"><a href="/">{{ trans('common.home_label') }}</a><span>/</span><a href="/account/profile">{{ trans('account.settings') }}</a><span>/</span><strong>{{ trans('account.email.title') }}</strong></nav>
  <header class="nl-account-hero"><div><span class="nl-kicker">{{ trans('theme::auth_account_kicker') }}</span><h1>{{ trans('account.email.title') }}</h1><p>{{ trans('theme::auth_account_story') }}</p></div></header>
  <div class="nl-account-grid"><main class="nl-surface"><div class="nl-section-heading"><span class="nl-section-icon">@</span><div><h2>{{ trans('account.email.title') }}</h2><p>{{ trans('account.email.current', {email: current_email}) }}</p></div></div><p class="nl-account-help">{{ trans('account.email.help') }}</p>{% if sent %}<div class="nl-auth-alert nl-auth-success">{{ trans('account.email.sent') }}</div>{% endif %}<form method="post" action="/account/email" class="nl-form"><input type="hidden" name="_token" value="{{ csrf_token }}"><label>{{ trans('account.email.new') }}<input type="email" name="email" value="{{ email }}" maxlength="254" autocomplete="email" required>{% if errors.email|default(null) %}<small class="nl-field-error">{{ errors.email }}</small>{% endif %}</label><label>{{ trans('account.password.current') }}<input type="password" name="password" maxlength="255" autocomplete="current-password" required>{% if errors.password|default(null) %}<small class="nl-field-error">{{ errors.password }}</small>{% endif %}</label><button class="nl-account-save" type="submit">{{ trans('account.email.submit') }}</button></form></main><aside class="nl-account-side"><div class="nl-surface nl-account-note"><span class="nl-section-icon">✓</span><strong>{{ trans('theme::auth_status_private') }}</strong><p>{{ trans('account.email.help') }}</p></div><a class="nl-security-link" href="/account/security"><span><strong>{{ trans('account.email.back') }}</strong></span><b>→</b></a></aside></div>
</section>
{% endblock %}
