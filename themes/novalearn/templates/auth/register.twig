{% extends "layouts/default.twig" %}
{% block title %}{{ trans('auth.register.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="nl-auth-page">
  <div class="nl-auth-shell">
    <aside class="nl-auth-story nl-auth-story-join" aria-hidden="true">
      <div class="nl-login-brandmark">N</div>
      <div class="nl-auth-story-copy"><span class="nl-auth-story-kicker">{{ trans('theme::auth_join_kicker') }}</span><h1>{{ trans('auth.register.heading') }}</h1><p>{{ trans('theme::auth_join_story') }}</p></div>
      <div class="nl-auth-story-badges"><span>&lt;/&gt;</span><span>#</span><span>{ }</span></div>
    </aside>
    <div class="nl-auth-panel">
      <div class="nl-auth-heading"><span class="nl-login-kicker">{{ trans('auth.register.eyebrow') }}</span><h2>{{ trans('auth.register.heading') }}</h2><p>{{ trans(verification_required ? 'auth.register.verification_required' : 'auth.register.active_immediately') }}</p></div>
      {% if errors %}<div class="nl-auth-alert nl-auth-error"><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
      <form class="nl-auth-form" method="post" action="/register">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <label><span>{{ trans('auth.register.username') }}</span><input name="username" value="{{ old.username|default('') }}" minlength="3" maxlength="32" required autocomplete="username"></label>
        <label><span>{{ trans('common.email') }}</span><input type="email" name="email" value="{{ old.email|default('') }}" required autocomplete="email"></label>
        <div class="nl-auth-form-grid">
          <label><span>{{ trans('common.password') }}</span><input type="password" name="password" minlength="12" required autocomplete="new-password"></label>
          <label><span>{{ trans('auth.register.confirm_password') }}</span><input type="password" name="password_confirmation" minlength="12" required autocomplete="new-password"></label>
        </div>
        <button class="nl-auth-primary" type="submit">{{ trans('common.create_account') }} <span aria-hidden="true">→</span></button>
      </form>
      <a class="nl-auth-back" href="/login">{{ trans('auth.register.already') }}</a>
      <div class="nl-auth-trust"><span>✓</span>{{ trans('theme::auth_status_private') }}</div>
    </div>
  </div>
</section>
{% endblock %}
