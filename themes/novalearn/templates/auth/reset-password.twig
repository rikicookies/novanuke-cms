{% extends "layouts/default.twig" %}
{% block title %}{{ trans('auth.reset.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="nl-auth-page"><div class="nl-auth-shell nl-auth-shell-compact">
  <aside class="nl-auth-story nl-auth-story-recovery" aria-hidden="true"><div class="nl-login-brandmark">N</div><div class="nl-auth-story-copy"><span class="nl-auth-story-kicker">{{ trans('theme::auth_secure_kicker') }}</span><h1>{{ trans('auth.reset.title') }}</h1><p>{{ trans('theme::auth_secure_story') }}</p></div><div class="nl-auth-story-badges"><span>•••</span><span>↻</span><span>✓</span></div></aside>
  <div class="nl-auth-panel"><div class="nl-auth-heading"><span class="nl-login-kicker">{{ trans('auth.recovery.eyebrow') }}</span><h2>{{ trans('auth.reset.title') }}</h2><p>{{ trans('auth.reset.help') }}</p></div>
    {% if error %}<div class="nl-auth-alert nl-auth-error"><ul><li>{{ error }}</li></ul></div>{% endif %}
    <form class="nl-auth-form" method="post" action="/reset-password/{{ token }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><span>{{ trans('common.email') }}</span><input type="email" name="email" value="{{ email }}" required autocomplete="email"></label><div class="nl-auth-form-grid"><label><span>{{ trans('account.password.new') }}</span><input type="password" name="password" minlength="12" required autocomplete="new-password"></label><label><span>{{ trans('auth.register.confirm_password') }}</span><input type="password" name="password_confirmation" minlength="12" required autocomplete="new-password"></label></div><button class="nl-auth-primary" type="submit">{{ trans('account.password.save') }} <span aria-hidden="true">→</span></button></form>
  </div>
</div></section>
{% endblock %}
