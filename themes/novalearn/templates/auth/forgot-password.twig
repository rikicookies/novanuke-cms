{% extends "layouts/default.twig" %}
{% block title %}{{ trans('auth.recovery.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="nl-auth-page"><div class="nl-auth-shell nl-auth-shell-compact">
  <aside class="nl-auth-story nl-auth-story-recovery" aria-hidden="true"><div class="nl-login-brandmark">N</div><div class="nl-auth-story-copy"><span class="nl-auth-story-kicker">{{ trans('theme::auth_secure_kicker') }}</span><h1>{{ trans('auth.recovery.title') }}</h1><p>{{ trans('theme::auth_secure_story') }}</p></div><div class="nl-auth-story-badges"><span>•••</span><span>↻</span><span>✓</span></div></aside>
  <div class="nl-auth-panel">
    <div class="nl-auth-heading"><span class="nl-login-kicker">{{ trans('auth.recovery.eyebrow') }}</span><h2>{{ trans('auth.recovery.title') }}</h2><p>{{ trans('auth.recovery.help') }}</p></div>
    {% if sent %}
      <div class="nl-auth-state nl-auth-state-success"><span class="nl-auth-state-icon">✓</span><div><strong>{{ trans('theme::auth_status_success') }}</strong><p>{{ trans('auth.recovery.sent') }}</p><small>{{ trans('auth.recovery.local_help') }}</small></div></div>
    {% else %}
      {% if error %}<div class="nl-auth-alert nl-auth-error"><ul><li>{{ error }}</li></ul></div>{% endif %}
      <form class="nl-auth-form" method="post" action="/forgot-password"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><span>{{ trans('common.email') }}</span><input type="email" name="email" required autocomplete="email"></label><button class="nl-auth-primary" type="submit">{{ trans('auth.recovery.submit') }} <span aria-hidden="true">→</span></button></form>
    {% endif %}
    <a class="nl-auth-back" href="/login">← {{ trans('auth.recovery.back') }}</a>
  </div>
</div></section>
{% endblock %}
