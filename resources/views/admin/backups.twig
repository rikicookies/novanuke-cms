{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('backup.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="admin-page nn-admin-workspace nn-settings-v2">
  <div class="nn-breadcrumb"><i class="ph ph-house"></i><span>/</span><a href="/admin">{{ trans('admin.navigation.dashboard') }}</a><span>/</span><strong>{{ trans('backup.title') }}</strong></div>
  <div class="nn-page-heading"><div><h1>{{ trans('backup.title') }}</h1><p>{{ trans('backup.description') }}</p></div></div>
  {% if message %}<div class="nn-settings-alert is-success"><i class="ph ph-check-circle"></i><div>{{ message }}</div></div>{% endif %}
  {% if error %}<div class="nn-settings-alert is-danger"><i class="ph ph-warning-circle"></i><div>{{ error }}</div></div>{% endif %}
  <section class="nn-panel">
    <header><h2>{{ trans('backup.create_title') }}</h2><p>{{ trans('backup.plaintext_warning') }}</p></header>
    <form method="post" action="/admin/backups/create"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="confirm" value="1"><button class="nn-button nn-button-primary" type="submit">{{ trans('backup.create') }}</button></form>
  </section>
  <section class="nn-panel"><header><h2>{{ trans('backup.list_title') }}</h2></header>
    {% if backups %}<div class="nn-simple-list">{% for backup in backups %}<article><strong>{{ backup.id }}</strong><span>{{ backup.timestamp }}</span><span>{{ backup.encrypted ? trans('backup.encrypted') : trans('backup.plaintext') }}</span><span>{{ backup.components|join(', ') }} · {{ backup.bytes }} bytes</span><span>{{ trans('backup.status.' ~ backup.status) }}</span>{% if backup.status == 'valid' %}<form method="post" action="/admin/backups/{{ backup.id }}/verify"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="nn-button nn-button-secondary" type="submit">{{ trans('backup.verify') }}</button></form>{% endif %}{% if backup.detail %}<small>{{ backup.detail }}</small>{% endif %}</article>{% endfor %}</div>{% else %}<p>{{ trans('backup.empty') }}</p>{% endif %}
  </section>
</section>
{% endblock %}
