{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('admin.menus.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% macro item_fields(item, menu, roles) %}<input type="hidden" name="id" value="{{ item.id|default('') }}"><input type="hidden" name="menu_id" value="{{ menu.id }}"><div class="nn-field-grid nn-field-grid-2"><label class="nn-field"><span>{{ trans('admin.menus.field.item_title') }}</span><input name="title" required maxlength="120" value="{{ item.title|default('') }}"></label><label class="nn-field"><span>{{ trans('admin.menus.field.parent') }}</span><select name="parent_id"><option value="">{{ trans('admin.menus.top_level') }}</option>{% for candidate in menu.items %}{% if candidate.id != (item.id|default(0)) %}<option value="{{ candidate.id }}" {{ item.parent_id|default(null)==candidate.id?'selected':'' }}>{{ candidate.title }}</option>{% endif %}{% endfor %}</select></label><label class="nn-field"><span>{{ trans('admin.menus.field.link_type') }}</span><select name="link_type"><option value="internal" {{ item.link_type|default('internal')=='internal'?'selected':'' }}>{{ trans('admin.menus.link.internal') }}</option><option value="module" {{ item.link_type|default('internal')=='module'?'selected':'' }}>{{ trans('admin.menus.link.module') }}</option><option value="external" {{ item.link_type|default('internal')=='external'?'selected':'' }}>{{ trans('admin.menus.link.external') }}</option></select></label><label class="nn-field"><span>{{ trans('admin.menus.field.destination') }}</span><input name="target" required maxlength="2048" value="{{ item.target|default('/') }}" placeholder="/pages/about"></label><label class="nn-field"><span>{{ trans('admin.menus.field.order') }}</span><input type="number" name="sort_order" min="-10000" max="10000" value="{{ item.sort_order|default(0) }}"></label></div><div class="nn-role-grid">{% for role in roles %}<label><input type="checkbox" name="role_ids[]" value="{{ role.id }}" {{ role.id in (item.role_ids|default([]))?'checked':'' }}><span>{{ role.name }}</span></label>{% endfor %}</div><div class="nn-toggle-row"><label><input type="checkbox" name="enabled" value="1" {{ item.enabled|default(1)?'checked':'' }}><span>{{ trans('admin.menus.enabled') }}</span></label><label><input type="checkbox" name="new_window" value="1" {{ item.new_window|default(0)?'checked':'' }}><span>{{ trans('admin.menus.new_window') }}</span></label></div>{% endmacro %}
{% macro sortable_tree(items) %}{% for item in items %}<li class="nn-sort-row {{ item.parent_id?'is-child':'' }}" data-menu-item-id="{{ item.id }}" draggable="true"><button type="button" class="admin-nav-drag-handle" aria-label="{{ trans('admin.menus.drag_item',{name:item.title}) }}">⋮⋮</button><div class="nn-sort-label"><strong>{{ item.title }}</strong><small>{{ item.parent_id?trans('admin.menus.child_item'):trans('admin.menus.top_level') }} · {{ item.url }}</small></div><div class="admin-nav-move-buttons"><button type="button" data-public-move="up">↑</button><button type="button" data-public-move="down">↓</button></div>{% if item.children %}<ul class="primary-menu-children" data-public-menu-items>{{ _self.sortable_tree(item.children) }}</ul>{% endif %}</li>{% endfor %}{% endmacro %}
{% block content %}<section class="admin-page nn-menus-v3">
{% include 'components/admin-breadcrumb.twig' with {items:[{label:trans('admin.title'),url:'/admin'},{label:trans('admin.menus.title')}]} only %}
{% include 'components/admin-page-heading.twig' with {eyebrow:trans('admin.menus.eyebrow'),title:trans('admin.menus.title'),description:trans('admin.menus.description')} only %}
{% if message %}<div class="success-message">{{ message }}</div>{% endif %}{% if error %}<div class="form-errors"><ul><li>{{ error }}</li></ul></div>{% endif %}
<div class="nn-menu-layout">
<section class="nn-panel" data-admin-nav-order><div class="nn-panel-head"><div><span class="nn-kicker">{{ trans('admin.menus.admin_order.title') }}</span><h2>{{ trans('admin.menus.admin_order.title') }}</h2><p>{{ trans('admin.menus.admin_order.description') }}</p></div></div><form method="post" action="/admin/navigation/order" data-admin-nav-order-form><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="navigation_order" data-admin-nav-order-value><div class="nn-admin-nav-board" data-admin-nav-groups>{% for group in admin_navigation|default([]) %}<article class="nn-nav-group" data-nav-group="{{ group.slug }}" draggable="true"><header><button type="button" class="admin-nav-drag-handle">⋮⋮</button><strong>{{ trans(group.label) }}</strong><div class="admin-nav-move-buttons"><button type="button" data-move="up">↑</button><button type="button" data-move="down">↓</button></div></header><ul data-nav-items>{% for item in group.items %}<li data-nav-url="{{ item.url }}" draggable="true"><button type="button" class="admin-nav-drag-handle">⋮⋮</button><span>{{ trans(item.label) }}</span><div class="admin-nav-move-buttons"><button type="button" data-move="up">↑</button><button type="button" data-move="down">↓</button></div></li>{% endfor %}</ul></article>{% endfor %}</div><div class="nn-panel-actions"><small>{{ trans('admin.menus.admin_order.help') }}</small><button type="submit" class="nn-primary-action">{{ trans('admin.menus.admin_order.save') }}</button></div></form></section>
{% for primary_menu in menu_list %}{% if primary_menu.slug=='primary' %}<section class="nn-panel" data-public-menu-order><div class="nn-panel-head"><div><span class="nn-kicker">{{ trans('admin.menus.primary_order.title') }}</span><h2>{{ trans('admin.menus.primary_order.title') }}</h2><p>{{ trans('admin.menus.primary_order.description') }}</p></div></div><form method="post" action="/admin/menus/{{ primary_menu.id }}/order" data-public-menu-order-form><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="item_order" data-public-menu-order-value><ul class="nn-public-tree" data-public-menu-items>{{ _self.sortable_tree(primary_menu.tree|default([])) }}</ul><div class="nn-panel-actions"><small>{{ primary_menu.items?trans('admin.menus.primary_order.help'):trans('admin.menus.primary_order.empty') }}</small>{% if primary_menu.items %}<button type="submit" class="nn-primary-action">{{ trans('admin.menus.primary_order.save') }}</button>{% endif %}</div></form></section>{% endif %}{% endfor %}
</div>
<section class="nn-panel nn-menu-manager"><div class="nn-panel-head"><div><h2>{{ trans('admin.menus.title') }}</h2><p>{{ trans('admin.menus.description') }}</p></div><details class="nn-popover-create"><summary class="nn-primary-action">＋ {{ trans('admin.menus.create') }}</summary><form method="post" action="/admin/menus/save"><input type="hidden" name="_token" value="{{ csrf_token }}"><div class="nn-field-grid"><label class="nn-field"><span>{{ trans('admin.menus.field.name') }}</span><input name="name" required maxlength="120"></label><label class="nn-field"><span>{{ trans('admin.menus.field.slug') }}</span><input name="slug" required pattern="[a-z][a-z0-9-]*" maxlength="100"></label><label class="nn-field"><span>{{ trans('admin.menus.field.description') }}</span><input name="description" maxlength="255"></label></div><div class="nn-sticky-actions"><button type="submit" class="nn-primary-action">{{ trans('admin.menus.create') }}</button></div></form></details></div>
<div class="nn-menu-cards">{% for menu in menu_list %}<article class="nn-menu-card"><header><div><h3>{{ menu.name }}</h3><code>{{ menu.slug }}</code></div><span class="nn-status-pill {{ menu.enabled?'is-on':'is-off' }}">{{ menu.enabled?trans('admin.menus.enabled'):trans('admin.menus.disabled') }}</span></header><div class="nn-menu-card-body"><details><summary>{{ trans('admin.menus.save') }}</summary><form method="post" action="/admin/menus/save"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ menu.id }}"><div class="nn-field-grid nn-field-grid-2"><label class="nn-field"><span>{{ trans('admin.menus.field.name') }}</span><input name="name" value="{{ menu.name }}" required></label><label class="nn-field"><span>{{ trans('admin.menus.field.slug') }}</span><input name="slug" value="{{ menu.slug }}" required></label><label class="nn-field nn-span-2"><span>{{ trans('admin.menus.field.description') }}</span><input name="description" value="{{ menu.description|default('',true) }}"></label></div><div class="nn-toggle-row"><label><input type="checkbox" name="enabled" value="1" {{ menu.enabled?'checked':'' }}><span>{{ trans('admin.menus.enabled') }}</span></label></div><div class="nn-sticky-actions"><button type="submit" class="nn-primary-action">{{ trans('admin.menus.save') }}</button></div></form></details><details><summary>＋ {{ trans('admin.menus.add_item_to',{name:menu.name}) }}</summary><form method="post" action="/admin/menu-items/save"><input type="hidden" name="_token" value="{{ csrf_token }}">{{ _self.item_fields({},menu,roles) }}<div class="nn-sticky-actions"><button type="submit" class="nn-primary-action">{{ trans('admin.menus.add_item') }}</button></div></form></details><div class="nn-menu-item-list">{% for item in menu.items %}<details class="nn-menu-item"><summary><div><strong>{{ item.title }}</strong><small>{{ item.parent_id?trans('admin.menus.child_item'):trans('admin.menus.top_level') }} · {{ item.url }}</small></div><span>›</span></summary><form method="post" action="/admin/menu-items/save"><input type="hidden" name="_token" value="{{ csrf_token }}">{{ _self.item_fields(item,menu,roles) }}<div class="nn-sticky-actions"><button type="submit" class="nn-primary-action">{{ trans('admin.menus.save_item') }}</button></div></form><div class="nn-danger-zone"><form method="post" action="/admin/menu-items/{{ item.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> {{ trans('admin.menus.confirm_item_delete') }}</label><button class="danger-button" type="submit">{{ trans('admin.menus.delete_item') }}</button></form></div></details>{% else %}<p class="nn-empty-inline">{{ trans('admin.menus.items_empty') }}</p>{% endfor %}</div></div><footer><form method="post" action="/admin/menus/{{ menu.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> {{ trans('admin.menus.confirm_delete') }}</label><button class="danger-button" type="submit">{{ trans('admin.menus.delete') }}</button></form></footer></article>{% else %}<div class="nn-empty-card">{{ trans('admin.menus.empty') }}</div>{% endfor %}</div></section>
<script src="/assets/js/admin-navigation-order.js?v=2" defer></script><script src="/assets/js/public-menu-order.js?v=2" defer></script>
</section>{% endblock %}
