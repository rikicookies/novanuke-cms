{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('admin.dashboard.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="admin-page nn-admin-workspace nn-dashboard-golden">
    {% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('admin.dashboard.title')}]} only %}

    {% include 'components/admin-page-heading.twig' with {
        eyebrow: trans('admin.dashboard.operations'),
        title: trans('admin.dashboard.hello', {username: user.username}),
        description: trans('admin.dashboard.version_overview', {version: cms_version})
    } only %}

    {% if system_warnings %}
        <div class="alert alert-danger alert-icon-start mb-4">
            <span class="alert-icon bg-danger text-white"><i class="ph-warning"></i></span>
            <div class="flex-1">
                <strong>{{ trans('admin.dashboard.configuration_warnings') }}</strong>
                <ul class="mb-1 mt-2">{% for warning in system_warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
                <a href="/admin/system" class="alert-link">{{ trans('admin.dashboard.review_system') }}</a>
            </div>
        </div>
    {% endif %}

    <div class="nn-dashboard-section">
        <div class="nn-dashboard-section-heading">
            <div>
                <div class="text-uppercase text-muted fs-sm fw-semibold">Overview</div>
                <h2>Site overview</h2>
            </div>
        </div>
        <div class="row g-3">
            {% for card in dashboard.cards %}
                <div class="col-sm-6 col-xl-3">
                    <a href="{{ card.url }}" class="card nn-dashboard-stat h-100 text-body text-decoration-none">
                        <div class="card-body d-flex align-items-center gap-3">
                            <span class="nn-dashboard-stat-icon"><i class="ph-chart-line-up"></i></span>
                            <div class="min-w-0"><div class="fs-3 fw-semibold lh-1 mb-2">{{ card.value }}</div><div class="text-muted">{{ trans(card.label) }}</div></div>
                        </div>
                    </a>
                </div>
            {% else %}
                <div class="col-sm-6 col-xl-3"><div class="card nn-dashboard-stat h-100"><div class="card-body"><div class="fs-3 fw-semibold">{{ cms_version }}</div><div class="text-muted">{{ trans('admin.dashboard.core_release') }}</div></div></div></div>
            {% endfor %}
            {% if dashboard.module_status %}
                <div class="col-sm-6 col-xl-3">
                    <a href="/admin/modules" class="card nn-dashboard-stat h-100 text-body text-decoration-none">
                        <div class="card-body d-flex align-items-center gap-3">
                            <span class="nn-dashboard-stat-icon"><i class="ph-puzzle-piece"></i></span>
                            <div><div class="fs-3 fw-semibold lh-1 mb-2">{{ dashboard.module_status.enabled }} / {{ dashboard.module_status.detected }}</div><div class="text-muted">{{ trans('admin.dashboard.enabled_modules') }}</div>{% if dashboard.module_status.issues %}<small class="text-warning">{{ trans('admin.dashboard.issue_count', {count: dashboard.module_status.issues}) }}</small>{% endif %}</div>
                        </div>
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    {% if dashboard.attention %}
        <div class="card nn-dashboard-card border-warning-subtle">
            <div class="card-header nn-dashboard-card-header"><div><div class="text-uppercase text-warning fs-sm fw-semibold">{{ trans('admin.dashboard.priority_queue') }}</div><h2 class="mb-0">{{ trans('admin.dashboard.needs_attention') }}</h2></div></div>
            <div class="list-group list-group-flush">{% for item in dashboard.attention %}<a href="{{ item.url }}" class="list-group-item list-group-item-action d-flex align-items-center py-3"><span class="flex-1 fw-medium">{{ trans(item.label) }}</span><span class="badge bg-warning text-dark rounded-pill">{{ item.count }}</span><i class="ph-caret-right ms-3 text-muted"></i></a>{% endfor %}</div>
        </div>
    {% endif %}

    <div class="row g-4 nn-dashboard-row">
        {% if system_health %}
            <div class="col-xl-7"><div class="card nn-dashboard-card h-100"><div class="card-header nn-dashboard-card-header"><div><div class="text-uppercase text-muted fs-sm fw-semibold">System</div><h2 class="mb-0">{{ trans('admin.dashboard.site_health') }}</h2></div><span class="badge ms-auto {{ system_health.status == 'healthy' ? 'bg-success bg-opacity-10 text-success' : 'bg-warning bg-opacity-10 text-warning' }}">{{ system_health.status == 'healthy' ? trans('admin.dashboard.all_healthy') : trans('admin.dashboard.review_recommended') }}</span></div><div class="list-group list-group-flush">{% for check in system_health.checks %}<a href="{{ check.url }}" class="list-group-item list-group-item-action d-flex align-items-center py-3"><i class="{{ check.status == 'healthy' ? 'ph-check-circle text-success' : 'ph-warning-circle text-warning' }} me-3 fs-5"></i><span class="flex-1">{{ check.label }}</span><strong>{{ check.value }}</strong></a>{% endfor %}</div></div></div>
        {% endif %}
        {% if dashboard.quick_actions %}
            <div class="col-xl-5"><div class="card nn-dashboard-card h-100"><div class="card-header nn-dashboard-card-header"><div><div class="text-uppercase text-muted fs-sm fw-semibold">Shortcuts</div><h2 class="mb-0">{{ trans('admin.dashboard.quick_actions') }}</h2></div></div><div class="card-body"><div class="d-grid gap-2">{% for action in dashboard.quick_actions %}<a class="btn btn-light nn-dashboard-action" href="{{ action.url }}"><span>{{ trans(action.label) }}</span><i class="ph-arrow-right"></i></a>{% endfor %}</div></div></div></div>
        {% endif %}
    </div>

    {% if dashboard.recent_content %}
        <div class="card nn-dashboard-card"><div class="card-header nn-dashboard-card-header"><div><div class="text-uppercase text-muted fs-sm fw-semibold">Content</div><h2 class="mb-0">{{ trans('admin.dashboard.recent_content') }}</h2></div></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ trans('admin.dashboard.type') }}</th><th>{{ trans('admin.dashboard.content_title') }}</th><th>{{ trans('admin.dashboard.status') }}</th><th>{{ trans('admin.dashboard.created') }}</th></tr></thead><tbody>{% for item in dashboard.recent_content %}<tr><td><span class="badge bg-light text-body">{{ trans(item.type) }}</span></td><td><a class="fw-semibold text-body" href="{{ item.admin_url }}">{{ item.title }}</a></td><td>{{ item.status }}</td><td class="text-nowrap text-muted">{{ item.created_at|date(cms_date_format, cms_timezone) }}</td></tr>{% endfor %}</tbody></table></div></div>
    {% endif %}

    <div class="row g-4 nn-dashboard-row">
        {% if dashboard.recent_users %}<div class="col-xl-6"><div class="card nn-dashboard-card h-100"><div class="card-header nn-dashboard-card-header"><h2 class="mb-0">{{ trans('admin.dashboard.recent_users') }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ trans('admin.dashboard.user') }}</th><th>{{ trans('admin.dashboard.status') }}</th><th>{{ trans('admin.dashboard.registered') }}</th></tr></thead><tbody>{% for account in dashboard.recent_users %}<tr><td><a class="fw-semibold text-body" href="/admin/users/{{ account.id }}">{{ account.username }}</a></td><td>{{ account.status }}</td><td class="text-nowrap text-muted">{{ account.created_at|date(cms_date_format, cms_timezone) }}</td></tr>{% endfor %}</tbody></table></div></div></div>{% endif %}
        {% if dashboard.recent_activity %}<div class="col-xl-6"><div class="card nn-dashboard-card h-100"><div class="card-header nn-dashboard-card-header"><h2 class="mb-0">{{ trans('admin.dashboard.recent_activity') }}</h2><a class="btn btn-light btn-sm ms-auto" href="/admin/logs">{{ trans('admin.dashboard.view_logs') }}</a></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ trans('admin.dashboard.actor') }}</th><th>{{ trans('admin.dashboard.action') }}</th><th>{{ trans('admin.dashboard.date') }}</th></tr></thead><tbody>{% for event in dashboard.recent_activity %}<tr><td>{{ event.actor_username|default(trans('admin.dashboard.system')) }}</td><td><div>{{ event.action }}</div><small class="text-muted">{{ event.subject_type|default('—') }}</small></td><td class="text-nowrap text-muted">{{ event.created_at|date(cms_date_format, cms_timezone) }}</td></tr>{% endfor %}</tbody></table></div></div></div>{% endif %}
    </div>
</section>
{% endblock %}
