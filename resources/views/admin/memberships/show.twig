{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('admin.memberships.membership') }} — {{ membership_user.username }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="admin-page nn-admin-workspace nn-membership-detail" id="membership-detail">
  {% include 'components/admin-breadcrumb.twig' with {items:[{label:trans('admin.title'),url:'/admin'},{label:trans('admin.memberships.title'),url:'/admin/memberships'},{label:membership_user.username}]} only %}
  <div class="nn-page-hero nn-page-hero--split">
    <div class="nn-member-identity"><span class="nn-avatar nn-avatar--lg">{{ membership_user.username|slice(0,1)|upper }}</span><div><span class="nn-page-eyebrow"><i class="ph-crown-simple"></i>{{ trans('admin.memberships.membership') }}</span><h1>{{ membership_user.username }}</h1><p>{{ membership_user.email }}</p></div></div>
    <a class="nn-btn nn-btn--secondary" href="/admin/users/{{ membership_user.id }}"><i class="ph-user-circle"></i>{{ trans('admin.memberships.open_user') }}</a>
  </div>

  <div class="nn-membership-layout">
    <div class="nn-membership-main">
      <article class="nn-panel nn-current-membership">
        <div class="nn-panel-head"><div><span class="nn-panel-kicker">{{ trans('admin.memberships.status') }}</span><h2>{{ trans('admin.memberships.current_status') }}</h2></div>{% if membership_status.vip|default(false) %}<span class="nn-status nn-status--success"><i class="ph-check-circle"></i>{{ trans('admin.memberships.filter.active') }}</span>{% else %}<span class="nn-status nn-status--muted">{{ trans('admin.memberships.free') }}</span>{% endif %}</div>
        {% if membership_status.vip|default(false) %}
          <div class="nn-membership-current-grid"><div class="nn-membership-plan-mark"><span class="nn-stat-icon nn-stat-icon--violet"><i class="ph-crown-simple"></i></span><div><small>{{ trans('admin.memberships.plan') }}</small><strong>{{ trans('admin.memberships.plan.' ~ membership_status.plan_key|default('vip-custom')) }}</strong></div></div><div><small>{{ trans('admin.memberships.period') }}</small><strong>{% if membership_status.lifetime %}{{ trans('admin.memberships.lifetime_vip') }}{% else %}{{ trans('admin.memberships.expires', {date: membership_status.expires_at}) }}{% endif %}</strong>{% if membership_status.days_remaining is not null %}<span>{{ trans('admin.memberships.days_remaining', {days: membership_status.days_remaining}) }}</span>{% endif %}</div></div>
        {% else %}<div class="nn-empty-inline"><span class="nn-stat-icon"><i class="ph-user"></i></span><div><strong>{{ trans('admin.memberships.free') }}</strong><p>{{ trans('admin.memberships.standard_access') }}</p></div></div>{% endif %}
      </article>

      {% if membership_status.vip|default(false) and not membership_status.lifetime|default(false) %}
      <article class="nn-panel"><div class="nn-panel-head"><div><span class="nn-panel-kicker">{{ trans('admin.memberships.manage') }}</span><h2>{{ trans('admin.memberships.extend_active') }}</h2></div></div>
        <div class="nn-quick-days">{% for quick_days in [30,90,365] %}<form method="post" action="/admin/memberships/{{ membership_user.id }}/extend" data-ajax-action data-ajax-replace="#membership-detail" data-ajax-success="{{ trans('admin.memberships.ajax.extended') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="days" value="{{ quick_days }}"><button type="submit" class="nn-btn nn-btn--secondary">+{{ trans('admin.memberships.days', {days: quick_days}) }}</button></form>{% endfor %}</div>
        <form class="nn-form-grid nn-form-grid--compact" method="post" action="/admin/memberships/{{ membership_user.id }}/extend" data-ajax-action data-ajax-replace="#membership-detail" data-ajax-success="{{ trans('admin.memberships.ajax.extended') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><span>{{ trans('admin.memberships.additional_days') }}</span><input type="number" name="days" min="1" max="3650" value="30" required></label><label><span>{{ trans('admin.memberships.note') }}</span><input type="text" name="note" maxlength="255" placeholder="{{ trans('admin.memberships.note_optional') }}"></label><button class="nn-btn nn-btn--primary" type="submit"><i class="ph-plus"></i>{{ trans('admin.memberships.add_days') }}</button></form>
      </article>{% endif %}

      <article class="nn-panel"><div class="nn-panel-head"><div><span class="nn-panel-kicker">{{ trans('admin.memberships.history') }}</span><h2>{{ trans('admin.memberships.history') }}</h2></div></div><div class="table-wrap nn-table-wrap"><table class="admin-table nn-table"><thead><tr><th>{{ trans('admin.memberships.plan') }}</th><th>{{ trans('admin.memberships.period') }}</th><th>{{ trans('admin.memberships.source') }}</th><th>{{ trans('admin.memberships.granted_by') }}</th><th>{{ trans('admin.memberships.status') }}</th></tr></thead><tbody>{% for row in membership_history %}<tr><td><strong>{{ trans('admin.memberships.plan.' ~ row.plan_key|default('vip-custom')) }}</strong></td><td>{{ row.starts_at }} → {{ row.expires_at ?: trans('admin.memberships.lifetime') }}</td><td>{{ row.source }}{% if row.note %}<small class="nn-block-muted">{{ row.note }}</small>{% endif %}</td><td>{{ row.granted_by_username|default(trans('admin.memberships.system')) }}</td><td>{% if row.revoked_at %}<span class="nn-status nn-status--danger">{{ trans('admin.memberships.revoked_at', {date: row.revoked_at}) }}</span>{% elseif row.starts_at > "now"|date("Y-m-d H:i:s") %}<span class="nn-status nn-status--info">{{ trans('admin.memberships.scheduled') }}</span>{% elseif row.expires_at and row.expires_at < "now"|date("Y-m-d H:i:s") %}<span class="nn-status nn-status--muted">{{ trans('admin.memberships.expired') }}</span>{% else %}<span class="nn-status nn-status--success">{{ trans('admin.memberships.active_granted') }}</span>{% endif %}</td></tr>{% else %}{% include 'components/admin-table-empty.twig' with {colspan:5,title:trans('admin.memberships.history_empty'),message:trans('admin.memberships.history_empty_help')} only %}{% endfor %}</tbody></table></div></article>
    </div>

    <aside class="nn-membership-side">
      <article class="nn-panel nn-side-card"><div class="nn-panel-head"><div><span class="nn-panel-kicker">{{ trans('admin.memberships.manage') }}</span><h2>{{ trans('admin.memberships.assign_plan') }}</h2></div></div><form class="nn-form-stack" method="post" action="/admin/memberships/{{ membership_user.id }}/assign" data-ajax-action data-ajax-replace="#membership-detail" data-ajax-success="{{ trans('admin.memberships.ajax.updated') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><span>{{ trans('admin.memberships.plan') }}</span><select name="plan" required>{% for key,plan in membership_plans %}<option value="{{ key }}">{{ trans('admin.memberships.plan.' ~ key) }}</option>{% endfor %}</select></label><label><span>{{ trans('admin.memberships.note') }}</span><input type="text" name="note" maxlength="255" placeholder="{{ trans('admin.memberships.note_examples') }}"></label><button class="nn-btn nn-btn--primary nn-btn--full" type="submit"><i class="ph-check"></i>{{ trans('admin.memberships.apply') }}</button></form>{% if membership_status.vip|default(false) %}<form class="nn-danger-action" method="post" action="/admin/memberships/{{ membership_user.id }}/revoke" onsubmit="return confirm('{{ trans('admin.memberships.confirm_revoke') }}')" data-ajax-action data-ajax-replace="#membership-detail" data-ajax-success="{{ trans('admin.memberships.ajax.revoked') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><button type="submit" class="nn-btn nn-btn--danger-soft nn-btn--full"><i class="ph-x-circle"></i>{{ trans('admin.memberships.revoke_current') }}</button></form>{% endif %}</article>

      <article class="nn-panel nn-side-card"><div class="nn-panel-head"><div><span class="nn-panel-kicker">{{ trans('admin.memberships.scheduled') }}</span><h2>{{ trans('admin.memberships.schedule_future') }}</h2></div></div>{% if scheduled_membership %}<div class="nn-scheduled-summary"><span class="nn-stat-icon nn-stat-icon--blue"><i class="ph-calendar-check"></i></span><div><strong>{{ scheduled_membership.name|default('VIP') }}</strong><p>{{ trans('admin.memberships.schedule_summary', {name: scheduled_membership.name|default('VIP'), date: scheduled_membership.starts_at}) }}</p>{% if scheduled_membership.expires_at %}<small>{{ trans('admin.memberships.expires', {date: scheduled_membership.expires_at}) }}</small>{% else %}<small>{{ trans('admin.memberships.lifetime') }}</small>{% endif %}</div></div><form method="post" action="/admin/memberships/{{ membership_user.id }}/schedule/cancel" onsubmit="return confirm('{{ trans('admin.memberships.confirm_cancel') }}')" data-ajax-action data-ajax-replace="#membership-detail" data-ajax-success="{{ trans('admin.memberships.ajax.cancelled') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><button type="submit" class="nn-btn nn-btn--secondary nn-btn--full">{{ trans('admin.memberships.cancel_scheduled') }}</button></form>{% else %}<form class="nn-form-stack" method="post" action="/admin/memberships/{{ membership_user.id }}/schedule"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><span>{{ trans('admin.memberships.plan') }}</span><select name="plan" required>{% for key,plan in membership_plans %}{% if key != 'free' %}<option value="{{ key }}">{{ trans('admin.memberships.plan.' ~ key) }}</option>{% endif %}{% endfor %}</select></label><label><span>{{ trans('admin.memberships.starts_at') }}</span><input type="datetime-local" name="starts_at" required></label><label><span>{{ trans('admin.memberships.note') }}</span><input type="text" name="note" maxlength="255" placeholder="{{ trans('admin.memberships.note_optional') }}"></label><button class="nn-btn nn-btn--secondary nn-btn--full" type="submit"><i class="ph-calendar-plus"></i>{{ trans('admin.memberships.schedule') }}</button></form>{% endif %}</article>
    </aside>
  </div>
</section>
{% endblock %}
