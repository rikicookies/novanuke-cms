{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('admin.memberships.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="admin-page nn-admin-workspace nn-memberships-page">
  {% include 'components/admin-breadcrumb.twig' with {items:[{label:trans('admin.title'),url:'/admin'},{label:trans('admin.memberships.title')}]} only %}
  <div class="nn-page-hero nn-page-hero--split">
    <div>
      <span class="nn-page-eyebrow"><i class="ph-crown-simple"></i>{{ trans('admin.memberships.eyebrow') }}</span>
      <h1>{{ trans('admin.memberships.title') }}</h1>
      <p>{{ trans('admin.memberships.description') }}</p>
    </div>
  </div>

  <div class="nn-membership-stats">
    <a class="nn-stat-card" href="/admin/memberships?status=active"><span class="nn-stat-icon nn-stat-icon--green"><i class="ph-check-circle"></i></span><span><strong>{{ membership_counts.active }}</strong><small>{{ trans('admin.memberships.filter.active') }}</small></span></a>
    <a class="nn-stat-card" href="/admin/memberships?status=expiring"><span class="nn-stat-icon nn-stat-icon--amber"><i class="ph-clock-countdown"></i></span><span><strong>{{ membership_counts.expiring }}</strong><small>{{ trans('admin.memberships.expiring_seven_days') }}</small></span></a>
    <a class="nn-stat-card" href="/admin/memberships?status=lifetime"><span class="nn-stat-icon nn-stat-icon--violet"><i class="ph-infinity"></i></span><span><strong>{{ membership_counts.lifetime }}</strong><small>{{ trans('admin.memberships.lifetime_vip') }}</small></span></a>
    <a class="nn-stat-card" href="/admin/memberships?status=scheduled"><span class="nn-stat-icon nn-stat-icon--blue"><i class="ph-calendar-check"></i></span><span><strong>{{ membership_counts.scheduled }}</strong><small>{{ trans('admin.memberships.scheduled') }}</small></span></a>
    <a class="nn-stat-card" href="/admin/memberships?status=inactive"><span class="nn-stat-icon"><i class="ph-user-minus"></i></span><span><strong>{{ membership_counts.inactive }}</strong><small>{{ trans('admin.memberships.filter.inactive') }}</small></span></a>
  </div>

  <div class="nn-panel nn-membership-directory">
    <div class="nn-panel-head">
      <div><h2>{{ trans('admin.memberships.title') }}</h2><p>{{ trans('admin.memberships.description') }}</p></div>
    </div>
    <form class="nn-filterbar" method="get" action="/admin/memberships">
      <label class="nn-filter-search"><i class="ph-magnifying-glass"></i><input type="search" name="q" maxlength="100" value="{{ search }}" placeholder="{{ trans('admin.memberships.search_placeholder') }}"></label>
      <label class="nn-filter-select"><span>{{ trans('admin.memberships.status') }}</span><select name="status">{% for key in ['active','expiring','lifetime','scheduled','inactive','never','all'] %}<option value="{{ key }}" {% if selected_status==key %}selected{% endif %}>{{ trans('admin.memberships.filter.' ~ key) }}</option>{% endfor %}</select></label>
      <button class="nn-btn nn-btn--primary" type="submit"><i class="ph-funnel"></i>{{ trans('admin.memberships.filter_submit') }}</button>
    </form>

    <div class="table-wrap nn-table-wrap"><table class="admin-table nn-table"><thead><tr><th>{{ trans('admin.memberships.user') }}</th><th>{{ trans('admin.memberships.membership') }}</th><th>{{ trans('admin.memberships.period') }}</th><th>{{ trans('admin.memberships.source') }}</th><th class="nn-table-actions">{{ trans('admin.memberships.manage') }}</th></tr></thead><tbody>
    {% for item in memberships %}
      <tr>
        <td><div class="nn-user-cell"><span class="nn-avatar">{{ item.username|slice(0,1)|upper }}</span><span><strong>{{ item.username }}</strong><small>{{ item.email }}</small></span></div></td>
        <td>{% if item.membership_active %}<span class="nn-status nn-status--success"><i class="ph-crown-simple"></i>{{ trans('admin.memberships.plan.' ~ item.plan_key|default('vip-custom')) }}</span>{% elseif item.starts_at and item.starts_at > "now"|date("Y-m-d H:i:s") %}<span class="nn-status nn-status--info">{{ trans('admin.memberships.scheduled') }} · {{ trans('admin.memberships.plan.' ~ item.plan_key) }}</span>{% elseif item.plan_key %}<span class="nn-status nn-status--muted">{{ trans('admin.memberships.inactive') }} · {{ trans('admin.memberships.plan.' ~ item.plan_key) }}</span>{% else %}<span class="nn-status nn-status--muted">{{ trans('admin.memberships.free') }}</span>{% endif %}</td>
        <td>{% if item.membership_active and not item.expires_at %}<strong>{{ trans('admin.memberships.lifetime') }}</strong>{% elseif item.expires_at %}<span class="nn-period">{{ item.starts_at }}<i class="ph-arrow-right"></i>{{ item.expires_at }} UTC</span>{% else %}—{% endif %}</td>
        <td><span>{{ item.source|default('—') }}</span>{% if item.note %}<small class="nn-block-muted">{{ item.note }}</small>{% endif %}</td>
        <td class="nn-table-actions"><div class="nn-row-actions"><a class="nn-icon-btn" href="/admin/memberships/{{ item.id }}" title="{{ trans('admin.memberships.history') }}"><i class="ph-crown-simple"></i></a><a class="nn-icon-btn" href="/admin/users/{{ item.id }}" title="{{ trans('admin.memberships.open_user') }}"><i class="ph-user-circle"></i></a></div></td>
      </tr>
    {% else %}{% include 'components/admin-table-empty.twig' with {colspan:5,title:trans('admin.memberships.empty'),message:trans('admin.memberships.empty_help')} only %}{% endfor %}
    </tbody></table></div>
  </div>
</section>
{% endblock %}
