<!doctype html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <style>
        :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #0b1020; color: #eef2ff; }
        * { box-sizing: border-box; }
        body { min-width: 18rem; min-height: 100vh; margin: 0; background: radial-gradient(circle at 15% 10%, rgba(91, 114, 255, .18), transparent 34rem), linear-gradient(145deg, #0b1020 0%, #121a32 55%, #0c1122 100%); }
        body::before, body::after { position: fixed; z-index: 0; width: 18rem; height: 18rem; border: 1px solid rgba(142, 161, 255, .12); border-radius: 50%; content: ""; pointer-events: none; }
        body::before { top: -9rem; right: -5rem; box-shadow: 0 0 0 3rem rgba(142, 161, 255, .025), 0 0 0 6rem rgba(142, 161, 255, .018); }
        body::after { bottom: -12rem; left: -8rem; }
        .nn-error-page { position: relative; z-index: 1; display: flex; flex-direction: column; width: min(100% - 2rem, 58rem); min-height: 100vh; margin: 0 auto; padding: 2rem 0; }
        .nn-error-brand { display: inline-flex; align-items: center; gap: .7rem; width: fit-content; color: #fff; font-size: .85rem; font-weight: 800; letter-spacing: .16em; text-decoration: none; text-transform: uppercase; }
        .nn-error-brand-mark { display: grid; width: 2rem; height: 2rem; place-items: center; border: 1px solid rgba(173, 187, 255, .55); border-radius: .65rem; background: linear-gradient(145deg, #6175ff, #9f66e8); box-shadow: 0 .6rem 1.8rem rgba(83, 98, 255, .25); font-size: .75rem; }
        .nn-error-main { display: grid; flex: 1; align-items: center; grid-template-columns: minmax(8rem, .7fr) minmax(0, 1.3fr); gap: clamp(2rem, 7vw, 6rem); padding: 5rem 0 3rem; }
        .nn-error-code { color: #95a5ff; font-size: clamp(6rem, 19vw, 12rem); font-weight: 900; letter-spacing: -.1em; line-height: .8; opacity: .9; text-shadow: .12em .12em 0 rgba(159, 102, 232, .12); }
        .nn-error-card { padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid rgba(173, 187, 255, .2); border-radius: 1.5rem; background: rgba(21, 30, 57, .78); box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, .28), inset 0 1px 0 rgba(255, 255, 255, .06); backdrop-filter: blur(12px); }
        .nn-error-kicker { margin: 0 0 .7rem; color: #aab6ff; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
        h1 { margin: 0; color: #fff; font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -.04em; line-height: 1.05; }
        .nn-error-description { margin: 1.25rem 0 0; color: #c8d0e8; font-size: clamp(1rem, 2vw, 1.15rem); line-height: 1.7; }
        .alert-danger { color: #c8d0e8; }
        .nn-error-reference { display: flex; flex-wrap: wrap; gap: .5rem; align-items: baseline; margin: 1.5rem 0 0; color: #9eabc9; font-size: .85rem; }
        .nn-error-reference code { padding: .25rem .45rem; border-radius: .35rem; background: rgba(5, 9, 22, .55); color: #e0e5ff; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
        .nn-error-details { margin-top: 1.5rem; color: #c8d0e8; font-size: .85rem; }
        .nn-error-details summary { cursor: pointer; color: #aab6ff; font-weight: 700; }
        .nn-error-details pre { max-width: 100%; overflow: auto; margin-bottom: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
        .nn-error-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
        .nn-error-action { display: inline-flex; justify-content: center; align-items: center; min-width: 8rem; padding: .75rem 1rem; border: 1px solid rgba(173, 187, 255, .35); border-radius: .7rem; color: #fff; font-weight: 750; text-decoration: none; }
        .nn-error-action.primary { border-color: transparent; background: linear-gradient(135deg, #6679ff, #9f66e8); box-shadow: 0 .7rem 1.5rem rgba(83, 98, 255, .22); }
        .nn-error-action:hover { filter: brightness(1.1); }
        .nn-error-action:focus-visible, .nn-error-brand:focus-visible, .nn-error-details summary:focus-visible { outline: 3px solid #f6c76d; outline-offset: 4px; }
        .nn-error-footer { color: #7783a7; font-size: .8rem; }
        @media (max-width: 42rem) { .nn-error-page { padding: 1.25rem 0; } .nn-error-main { display: block; padding-top: 4rem; } .nn-error-code { margin-bottom: 2rem; font-size: clamp(5rem, 28vw, 9rem); } .nn-error-card { border-radius: 1.1rem; } }
        @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; } }
    </style>
</head>
<body>
<div class="nn-error-page">
    <header>
        <a class="nn-error-brand" href="{{ home_url }}" aria-label="{{ home_label }}">
            <span class="nn-error-brand-mark" aria-hidden="true">N</span>
            <span>{{ brand }}</span>
        </a>
    </header>
    <main class="nn-error-main" aria-labelledby="nn-error-heading">
        <div class="nn-error-code" aria-hidden="true">{{ status }}</div>
        <section class="nn-error-card">
            <p class="nn-error-kicker">{{ status_label }}</p>
            <h1 id="nn-error-heading">{{ heading }}</h1>
            <p class="nn-error-description alert-danger" role="alert">{{ description }}</p>
            {% if reference %}
                <p class="nn-error-reference"><span>{{ reference_label }}</span> <code>{{ reference }}</code></p>
            {% endif %}
            {% if debug_detail %}
                <details class="nn-error-details">
                    <summary>{{ debug_label }}</summary>
                    <pre>{{ debug_detail }}</pre>
                </details>
            {% endif %}
            <nav class="nn-error-actions" aria-label="{{ action_label }}">
                <a class="nn-error-action primary" href="{{ home_url }}">{{ home_label }}</a>
            </nav>
        </section>
    </main>
    <footer class="nn-error-footer">{{ footer }}</footer>
</div>
</body>
</html>
