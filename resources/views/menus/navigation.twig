{% macro render(items, level = 0) %}{% if items %}<ul class="menu-level menu-level-{{ level }}">{% for item in items %}<li class="menu-item {{ item.children ? 'has-children' : '' }} {{ item.active ? 'is-active' : '' }}"><a href="{{ item.url }}"{% if item.new_window %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.title }}</a>{% if item.children %}{{ _self.render(item.children, level + 1) }}{% endif %}</li>{% endfor %}</ul>{% endif %}{% endmacro %}
