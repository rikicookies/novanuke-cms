{% extends "layouts/default.twig" %}
{% block title %}Password changed — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="auth-card">
    <p class="eyebrow">{{ trans('auth.reset.complete_eyebrow') }}</p>
    <h1>{{ trans('auth.reset.complete_title') }}</h1>
    <p>{{ trans('auth.reset.complete_message') }}</p>
    <a class="install-button link-button" href="/login">{{ trans('common.sign_in') }}</a>
</section>
{% endblock %}
