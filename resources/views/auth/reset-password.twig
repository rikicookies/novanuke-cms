{% extends "layouts/default.twig" %}
{% block title %}Choose a password — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="auth-card">
    <p class="eyebrow">{{ trans('auth.recovery.eyebrow') }}</p>
    <h1>{{ trans('auth.reset.title') }}</h1>
    <p>{{ trans('auth.reset.help') }}</p>
    {% if error %}<div class="form-errors"><ul><li>{{ error }}</li></ul></div>{% endif %}
    <form method="post" action="/reset-password/{{ token }}">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <label>{{ trans('common.email') }}<input type="email" name="email" value="{{ email }}" required autocomplete="email"></label>
        <label>{{ trans('account.password.new') }}<input type="password" name="password" minlength="12" required autocomplete="new-password"></label>
        <label>{{ trans('auth.register.confirm_password') }}<input type="password" name="password_confirmation" minlength="12" required autocomplete="new-password"></label>
        <button type="submit">{{ trans('account.password.save') }}</button>
    </form>
</section>
{% endblock %}
