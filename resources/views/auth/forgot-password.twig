{% extends "layouts/default.twig" %}
{% block title %}Reset password — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="auth-card">
    <p class="eyebrow">{{ trans('auth.recovery.eyebrow') }}</p>
    <h1>{{ trans('auth.recovery.title') }}</h1>
    {% if sent %}
        <div class="success-message">{{ trans('auth.recovery.sent') }}</div>
        <p>{{ trans('auth.recovery.local_help') }}</p>
    {% else %}
        <p>{{ trans('auth.recovery.help') }}</p>
        {% if error %}<div class="form-errors"><ul><li>{{ error }}</li></ul></div>{% endif %}
        <form method="post" action="/forgot-password">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <label>{{ trans('common.email') }}<input type="email" name="email" required autocomplete="email"></label>
            <button type="submit">{{ trans('auth.recovery.submit') }}</button>
            <a class="auth-link" href="/login">{{ trans('auth.recovery.back') }}</a>
        </form>
    {% endif %}
</section>
{% endblock %}
