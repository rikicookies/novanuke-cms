<div class="empty-state" role="status">
    <h2>{{ title }}</h2>
    {% if message|default('') %}<p>{{ message }}</p>{% endif %}
    {% if action_url|default(null) and action_label|default(null) %}
        <p><a class="content-action" href="{{ action_url }}">{{ action_label }}</a></p>
    {% endif %}
</div>
