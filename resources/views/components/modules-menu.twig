{% if items %}<nav class="modules-menu" aria-label="{{ trans('modules.navigation.label') }}"><ul>{% for item in items %}<li><a href="{{ item.url }}" data-module="{{ item.slug }}">{{ item.label }}</a></li>{% endfor %}</ul></nav>{% else %}<p class="empty-state">{{ trans('modules.navigation.empty') }}</p>{% endif %}
