Options -Indexes -ExecCGI

<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|bash|cmd|bat|exe|com|msi|ps1|jar|htaccess|user\.ini)$">
    Require all denied
</FilesMatch>

RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>
