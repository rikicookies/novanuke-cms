{% extends "layouts/admin.twig" %}{% set editor_title = trans(page.id|default(false) ? 'pages::editor.edit' : 'pages::editor.create') %}{% block title %}{{ editor_title }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}
<section class="admin-page nn-admin-workspace">{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('admin.title'), url: '/admin'}, {label: trans('pages::title'), url: '/admin/pages'}, {label: editor_title}]} only %}{% include 'components/admin-page-heading.twig' with {eyebrow: trans('pages::admin.eyebrow'), title: editor_title, description: trans(page.id|default(false) ? 'pages::editor.edit_help' : 'pages::editor.create_help'), actions: [{label: 'Back to Pages', url: '/admin/pages', icon: 'ph-arrow-left', variant: 'light'}]} only %}{% if error %}<div class="alert alert-danger d-flex align-items-start gap-2 nn-form-errors"><i class="ph-warning-circle mt-1"></i><div class="form-errors"><ul><li>{{ error }}</li></ul></div></div>{% endif %}
<form class="nn-admin-editor nn-golden-form" method="post" action="/admin/pages/save"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ page.id|default('') }}">
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon"><i class="ph-file-text"></i></span><div><h2>Page details</h2><p>Page identity, structure and primary content.</p></div></div><div class="nn-form-section-body"><div class="form-grid nn-form-grid"><label>{{ trans('pages::field.title') }}<input name="title" required maxlength="200" value="{{ page.title|default('') }}"></label><label>{{ trans('pages::field.slug') }}<input name="slug" required maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ page.slug|default('') }}"></label><label>{{ trans('pages::field.parent') }}<select name="parent_id"><option value="">{{ trans('pages::field.none') }}</option>{% for parent in parents %}<option value="{{ parent.id }}" {{ page.parent_id|default(null) == parent.id ? 'selected' : '' }}>{{ parent.title }}</option>{% endfor %}</select></label><label>{{ trans('pages::field.template') }}<select name="template"><option value="default">{{ trans('pages::field.default') }}</option><option value="landing" {{ page.template|default('default') == 'landing' ? 'selected' : '' }}>{{ trans('pages::field.landing') }}</option></select></label></div>
<div class="form-grid nn-form-grid"><label>{{ trans('pages::field.content_format') }}<select name="content_format"><option value="html">{{ trans('pages::field.html') }}</option><option value="markdown" {{ page.content_format|default('html') == 'markdown' ? 'selected' : '' }}>{{ trans('pages::field.markdown') }}</option></select></label></div>
<label class="wide-field nn-wide-field">{{ trans('pages::field.content') }}<textarea name="content" rows="16" required>{{ page.content|default('') }}</textarea><small>{{ trans('pages::field.content_help') }}</small></label></div></section>
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon is-publish"><i class="ph-paper-plane-tilt"></i></span><div><h2>Publishing & presentation</h2><p>Control media, navigation, publication and search metadata.</p></div></div><div class="nn-form-section-body"><div class="form-grid nn-form-grid"><label>{{ trans('pages::field.image') }}<input name="image_path" list="page-media-images" value="{{ page.image_path|default('', true) }}" placeholder="/uploads/media/..."><small>{% if media_available %}{{ trans('pages::field.media_choose') }}{% else %}{{ trans('pages::field.media_activate') }}{% endif %}</small></label><label>{{ trans('pages::field.menu_label') }}<input name="menu_title" maxlength="120" value="{{ page.menu_title|default('', true) }}" placeholder="{{ trans('pages::field.menu_placeholder') }}"></label><label>{{ trans('pages::field.status') }}<select name="status"><option value="draft">{{ trans('pages::field.draft') }}</option>{% if can_publish %}<option value="scheduled" {{ page.status|default('draft') == 'scheduled' ? 'selected' : '' }}>{{ trans('pages::field.scheduled') }}</option><option value="published" {{ page.status|default('draft') == 'published' ? 'selected' : '' }}>{{ trans('pages::field.published') }}</option>{% endif %}</select></label><label>{{ trans('pages::field.publication_time') }}<input type="datetime-local" name="published_at" value="{{ page.published_at|default('', true)|replace({' ': 'T'}) }}"></label><label>{{ trans('pages::field.seo_title') }}<input name="seo_title" maxlength="200" value="{{ page.seo_title|default('', true) }}"></label><label>{{ trans('pages::field.seo_description') }}<textarea name="seo_description" maxlength="320">{{ page.seo_description|default('', true) }}</textarea></label></div>{% if media_available %}<datalist id="page-media-images">{% for image in media_images %}<option value="{{ image.public_path }}">{{ image.title|default(image.original_name,true) }}</option>{% endfor %}</datalist>{% endif %}</div></section>
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon is-access"><i class="ph-lock-key"></i></span><div><h2>Access & behavior</h2><p>Choose who can view the page and how it participates in the site.</p></div></div><div class="nn-form-section-body"><fieldset class="editor-panel nn-editor-panel"><legend>{{ trans('pages::field.access') }}</legend><label><input type="radio" name="access_type" value="public" {{ page.access_type|default('public') == 'public' ? 'checked' : '' }}> {{ trans('pages::field.public') }}</label><label><input type="radio" name="access_type" value="members" {{ page.access_type|default('public') == 'members' ? 'checked' : '' }}> {{ trans('pages::field.members') }}</label><label><input type="radio" name="access_type" value="vip" {{ page.access_type|default('public') == 'vip' ? 'checked' : '' }}> {{ trans('pages::field.vip') }}</label><label><input type="radio" name="access_type" value="roles" {{ page.access_type|default('public') == 'roles' ? 'checked' : '' }}> {{ trans('pages::field.roles') }}</label><div class="role-checks">{% for role in roles %}<label><input type="checkbox" name="role_ids[]" value="{{ role.id }}" {{ role.id in page.role_ids|default([]) ? 'checked' : '' }}> {{ role.name }}</label>{% endfor %}</div></fieldset>
<div class="inline-checks nn-inline-checks"><label><input type="checkbox" name="show_in_directory" value="1" {{ page.show_in_directory|default(0) ? 'checked' : '' }}> {{ trans('pages::field.show_directory') }}</label><label><input type="checkbox" name="comments_enabled" value="1" {{ page.comments_enabled|default(0) ? 'checked' : '' }}> {{ trans('pages::field.comments') }}</label></div></div></section><div class="nn-editor-actions"><a href="/admin/pages" class="btn btn-light"><i class="ph-x me-2"></i>Cancel</a><button class="btn btn-primary text-white" type="submit"><i class="ph-floppy-disk me-2"></i>{{ trans('pages::field.save') }}</button></div></form>
{% if page.id|default(false) %}<form class="delete-block-form nn-delete-card" method="post" action="/admin/pages/{{ page.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> {{ trans('pages::field.confirm_delete') }}</label><button class="danger-button" type="submit">{{ trans('pages::field.delete') }}</button></form>{% endif %}</section>
{% endblock %}
