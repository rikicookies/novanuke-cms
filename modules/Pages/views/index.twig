{% extends "layouts/default.twig" %}{% block title %}{{ trans('pages::title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}
<section class="pages-directory">{% include 'components/breadcrumbs.twig' with {items: [{label: trans('pages::title')}]} only %}{% set header_actions = manage_url ? [{label: trans('pages::manage'), url: manage_url}] : [] %}{% include 'components/page-header.twig' with {eyebrow: trans('pages::eyebrow'), title: trans('pages::title'), actions: header_actions} only %}<div class="page-directory-grid">{% for page in pages %}<article><h2><a href="/pages/{{ page.slug }}">{{ page.menu_title|default(page.title, true) }}</a></h2>{% if page.access_type != 'public' %}<span class="badge">{{ trans('pages::access.' ~ page.access_type) }}</span>{% endif %}</article>{% else %}{% include 'components/empty-state.twig' with {title: trans('pages::empty'), message: trans('pages::empty_help')} only %}{% endfor %}</div></section>
{% endblock %}
