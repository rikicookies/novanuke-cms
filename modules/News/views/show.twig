{% extends "layouts/default.twig" %}
{% block title %}{{ article.seo_title|default(article.title, true) }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block meta %}{% set seo_title = article.seo_title|default(article.title, true) %}{% set seo_description = article.seo_description|default(article.summary_text, true) %}{% set canonical = cms_url ~ '/news/' ~ article.slug %}{% if seo_description %}<meta name="description" content="{{ seo_description }}">{% endif %}<link rel="canonical" href="{{ canonical }}"><meta property="og:type" content="article"><meta property="og:title" content="{{ seo_title }}"><meta property="og:url" content="{{ canonical }}">{% if seo_description %}<meta property="og:description" content="{{ seo_description }}">{% endif %}{% if article.featured_image %}<meta property="og:image" content="{{ cms_url ~ article.featured_image }}">{% endif %}<meta name="twitter:card" content="{{ article.featured_image ? 'summary_large_image' : 'summary' }}"><meta property="article:published_time" content="{{ article.published_at|date('c', 'UTC') }}"><meta property="article:modified_time" content="{{ article.updated_at|date('c', 'UTC') }}">{% endblock %}
{% block content %}
<article class="news-article">
    {% include 'components/breadcrumbs.twig' with {items: [{label: trans('news::title'), url: '/news'}, {label: article.title}]} only %}
    <header>
        {% include 'components/content-actions.twig' with {edit_url: edit_url|default(null), delete_url: delete_url|default(null), csrf_token: content_csrf_token|default(null), return_to: delete_return_to|default(null)} only %}
        {% if article.is_featured %}<span class="badge badge-active">{{ trans('news::featured') }}</span>{% endif %}
        <h1>{{ article.title }}</h1>
        <div class="news-summary">{{ article.summary_html }}</div>
        <small>{{ trans('news::by', {author: article.username}) }} · {{ article.published_at|date(cms_date_format, cms_timezone) }} · {{ trans('news::views', {count: article.view_count}) }}</small>
    </header>
    {% if article.featured_image %}<img src="{{ article.featured_image }}" alt="">{% endif %}
    <div class="article-content">{{ article.content_html }}</div>
    {% if article.tag_list %}<footer>{{ trans('news::tags') }}: {{ article.tag_list|join(', ') }}</footer>{% endif %}
    <p><a href="/news">{{ trans('news::return') }}</a></p>
</article>
{% if comments_available %}
    {% include '@comments/thread.twig' with {
        content_type: 'news', content_id: article.id, comments: comments,
        guests_allowed: comments_guests_allowed, csrf_token: comments_csrf_token,
        return_to: comments_return_to, message: comments_message, error: comments_error,
        current_user: comments_user
    } only %}
{% elseif article.comments_enabled %}
    <p class="comments-unavailable">{{ trans('news::comments_unavailable') }}</p>
{% endif %}
{% endblock %}
