{% extends "@admin-core/layouts/admin.twig" %}
{% block title %}{{ trans('news::admin.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('news::title')}]} only %}
{% include 'components/admin-page-heading.twig' with {eyebrow: trans('news::admin.eyebrow'), title: trans('news::title'), description: trans('news::admin.description'), actions: [{label: trans('news::admin.create'), url: '/admin/news/new', icon:'ph-plus'}, {label: trans('news::admin.view'), url: '/news', icon:'ph-arrow-square-out'}]} only %}
{% if message %}<div class="alert alert-success alert-icon-start"><span class="alert-icon bg-success text-white"><i class="ph-check"></i></span>{{ message }}</div>{% endif %}
{% set audience_labels = {'public':trans('news::field.public'),'member':trans('news::field.members'),'vip':trans('news::field.vip')} %}
<form method="post" action="/admin/news/bulk" id="nn-news-bulk-form">
<input type="hidden" name="_token" value="{{ csrf_token }}">
<div class="card mb-4 nn-news-card">
  <div class="card-header nn-news-toolbar py-3">
    <div class="d-flex flex-column flex-xl-row gap-3 align-items-xl-center">
      <div class="me-xl-auto"><div class="d-flex align-items-center"><h5 class="mb-0">{{ trans('news::title') }}</h5><span class="badge bg-light text-body ms-2">{{ articles|length }}</span></div><div class="text-muted fs-sm mt-1">{{ trans('news::admin.manage_help') }}</div></div>
      <div class="d-flex flex-column flex-md-row gap-2 nn-news-filters">
        <div class="position-relative"><i class="ph-magnifying-glass nn-filter-icon"></i><input form="nn-news-filter-form" class="form-control ps-5" type="search" name="q" value="{{ filters.q }}" placeholder="{{ trans('news::admin.search_placeholder') }}"></div>
        <select form="nn-news-filter-form" class="form-select" name="category"><option value="">{{ trans('news::admin.all_categories') }}</option>{% for category in categories %}<option value="{{ category.id }}"{{ filters.category == category.id ? ' selected' : '' }}>{{ category.name }}</option>{% endfor %}</select>
        <select form="nn-news-filter-form" class="form-select" name="sort"><option value="newest"{{ filters.sort == 'newest' ? ' selected' : '' }}>{{ trans('news::admin.newest_first') }}</option><option value="oldest"{{ filters.sort == 'oldest' ? ' selected' : '' }}>{{ trans('news::admin.oldest_first') }}</option></select>
        <button form="nn-news-filter-form" class="btn btn-light border" type="submit"><i class="ph-funnel me-1"></i>{{ trans('news::admin.filter') }}</button>
      </div>
    </div>
  </div>
  <div class="nn-bulk-bar d-flex flex-wrap gap-2 align-items-center px-3 py-2 border-bottom">
    <span class="text-muted fs-sm me-1"><strong id="nn-selected-count">0</strong> {{ trans('news::admin.selected') }}</span>
    <select class="form-select form-select-sm nn-bulk-select" name="bulk_action" required><option value="">{{ trans('news::admin.bulk_actions') }}</option>{% if can_publish %}<option value="publish">{{ trans('news::admin.bulk_publish') }}</option><option value="unpublish">{{ trans('news::admin.bulk_unpublish') }}</option>{% endif %}<option value="public">{{ trans('news::admin.bulk_public') }}</option><option value="member">{{ trans('news::admin.bulk_members') }}</option><option value="vip">{{ trans('news::admin.bulk_vip') }}</option><option value="delete">{{ trans('news::admin.bulk_delete') }}</option></select>
    <button class="btn btn-sm btn-light border" type="submit">{{ trans('news::admin.apply') }}</button>
  </div>
  <div class="table-responsive"><table class="table table-hover mb-0 nn-news-table"><thead><tr><th class="nn-check-col"><input class="form-check-input" type="checkbox" id="nn-select-all" aria-label="{{ trans('news::admin.select_all') }}"></th><th>{{ trans('news::admin.article') }}</th><th>{{ trans('news::admin.status') }}</th><th>{{ trans('news::admin.audience') }}</th><th>{{ trans('news::admin.category') }}</th><th>{{ trans('news::admin.publication') }}</th><th class="text-end">{{ trans('news::admin.actions') }}</th></tr></thead><tbody>
  {% for article in articles %}<tr><td class="nn-check-col"><input class="form-check-input nn-row-check" type="checkbox" name="ids[]" value="{{ article.id }}" aria-label="{{ trans('news::admin.select_article', {title: article.title}) }}"></td><td><div class="fw-semibold"><a class="text-body" href="/admin/news/{{ article.id }}/edit">{{ article.title }}</a></div><div class="text-muted fs-sm mt-1"><i class="ph-link-simple me-1"></i>{{ article.slug }}{% if article.username %}<span class="mx-1">·</span><i class="ph-user me-1"></i>{{ article.username }}{% endif %}</div></td><td><span class="badge rounded-pill {{ article.status == 'published' ? 'bg-success bg-opacity-10 text-success' : 'bg-secondary bg-opacity-10 text-secondary' }}"><span class="nn-status-dot me-1"></span>{{ trans('news::field.' ~ article.status) }}</span></td><td><span class="d-inline-flex align-items-center"><i class="{{ article.audience == 'public' ? 'ph-globe' : (article.audience == 'vip' ? 'ph-crown' : 'ph-users') }} me-2 text-muted"></i>{{ audience_labels[article.audience]|default(article.audience) }}</span></td><td>{% if article.category_name %}<span class="badge bg-primary bg-opacity-10 text-primary nn-category-badge">{{ article.category_name }}</span>{% else %}<span class="text-muted">—</span>{% endif %}</td><td><span class="text-nowrap"><i class="ph-calendar-blank me-1 text-muted"></i>{{ article.published_at|default('—', true) }}</span></td><td class="text-end"><div class="d-inline-flex gap-1"><a class="btn btn-light btn-icon btn-sm border" href="/admin/news/{{ article.id }}/edit" title="{{ trans('news::admin.edit') }}"><i class="ph-pencil-simple"></i></a>{% if article.status == 'published' %}<a class="btn btn-light btn-icon btn-sm border" href="/news/{{ article.slug }}" title="{{ trans('news::admin.view') }}"><i class="ph-arrow-square-out"></i></a>{% endif %}<details class="nn-more-actions"><summary class="btn btn-light btn-icon btn-sm border" title="{{ trans('news::admin.more_actions') }}"><i class="ph-dots-three-vertical"></i></summary><div class="nn-more-menu"><a href="/admin/news/{{ article.id }}/edit"><i class="ph-pencil-simple"></i>{{ trans('news::admin.edit_article') }}</a>{% if article.status == 'published' %}<a href="/news/{{ article.slug }}"><i class="ph-arrow-square-out"></i>{{ trans('news::admin.view_article') }}</a>{% endif %}<button type="button" class="nn-select-for-bulk" data-id="{{ article.id }}"><i class="ph-check-square"></i>{{ trans('news::admin.select_bulk') }}</button></div></details></div></td></tr>
  {% else %}<tr><td colspan="7" class="text-center py-5"><i class="ph-newspaper fs-1 text-muted"></i><h6 class="mt-3 mb-1">{{ trans('news::admin.empty') }}</h6><p class="text-muted mb-3">{{ trans('news::admin.empty_help') }}</p><a class="btn btn-primary" href="/admin/news/new"><i class="ph-plus me-2"></i>{{ trans('news::admin.create') }}</a></td></tr>{% endfor %}
  </tbody></table></div>
  <div class="card-footer bg-white d-flex justify-content-between align-items-center"><span class="text-muted fs-sm">{{ trans('news::admin.showing', {count: articles|length}) }}</span>{% if filters.q or filters.category %}<a class="btn btn-sm btn-light border" href="/admin/news">{{ trans('news::admin.clear_filters') }}</a>{% endif %}</div>
</div></form>
<form id="nn-news-filter-form" method="get" action="/admin/news"></form>
<div class="row g-4 nn-taxonomy-row">
<div class="col-xl-6"><form class="card h-100 nn-taxonomy-card" method="post" action="/admin/news/taxonomy/category"><input type="hidden" name="_token" value="{{ csrf_token }}"><div class="card-body"><div class="d-flex gap-3 align-items-start mb-3"><span class="nn-taxonomy-icon bg-primary bg-opacity-10 text-primary"><i class="ph-folder-open"></i></span><div><h5 class="mb-1">{{ trans('news::admin.create_category') }}</h5><div class="text-muted fs-sm">{{ trans('news::admin.category_help') }}</div></div></div><label class="form-label">{{ trans('news::admin.name') }}</label><div class="d-flex flex-column flex-md-row gap-2"><input class="form-control" name="name" required maxlength="120" placeholder="{{ trans('news::admin.category_placeholder') }}"><input type="hidden" name="slug" class="nn-auto-slug"><button class="btn btn-primary text-nowrap" type="submit"><i class="ph-plus me-2"></i>{{ trans('news::admin.add_category') }}</button></div><details class="mt-3"><summary class="text-muted fs-sm nn-advanced-summary">{{ trans('news::admin.advanced_options') }}</summary><div class="mt-3"><label class="form-label">{{ trans('news::admin.slug') }}</label><input class="form-control nn-slug-input" name="slug_override" pattern="[a-z0-9-]+" placeholder="{{ trans('news::admin.auto_generated') }}"><label class="form-label mt-3">{{ trans('news::admin.description_field') }}</label><textarea class="form-control" name="description" maxlength="500" rows="2"></textarea></div></details></div></form></div>
<div class="col-xl-6"><form class="card h-100 nn-taxonomy-card" method="post" action="/admin/news/taxonomy/topic"><input type="hidden" name="_token" value="{{ csrf_token }}"><div class="card-body"><div class="d-flex gap-3 align-items-start mb-3"><span class="nn-taxonomy-icon nn-topic-icon"><i class="ph-tag"></i></span><div><h5 class="mb-1">{{ trans('news::admin.create_topic') }}</h5><div class="text-muted fs-sm">{{ trans('news::admin.topic_help') }}</div></div></div><label class="form-label">{{ trans('news::admin.name') }}</label><div class="d-flex flex-column flex-md-row gap-2"><input class="form-control" name="name" required maxlength="120" placeholder="{{ trans('news::admin.topic_placeholder') }}"><input type="hidden" name="slug" class="nn-auto-slug"><button class="btn btn-primary text-nowrap" type="submit"><i class="ph-plus me-2"></i>{{ trans('news::admin.add_topic') }}</button></div><details class="mt-3"><summary class="text-muted fs-sm nn-advanced-summary">{{ trans('news::admin.advanced_options') }}</summary><div class="mt-3"><label class="form-label">{{ trans('news::admin.slug') }}</label><input class="form-control nn-slug-input" name="slug_override" pattern="[a-z0-9-]+" placeholder="{{ trans('news::admin.auto_generated') }}"><label class="form-label mt-3">{{ trans('news::admin.description_field') }}</label><textarea class="form-control" name="description" maxlength="500" rows="2"></textarea></div></details></div></form></div>
</div>
<div class="row g-4 mt-1">
<div class="col-xl-6"><div class="card nn-taxonomy-card"><div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0">{{ trans('news::admin.categories') }}</h5><span class="badge bg-light text-body">{{ categories|length }}</span></div><div class="list-group list-group-flush">{% for category in categories %}<div class="list-group-item d-flex justify-content-between align-items-center gap-3"><div><div class="fw-semibold">{{ category.name }}</div><div class="text-muted fs-sm">{{ category.slug }}{% if category.description %} · {{ category.description }}{% endif %}</div></div><a class="btn btn-light btn-icon btn-sm border" href="/admin/news/taxonomy/category/{{ category.id }}/edit" title="{{ trans('news::admin.edit_category') }}"><i class="ph-pencil-simple"></i><span class="visually-hidden">{{ trans('news::admin.edit_category') }}</span></a></div>{% else %}<div class="p-4 text-muted">{{ trans('news::admin.no_categories') }}</div>{% endfor %}</div></div></div>
<div class="col-xl-6"><div class="card nn-taxonomy-card"><div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0">{{ trans('news::admin.topics') }}</h5><span class="badge bg-light text-body">{{ topics|length }}</span></div><div class="list-group list-group-flush">{% for topic in topics %}<div class="list-group-item d-flex justify-content-between align-items-center gap-3"><div><div class="fw-semibold">{{ topic.name }}</div><div class="text-muted fs-sm">{{ topic.slug }}{% if topic.description %} · {{ topic.description }}{% endif %}</div></div><a class="btn btn-light btn-icon btn-sm border" href="/admin/news/taxonomy/topic/{{ topic.id }}/edit" title="{{ trans('news::admin.edit_topic') }}"><i class="ph-pencil-simple"></i><span class="visually-hidden">{{ trans('news::admin.edit_topic') }}</span></a></div>{% else %}<div class="p-4 text-muted">{{ trans('news::admin.no_topics') }}</div>{% endfor %}</div></div></div>
</div>
{% endblock %}
{% block scripts %}<script src="/assets/admin/limitless/js/news-admin.js"></script>{% endblock %}
