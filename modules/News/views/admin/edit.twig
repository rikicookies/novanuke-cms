{% extends "@admin-core/layouts/admin.twig" %}{% set editor_title = trans(article.id|default(false) ? 'news::editor.edit' : 'news::editor.create') %}{% block title %}{{ editor_title }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}
<section class="admin-page nn-admin-workspace">{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('admin.title'), url: '/admin'}, {label: trans('news::title'), url: '/admin/news'}, {label: editor_title}]} only %}{% include 'components/admin-page-heading.twig' with {eyebrow: trans('news::admin.eyebrow'), title: editor_title, description: trans(article.id|default(false) ? 'news::editor.edit_help' : 'news::editor.create_help'), actions: [{label: trans('news::editor.back'), url: '/admin/news', icon: 'ph-arrow-left', variant: 'light'}]} only %}{% if error %}<div class="alert alert-danger d-flex align-items-start gap-2 nn-form-errors"><i class="ph-warning-circle mt-1"></i><div class="form-errors"><ul><li>{{ error }}</li></ul></div></div>{% endif %}<form class="nn-admin-editor nn-golden-form" method="post" action="/admin/news/save"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ article.id|default('') }}">
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon"><i class="ph-newspaper"></i></span><div><h2>{{ trans('news::editor.section_details') }}</h2><p>{{ trans('news::editor.section_details_help') }}</p></div></div><div class="nn-form-section-body"><div class="form-grid nn-form-grid"><label>{{ trans('news::field.title') }}<input name="title" required maxlength="200" value="{{ article.title|default('') }}"></label><label>{{ trans('news::field.slug') }}<input name="slug" required maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ article.slug|default('') }}"></label><label>{{ trans('news::field.category') }}<select name="category_id"><option value="">{{ trans('news::field.none') }}</option>{% for category in categories %}<option value="{{ category.id }}" {{ article.category_id|default(null) == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></label><label>{{ trans('news::field.topic') }}<select name="topic_id"><option value="">{{ trans('news::field.none') }}</option>{% for topic in topics %}<option value="{{ topic.id }}" {{ article.topic_id|default(null) == topic.id ? 'selected' : '' }}>{{ topic.name }}</option>{% endfor %}</select></label></div>
<div class="form-grid nn-form-grid"><label>{{ trans('news::field.summary_format') }}<select name="summary_format"><option value="html">{{ trans('news::field.html') }}</option><option value="markdown" {{ article.summary_format|default('html') == 'markdown' ? 'selected' : '' }}>{{ trans('news::field.markdown') }}</option></select></label><label>{{ trans('news::field.content_format') }}<select name="content_format"><option value="html">{{ trans('news::field.html') }}</option><option value="markdown" {{ article.content_format|default('html') == 'markdown' ? 'selected' : '' }}>{{ trans('news::field.markdown') }}</option></select></label></div>
<label class="wide-field nn-wide-field">{{ trans('news::field.summary') }}<textarea name="summary" rows="3" maxlength="1000">{{ article.summary|default('', true) }}</textarea></label><label class="wide-field nn-wide-field">{{ trans('news::field.content') }}<textarea name="content" rows="14" required>{{ article.content|default('') }}</textarea><small>{{ trans('news::field.content_help') }}</small></label></div></section>
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon is-publish"><i class="ph-paper-plane-tilt"></i></span><div><h2>{{ trans('news::editor.section_publish') }}</h2><p>{{ trans('news::editor.section_publish_help') }}</p></div></div><div class="nn-form-section-body"><div class="form-grid nn-form-grid"><label>{{ trans('news::field.tags') }}<input name="tags" value="{{ article.tags|default('') }}" placeholder="{{ trans('news::field.tags_placeholder') }}"></label><label>{{ trans('news::field.image') }}<input name="featured_image" list="news-media-images" value="{{ article.featured_image|default('', true) }}" placeholder="/uploads/media/..."><small>{% if media_available %}{{ trans('news::field.image_choose') }} <a href="/admin/media">{{ trans('news::field.open_media') }}</a>.{% else %}{{ trans('news::field.activate_media') }}{% endif %}</small></label><label>{{ trans('news::field.status') }}<select name="status"><option value="draft">{{ trans('news::field.draft') }}</option>{% if can_publish %}<option value="scheduled" {{ article.status|default('draft') == 'scheduled' ? 'selected' : '' }}>{{ trans('news::field.scheduled') }}</option><option value="published" {{ article.status|default('draft') == 'published' ? 'selected' : '' }}>{{ trans('news::field.published') }}</option>{% endif %}</select></label><label>{{ trans('news::field.publication_time') }}<input type="datetime-local" name="published_at" value="{{ article.published_at|default('', true)|replace({' ': 'T'}) }}"></label><label>{{ trans('news::field.seo_title') }}<input name="seo_title" maxlength="200" value="{{ article.seo_title|default('', true) }}"></label><label>{{ trans('news::field.seo_description') }}<textarea name="seo_description" maxlength="320">{{ article.seo_description|default('', true) }}</textarea></label></div>{% if media_available %}<datalist id="news-media-images">{% for image in media_images %}<option value="{{ image.public_path }}">{{ image.title|default(image.original_name,true) }}</option>{% endfor %}</datalist>{% endif %}</div></section>
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon is-access"><i class="ph-lock-key"></i></span><div><h2>{{ trans('news::editor.section_access') }}</h2><p>{{ trans('news::editor.section_access_help') }}</p></div></div><div class="nn-form-section-body"><fieldset class="editor-panel nn-editor-panel"><legend>{{ trans('news::field.audience') }}</legend><label><input type="radio" name="audience" value="public" {{ article.audience|default('public') == 'public' ? 'checked' : '' }}> {{ trans('news::field.public') }}</label><label><input type="radio" name="audience" value="member" {{ article.audience|default('public') == 'member' ? 'checked' : '' }}> {{ trans('news::field.members') }}</label><label><input type="radio" name="audience" value="vip" {{ article.audience|default('public') == 'vip' ? 'checked' : '' }}> {{ trans('news::field.vip') }}</label></fieldset>
<div class="inline-checks nn-inline-checks"><label><input type="checkbox" name="is_featured" value="1" {{ article.is_featured|default(0) ? 'checked' : '' }}> {{ trans('news::field.featured') }}</label><label><input type="checkbox" name="comments_enabled" value="1" {{ article.comments_enabled|default(1) ? 'checked' : '' }}> {{ trans('news::field.comments') }}</label></div></div></section><div class="nn-editor-actions"><a href="/admin/news" class="btn btn-light"><i class="ph-x me-2"></i>{{ trans('news::editor.cancel') }}</a><button class="btn btn-primary text-white" type="submit"><i class="ph-floppy-disk me-2"></i>{{ trans('news::field.save') }}</button></div></form>
{% if article.id|default(false) %}<form class="delete-block-form nn-delete-card" method="post" action="/admin/news/{{ article.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> {{ trans('news::field.confirm_delete') }}</label><button class="danger-button" type="submit">{{ trans('news::field.delete') }}</button></form>{% endif %}</section>{% endblock %}
