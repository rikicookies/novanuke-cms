{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('quotes::admin.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<div class="nn-quotes-v2">
  {% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('quotes::title')}]} only %}
  {% include 'components/admin-page-heading.twig' with {
    eyebrow: trans('quotes::admin.eyebrow'),
    title: trans('quotes::title'),
    description: trans('quotes::admin.description'),
    actions: [{label: trans('quotes::admin.view'), url: '/quotes', icon: 'ph-arrow-square-out'}]
  } only %}

  {% if message %}<div class="alert alert-success alert-icon-start"><span class="alert-icon bg-success text-white"><i class="ph-check"></i></span>{{ message }}</div>{% endif %}
  {% if error %}<div class="alert alert-danger alert-icon-start"><span class="alert-icon bg-danger text-white"><i class="ph-warning"></i></span>{{ error }}</div>{% endif %}

  {% set published_count = 0 %}
  {% set draft_count = 0 %}
  {% for quote in quotes %}
    {% if quote.is_published %}{% set published_count = published_count + 1 %}{% else %}{% set draft_count = draft_count + 1 %}{% endif %}
  {% endfor %}

  <div class="row g-3 mb-4">
    <div class="col-sm-4"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10 text-primary" style="width:44px;height:44px"><i class="ph-quotes fs-4"></i></span><div><div class="text-muted fs-sm">{{ trans('quotes::admin.metric.total') }}</div><div class="fs-4 fw-bold">{{ quotes|length }}</div></div></div></div></div>
    <div class="col-sm-4"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-success bg-opacity-10 text-success" style="width:44px;height:44px"><i class="ph-check-circle fs-4"></i></span><div><div class="text-muted fs-sm">{{ trans('quotes::admin.metric.published') }}</div><div class="fs-4 fw-bold">{{ published_count }}</div></div></div></div></div>
    <div class="col-sm-4"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-warning bg-opacity-10 text-warning" style="width:44px;height:44px"><i class="ph-pencil-simple fs-4"></i></span><div><div class="text-muted fs-sm">{{ trans('quotes::admin.metric.drafts') }}</div><div class="fs-4 fw-bold">{{ draft_count }}</div></div></div></div></div>
  </div>

  <div class="row g-4 align-items-start">
    <div class="col-xxl-8 order-2 order-xxl-1">
      <div class="card">
        <div class="card-header py-3 d-flex flex-column flex-sm-row gap-2 align-items-sm-center">
          <div class="me-auto"><h5 class="mb-1">{{ trans('quotes::admin.inventory') }}</h5><div class="text-muted fs-sm">{{ trans('quotes::admin.inventory_help') }}</div></div>
          <span class="badge bg-light text-body">{{ trans('quotes::admin.count', {count: quotes|length}) }}</span>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead><tr><th>{{ trans('quotes::field.quote') }}</th><th>{{ trans('quotes::field.attribution') }}</th><th>{{ trans('quotes::field.status') }}</th><th class="text-end">{{ trans('quotes::field.action') }}</th></tr></thead>
            <tbody>
            {% for quote in quotes %}
              <tr>
                <td><div class="fw-semibold text-body">“{{ quote.quote_text }}”</div><div class="text-muted fs-sm mt-1">#{{ quote.id }}</div></td>
                <td>{% if quote.attribution %}<span class="text-body">{{ quote.attribution }}</span>{% else %}<span class="text-muted">—</span>{% endif %}</td>
                <td><span class="badge rounded-pill {{ quote.is_published ? 'bg-success bg-opacity-10 text-success' : 'bg-warning bg-opacity-10 text-warning' }}"><i class="{{ quote.is_published ? 'ph-check-circle' : 'ph-pencil-simple' }} me-1"></i>{{ trans(quote.is_published ? 'quotes::status.published' : 'quotes::status.draft') }}</span></td>
                <td class="text-end"><form method="post" action="/admin/quotes/{{ quote.id }}/delete" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="btn btn-light btn-icon btn-sm border text-danger" type="submit" title="{{ trans('quotes::action.delete') }}" aria-label="{{ trans('quotes::action.delete') }}"><i class="ph-trash"></i></button></form></td>
              </tr>
            {% else %}
              <tr><td colspan="4" class="text-center py-5"><i class="ph-quotes fs-1 text-muted"></i><h6 class="mt-3 mb-1">{{ trans('quotes::admin.empty') }}</h6><p class="text-muted mb-0">{{ trans('quotes::admin.empty_help') }}</p></td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-xxl-4 order-1 order-xxl-2">
      <form method="post" action="/admin/quotes" class="card">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <div class="card-header py-3"><div class="d-flex align-items-center gap-3"><span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10 text-primary" style="width:42px;height:42px"><i class="ph-plus fs-5"></i></span><div><h5 class="mb-0">{{ trans('quotes::admin.create') }}</h5><div class="text-muted fs-sm mt-1">{{ trans('quotes::admin.create_help') }}</div></div></div></div>
        <div class="card-body">
          <div class="mb-3"><label class="form-label fw-semibold" for="quote_text">{{ trans('quotes::field.quote') }}</label><textarea class="form-control" id="quote_text" name="quote_text" maxlength="500" rows="5" required placeholder="{{ trans('quotes::admin.quote_placeholder') }}"></textarea><div class="form-text">{{ trans('quotes::admin.quote_help') }}</div></div>
          <div class="mb-3"><label class="form-label fw-semibold" for="attribution">{{ trans('quotes::field.attribution') }}</label><input class="form-control" id="attribution" name="attribution" maxlength="120" placeholder="{{ trans('quotes::admin.attribution_placeholder') }}"><div class="form-text">{{ trans('quotes::admin.attribution_help') }}</div></div>
          <label class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" name="is_published" value="1" checked><span class="form-check-label"><strong class="d-block">{{ trans('quotes::status.published') }}</strong><span class="text-muted fs-sm">{{ trans('quotes::admin.publish_help') }}</span></span></label>
        </div>
        <div class="card-footer bg-white"><button class="btn btn-primary w-100" type="submit"><i class="ph-plus me-2"></i>{{ trans('quotes::admin.create') }}</button></div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
