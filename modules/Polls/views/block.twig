<div class="poll-block"><strong>{{ poll.question|default(trans('polls::poll')) }}</strong>{% if poll.accepting|default(false) and not has_voted|default(false) %}<form method="post" action="/polls/{{ poll.id|default(0) }}/vote"><input type="hidden" name="_token" value="{{ csrf_token|default('') }}"><input type="hidden" name="_return" value="{{ return_path|default('/') }}">{% for option in poll.options|default([]) %}<label><input type="{{ poll.allow_multiple|default(false) ? 'checkbox' : 'radio' }}" name="options[]" value="{{ option.id|default(0) }}"> {{ option.label|default(trans('polls::option')) }}</label>{% endfor %}<button type="submit">{{ trans('polls::vote') }}</button></form>{% else %}<p>{{ has_voted|default(false) ? trans('polls::thanks_short') : trans('polls::voting_closed') }}</p>{% endif %}<a href="/polls/{{ poll.id|default(0) }}">{{ trans('polls::view_results_short') }}</a></div>
