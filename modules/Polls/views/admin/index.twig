{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('polls::admin.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<div class="nn-polls-v2">
{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('polls::title')}]} only %}
{% include 'components/admin-page-heading.twig' with {eyebrow: trans('polls::admin.eyebrow'), title: trans('polls::title'), description: trans('polls::admin.description'), actions: [{label: trans('polls::admin.create'), url: '/admin/polls', icon:'ph-plus'}, {label: trans('polls::admin.view_public'), url: '/polls', icon:'ph-arrow-square-out'}]} only %}

{% if message %}<div class="alert alert-success alert-icon-start"><span class="alert-icon bg-success text-white"><i class="ph-check"></i></span>{{ message }}</div>{% endif %}
{% if error %}<div class="alert alert-danger alert-icon-start"><span class="alert-icon bg-danger text-white"><i class="ph-warning"></i></span>{{ error }}</div>{% endif %}

{% set total_votes = 0 %}{% set active_count = 0 %}{% set draft_count = 0 %}{% set closed_count = 0 %}
{% for poll in polls %}{% set total_votes = total_votes + poll.vote_count %}{% if poll.status == 'active' %}{% set active_count = active_count + 1 %}{% elseif poll.status == 'draft' %}{% set draft_count = draft_count + 1 %}{% else %}{% set closed_count = closed_count + 1 %}{% endif %}{% endfor %}
<div class="row g-3 mb-4 nn-polls-metrics">
  <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="nn-poll-metric-icon bg-primary bg-opacity-10 text-primary"><i class="ph-chart-bar"></i></span><div><div class="text-muted fs-sm">{{ trans('polls::admin.metric.total') }}</div><div class="fs-4 fw-bold">{{ polls|length }}</div></div></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="nn-poll-metric-icon bg-success bg-opacity-10 text-success"><i class="ph-broadcast"></i></span><div><div class="text-muted fs-sm">{{ trans('polls::admin.metric.active') }}</div><div class="fs-4 fw-bold">{{ active_count }}</div></div></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="nn-poll-metric-icon bg-warning bg-opacity-10 text-warning"><i class="ph-pencil-line"></i></span><div><div class="text-muted fs-sm">{{ trans('polls::admin.metric.drafts') }}</div><div class="fs-4 fw-bold">{{ draft_count }}</div></div></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="nn-poll-metric-icon nn-poll-votes-icon"><i class="ph-check-square-offset"></i></span><div><div class="text-muted fs-sm">{{ trans('polls::admin.metric.votes') }}</div><div class="fs-4 fw-bold">{{ total_votes }}</div></div></div></div></div>
</div>

<div class="row g-4 align-items-start">
  <div class="col-xxl-8 order-2 order-xxl-1">
    <div class="card nn-polls-inventory">
      <div class="card-header py-3 d-flex flex-column flex-md-row gap-2 align-items-md-center"><div class="me-auto"><h5 class="mb-1">{{ trans('polls::admin.inventory') }}</h5><div class="text-muted fs-sm">{{ trans('polls::admin.inventory_help') }}</div></div><span class="badge bg-light text-body">{{ polls|length }} {{ trans('polls::admin.polls_count') }}</span></div>
      <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ trans('polls::admin.question') }}</th><th>{{ trans('polls::admin.status') }}</th><th>{{ trans('polls::admin.votes') }}</th><th>{{ trans('polls::admin.schedule') }}</th><th class="text-end">{{ trans('polls::admin.actions') }}</th></tr></thead><tbody>
      {% set status_labels = {'draft':trans('polls::status.draft'),'active':trans('polls::status.active'),'closed':trans('polls::status.closed')} %}
      {% for poll in polls %}
        <tr>
          <td class="nn-poll-question"><a class="fw-semibold text-body" href="/admin/polls?edit={{ poll.id }}">{{ poll.question }}</a><div class="text-muted fs-sm mt-1">#{{ poll.id }}{% if poll.allow_multiple %}<span class="mx-1">·</span><i class="ph-checks me-1"></i>{{ trans('polls::admin.multiple_short', {count: poll.max_selections}) }}{% endif %}</div></td>
          <td><span class="badge rounded-pill {{ poll.status == 'active' ? 'bg-success bg-opacity-10 text-success' : (poll.status == 'draft' ? 'bg-warning bg-opacity-10 text-warning' : 'bg-secondary bg-opacity-10 text-secondary') }}"><span class="nn-status-dot me-1"></span>{{ status_labels[poll.status]|default(poll.status) }}</span></td>
          <td><div class="fw-semibold">{{ poll.vote_count }}</div><div class="text-muted fs-sm">{{ trans('polls::admin.voters') }}</div></td>
          <td class="text-nowrap fs-sm">{% if poll.starts_at %}<div><i class="ph-play-circle me-1 text-muted"></i>{{ poll.starts_at }}</div>{% endif %}{% if poll.ends_at %}<div class="mt-1"><i class="ph-stop-circle me-1 text-muted"></i>{{ poll.ends_at }}</div>{% endif %}{% if not poll.starts_at and not poll.ends_at %}<span class="text-muted">{{ trans('polls::admin.no_schedule') }}</span>{% endif %}</td>
          <td class="text-end"><div class="d-inline-flex gap-1"><a class="btn btn-light btn-icon btn-sm border" href="/admin/polls?edit={{ poll.id }}" title="{{ trans('polls::admin.edit_action') }}"><i class="ph-pencil-simple"></i></a><a class="btn btn-light btn-icon btn-sm border" href="/polls/{{ poll.id }}" title="{{ trans('polls::admin.view') }}"><i class="ph-arrow-square-out"></i></a><details class="nn-poll-danger"><summary class="btn btn-light btn-icon btn-sm border" title="{{ trans('polls::admin.delete') }}"><i class="ph-trash"></i></summary><div class="nn-poll-danger-menu"><div class="fw-semibold mb-1">{{ trans('polls::admin.delete_title') }}</div><div class="text-muted fs-sm mb-3">{{ trans('polls::admin.delete_help') }}</div><form method="post" action="/admin/polls/{{ poll.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirm_delete" value="1" required><span class="form-check-label">{{ trans('polls::admin.confirm') }}</span></label><button class="btn btn-danger btn-sm w-100" type="submit"><i class="ph-trash me-1"></i>{{ trans('polls::admin.delete') }}</button></form></div></details></div></td>
        </tr>
      {% else %}<tr><td colspan="5" class="text-center py-5"><i class="ph-chart-bar fs-1 text-muted"></i><h6 class="mt-3 mb-1">{{ trans('polls::admin.empty') }}</h6><p class="text-muted mb-0">{{ trans('polls::admin.empty_help') }}</p></td></tr>{% endfor %}
      </tbody></table></div>
      {% if polls|length %}<div class="card-footer bg-white text-muted fs-sm">{{ trans('polls::admin.inventory_footer', {count: polls|length, votes: total_votes}) }}</div>{% endif %}
    </div>
  </div>

  <div class="col-xxl-4 order-1 order-xxl-2">
    <form class="card nn-poll-editor" method="post" action="/admin/polls/save">
      <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ edit.id|default('') }}">
      <div class="card-header py-3"><div class="d-flex align-items-center gap-3"><span class="nn-poll-editor-icon"><i class="{{ edit.id|default(null) ? 'ph-pencil-simple' : 'ph-plus' }}"></i></span><div><h5 class="mb-0">{{ trans(edit.id|default(null) ? 'polls::admin.edit' : 'polls::admin.create') }}</h5><div class="text-muted fs-sm mt-1">{{ trans(edit.id|default(null) ? 'polls::admin.edit_help' : 'polls::admin.create_help') }}</div></div></div></div>
      <div class="card-body">
        <div class="mb-3"><label class="form-label fw-semibold">{{ trans('polls::admin.question') }}</label><textarea class="form-control" name="question" required minlength="5" maxlength="300" rows="3" placeholder="{{ trans('polls::admin.question_placeholder') }}">{{ edit.question|default('') }}</textarea><div class="form-text">{{ trans('polls::admin.question_help') }}</div></div>
        <div class="mb-3"><label class="form-label fw-semibold">{{ trans('polls::admin.options') }}</label><textarea class="form-control nn-poll-options" name="options" required rows="6" placeholder="{{ trans('polls::admin.options_placeholder') }}">{% for option in edit.options|default([]) %}{{ option.label }}{% if not loop.last %}
{% endif %}{% endfor %}</textarea><div class="form-text"><i class="ph-info me-1"></i>{{ trans('polls::admin.options_locked_help') }}</div></div>
        <div class="row g-3 mb-3"><div class="col-sm-6"><label class="form-label fw-semibold">{{ trans('polls::admin.status') }}</label><select class="form-select" name="status"><option value="draft"{{ edit.status|default('draft') == 'draft' ? ' selected' : '' }}>{{ trans('polls::status.draft') }}</option><option value="active"{{ edit.status|default('') == 'active' ? ' selected' : '' }}>{{ trans('polls::status.active') }}</option><option value="closed"{{ edit.status|default('') == 'closed' ? ' selected' : '' }}>{{ trans('polls::status.closed') }}</option></select></div><div class="col-sm-6"><label class="form-label fw-semibold">{{ trans('polls::admin.max_selections') }}</label><input class="form-control" type="number" name="max_selections" min="2" max="20" value="{{ edit.max_selections|default(2) }}"></div></div>
        <label class="nn-poll-switch mb-3"><input type="checkbox" name="allow_multiple" value="1"{{ edit.allow_multiple|default(false) ? ' checked' : '' }}><span class="nn-poll-switch-ui"></span><span><strong>{{ trans('polls::admin.allow_multiple') }}</strong><small>{{ trans('polls::admin.allow_multiple_help') }}</small></span></label>
        <details class="nn-poll-schedule"{{ edit.starts_at|default(null) or edit.ends_at|default(null) ? ' open' : '' }}><summary><span><i class="ph-calendar-blank me-2"></i>{{ trans('polls::admin.schedule_settings') }}</span><i class="ph-caret-down"></i></summary><div class="pt-3"><div class="mb-3"><label class="form-label">{{ trans('polls::admin.starts_at') }}</label><input class="form-control" type="datetime-local" name="starts_at" value="{{ edit.starts_at|default('',true)|replace({' ':'T'}) }}"></div><div><label class="form-label">{{ trans('polls::admin.ends_at') }}</label><input class="form-control" type="datetime-local" name="ends_at" value="{{ edit.ends_at|default('',true)|replace({' ':'T'}) }}"></div></div></details>
      </div>
      <div class="card-footer bg-white d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit"><i class="ph-floppy-disk me-2"></i>{{ trans('polls::admin.save') }}</button>{% if edit.id|default(null) %}<a class="btn btn-light border" href="/admin/polls" title="{{ trans('polls::admin.cancel_edit') }}"><i class="ph-x"></i></a>{% endif %}</div>
    </form>
  </div>
</div>
</div>
{% endblock %}
