{% extends "layouts/default.twig" %}{% block title %}{{ trans('downloads::title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}
<section class="downloads-page">{% include 'components/breadcrumbs.twig' with {items: [{label: trans('downloads::title')}]} only %}{% set header_actions = manage_url ? [{label: trans('downloads::manage'), url: manage_url}] : [] %}{% include 'components/page-header.twig' with {eyebrow: trans('downloads::eyebrow'), title: trans('downloads::title'), actions: header_actions} only %}<nav class="category-links"><a href="/downloads">{{ trans('downloads::all') }}</a>{% for category in categories %}<a href="/downloads/category/{{ category.slug }}">{{ category.parent_name ? category.parent_name ~ ' / ' : '' }}{{ category.name }}</a>{% endfor %}</nav><form class="download-filters" method="get"><input name="q" maxlength="100" value="{{ search }}" placeholder="{{ trans('downloads::search_placeholder') }}"><select name="order"><option value="new">{{ trans('downloads::order.new') }}</option><option value="popular" {{ order == 'popular' ? 'selected' : '' }}>{{ trans('downloads::order.popular') }}</option><option value="name" {{ order == 'name' ? 'selected' : '' }}>{{ trans('downloads::order.name') }}</option></select><button type="submit">{{ trans('downloads::search') }}</button></form>
<div class="download-grid">{% for item in result.items %}<article class="download-card">{% if item.image_path %}<img src="{{ item.image_path }}" alt="">{% endif %}{% if item.is_featured %}<span class="badge badge-active">{{ trans('downloads::featured') }}</span>{% endif %}<h2><a href="/downloads/{{ item.slug }}">{{ item.name }}</a></h2><p>{{ item.description_text|slice(0, 220) }}</p><small>{{ item.category_name|default(trans('downloads::uncategorized'), true) }} · {{ trans('downloads::count', {count: item.download_count}) }}{% if item.version %} · v{{ item.version }}{% endif %}</small></article>{% else %}{% include 'components/empty-state.twig' with {title: trans('downloads::empty'), message: trans('downloads::empty_help')} only %}{% endfor %}</div>{% set pagination_url = '?q=' ~ (search|url_encode) ~ '&order=' ~ (order|url_encode) ~ '&page={page}' %}{% include 'components/pagination.twig' with {current_page: result.page, total_pages: result.pages, url_template: pagination_url, label: trans('downloads::pagination')} only %}</section>
{% endblock %}
