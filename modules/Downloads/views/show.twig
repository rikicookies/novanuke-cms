{% extends "layouts/default.twig" %}{% block title %}{{ download.name }} — {{ trans('downloads::title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}
<article class="download-detail">
{% include 'components/breadcrumbs.twig' with {items: [{label: trans('downloads::title'), url: '/downloads'}, {label: download.name}]} only %}
{% if message %}<div class="success-message">{{ message }}</div>{% endif %}{% if error %}<div class="form-errors"><p>{{ error }}</p></div>{% endif %}
<header>{% include 'components/content-actions.twig' with {edit_url: edit_url|default(null), delete_url: delete_url|default(null), csrf_token: content_csrf_token|default(null), return_to: delete_return_to|default(null)} only %}{% if download.is_featured %}<span class="badge badge-active">{{ trans('downloads::featured') }}</span>{% endif %}<h1>{{ download.name }}</h1><p>{{ download.category_name|default(trans('downloads::uncategorized'), true) }} · {{ trans('downloads::count', {count: download.download_count}) }}</p></header>
{% if download.image_path %}<img src="{{ download.image_path }}" alt="">{% endif %}<div class="article-content">{{ download.description_html }}</div>
<dl class="download-meta"><dt>{{ trans('downloads::version') }}</dt><dd>{{ download.version|default('—', true) }}</dd><dt>{{ trans('downloads::author') }}</dt><dd>{{ download.author_name|default('—', true) }}</dd><dt>{{ trans('downloads::license') }}</dt><dd>{{ download.license_name|default('—', true) }}</dd><dt>{{ trans('downloads::size') }}</dt><dd>{{ download.file_size ? (download.file_size / 1048576)|number_format(2) ~ ' MB' : trans('downloads::external_file') }}</dd><dt>{{ trans('downloads::requirements') }}</dt><dd>{{ download.requirements_html|default('—', true) }}</dd></dl><p><a class="download-button" href="/downloads/{{ download.slug }}/get"{% if download.source_type == 'external' %} target="_blank" rel="noopener noreferrer external"{% endif %}>{{ trans('downloads::download') }}</a></p>
<details class="report-download"><summary>{{ trans('downloads::report') }}</summary><form method="post" action="/downloads/{{ download.id }}/report"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="slug" value="{{ download.slug }}"><label>{{ trans('downloads::reason') }}<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><button type="submit">{{ trans('downloads::send_report') }}</button></form></details><p><a href="/downloads">{{ trans('downloads::return') }}</a></p></article>
{% endblock %}
