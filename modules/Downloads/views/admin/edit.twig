{% extends "layouts/admin.twig" %}{% set editor_title = trans(download.id|default(false) ? 'downloads::editor.edit' : 'downloads::editor.create') %}{% block title %}{{ editor_title }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}
<section class="admin-page nn-admin-workspace">{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('admin.title'), url: '/admin'}, {label: trans('downloads::title'), url: '/admin/downloads'}, {label: editor_title}]} only %}{% include 'components/admin-page-heading.twig' with {eyebrow: trans('downloads::admin.eyebrow'), title: editor_title, description: trans(download.id|default(false) ? 'downloads::editor.edit_help' : 'downloads::editor.create_help'), actions: [{label: trans('downloads::editor.back'), url: '/admin/downloads', icon: 'ph-arrow-left', variant: 'light'}]} only %}{% if error %}<div class="alert alert-danger d-flex align-items-start gap-2 nn-form-errors"><i class="ph-warning-circle mt-1"></i><div class="form-errors"><ul><li>{{ error }}</li></ul></div></div>{% endif %}
<form class="nn-admin-editor nn-golden-form" method="post" action="/admin/downloads/save" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ download.id|default('') }}">
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon"><i class="ph-file-arrow-down"></i></span><div><h2>{{ trans('downloads::editor.section_details') }}</h2><p>{{ trans('downloads::editor.section_details_help') }}</p></div></div><div class="nn-form-section-body"><div class="form-grid nn-form-grid"><label>{{ trans('downloads::field.name') }}<input name="name" required maxlength="200" value="{{ download.name|default('') }}"></label><label>{{ trans('downloads::field.slug') }}<input name="slug" required maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ download.slug|default('') }}"></label><label>{{ trans('downloads::field.category') }}<select name="category_id"><option value="">{{ trans('downloads::field.none') }}</option>{% for category in categories %}<option value="{{ category.id }}" {{ download.category_id|default(null) == category.id ? 'selected' : '' }}>{{ category.parent_name ? category.parent_name ~ ' / ' : '' }}{{ category.name }}</option>{% endfor %}</select></label><label>{{ trans('downloads::version') }}<input name="version" maxlength="50" value="{{ download.version|default('', true) }}"></label><label>{{ trans('downloads::author') }}<input name="author_name" maxlength="150" value="{{ download.author_name|default('', true) }}"></label><label>{{ trans('downloads::license') }}<input name="license_name" maxlength="150" value="{{ download.license_name|default('', true) }}"></label></div>
<div class="form-grid nn-form-grid"><label>{{ trans('downloads::field.description_format') }}<select name="description_format"><option value="html">{{ trans('downloads::field.html') }}</option><option value="markdown" {{ download.description_format|default('html') == 'markdown' ? 'selected' : '' }}>{{ trans('downloads::field.markdown') }}</option></select></label><label>{{ trans('downloads::field.requirements_format') }}<select name="requirements_format"><option value="html">{{ trans('downloads::field.html') }}</option><option value="markdown" {{ download.requirements_format|default('html') == 'markdown' ? 'selected' : '' }}>{{ trans('downloads::field.markdown') }}</option></select></label></div>
<label class="wide-field nn-wide-field">{{ trans('downloads::field.description') }}<textarea name="description" rows="12" required>{{ download.description|default('') }}</textarea><small>{{ trans('downloads::field.content_help') }}</small></label><label class="wide-field nn-wide-field">{{ trans('downloads::requirements') }}<textarea name="requirements" maxlength="2000">{{ download.requirements|default('', true) }}</textarea></label></div></section>
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon"><i class="ph-file-arrow-up"></i></span><div><h2>{{ trans('downloads::editor.section_source') }}</h2><p>{{ trans('downloads::editor.section_source_help') }}</p></div></div><div class="nn-form-section-body"><fieldset class="editor-panel nn-editor-panel"><legend>{{ trans('downloads::field.source') }}</legend><label><input type="radio" name="source_type" value="local" {{ download.source_type|default('local') == 'local' ? 'checked' : '' }}> {{ trans('downloads::field.local') }}</label><label><input type="radio" name="source_type" value="external" {{ download.source_type|default('local') == 'external' ? 'checked' : '' }}> {{ trans('downloads::field.external') }}</label><div class="form-grid nn-form-grid"><label>{{ trans('downloads::field.upload') }}<input type="file" name="download_file" accept=".zip,.pdf,.txt,.png,.jpg,.jpeg,.webp"><small>{{ trans('downloads::field.upload_help') }}{% if download.original_name|default(false) %} {{ trans('downloads::field.current', {name: download.original_name}) }}{% endif %}</small></label><label>{{ trans('downloads::field.external_url') }}<input type="url" name="external_url" maxlength="2048" value="{{ download.external_url|default('', true) }}"></label></div></fieldset></div></section>
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon is-publish"><i class="ph-paper-plane-tilt"></i></span><div><h2>{{ trans('downloads::editor.section_publish') }}</h2><p>{{ trans('downloads::editor.section_publish_help') }}</p></div></div><div class="nn-form-section-body"><div class="form-grid nn-form-grid"><label>{{ trans('downloads::field.image') }}<input name="image_path" value="{{ download.image_path|default('', true) }}" placeholder="/uploads/downloads/image.webp"></label><label>{{ trans('downloads::field.status') }}<select name="status"><option value="draft">{{ trans('downloads::field.draft') }}</option>{% if can_publish %}<option value="scheduled" {{ download.status|default('draft') == 'scheduled' ? 'selected' : '' }}>{{ trans('downloads::field.scheduled') }}</option><option value="published" {{ download.status|default('draft') == 'published' ? 'selected' : '' }}>{{ trans('downloads::field.published') }}</option>{% endif %}</select></label><label>{{ trans('downloads::field.publication_time') }}<input type="datetime-local" name="published_at" value="{{ download.published_at|default('', true)|replace({' ': 'T'}) }}"></label></div></div></section>
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon is-access"><i class="ph-lock-key"></i></span><div><h2>{{ trans('downloads::editor.section_access') }}</h2><p>{{ trans('downloads::editor.section_access_help') }}</p></div></div><div class="nn-form-section-body"><fieldset class="editor-panel nn-editor-panel"><legend>{{ trans('downloads::field.access') }}</legend><label><input type="radio" name="access_type" value="public" {{ download.access_type|default('public') == 'public' ? 'checked' : '' }}> {{ trans('downloads::field.public') }}</label><label><input type="radio" name="access_type" value="members" {{ download.access_type|default('public') == 'members' ? 'checked' : '' }}> {{ trans('downloads::field.members') }}</label><label><input type="radio" name="access_type" value="vip" {{ download.access_type|default('public') == 'vip' ? 'checked' : '' }}> {{ trans('downloads::field.vip') }}</label><label><input type="radio" name="access_type" value="roles" {{ download.access_type|default('public') == 'roles' ? 'checked' : '' }}> {{ trans('downloads::field.roles') }}</label><div class="role-checks">{% for role in roles %}<label><input type="checkbox" name="role_ids[]" value="{{ role.id }}" {{ role.id in download.role_ids|default([]) ? 'checked' : '' }}> {{ role.name }}</label>{% endfor %}</div></fieldset>
<label><input type="checkbox" name="is_featured" value="1" {{ download.is_featured|default(0) ? 'checked' : '' }}> {{ trans('downloads::field.featured') }}</label></div></section><div class="nn-editor-actions"><a href="/admin/downloads" class="btn btn-light"><i class="ph-x me-2"></i>{{ trans('downloads::editor.cancel') }}</a><button class="btn btn-primary text-white" type="submit"><i class="ph-floppy-disk me-2"></i>{{ trans('downloads::field.save') }}</button></div></form>
{% if download.id|default(false) %}<form class="delete-block-form nn-delete-card" method="post" action="/admin/downloads/{{ download.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> {{ trans('downloads::field.confirm_delete') }}</label><button class="danger-button" type="submit">{{ trans('downloads::field.delete') }}</button></form>{% endif %}</section>
{% endblock %}
