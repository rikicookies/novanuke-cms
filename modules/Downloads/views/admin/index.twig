{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('downloads::admin.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('downloads::title')}]} only %}
{% include 'components/admin-page-heading.twig' with {eyebrow: trans('downloads::admin.eyebrow'), title: trans('downloads::title'), description: trans('downloads::admin.description'), actions: [{label: trans('downloads::admin.create'), url: '/admin/downloads/new', icon:'ph-plus'}, {label: trans('downloads::admin.view'), url: '/downloads', icon:'ph-arrow-square-out'}]} only %}
{% if message %}<div class="alert alert-success border-0 shadow-sm"><i class="ph-check-circle me-2"></i>{{ message }}</div>{% endif %}{% if error %}<div class="alert alert-danger border-0 shadow-sm"><i class="ph-warning-circle me-2"></i>{{ error }}</div>{% endif %}
{% set audience_labels = {'public':trans('downloads::field.public'),'members':trans('downloads::field.members'),'vip':trans('downloads::field.vip'),'roles':trans('downloads::field.roles')} %}{% set status_labels = {'draft':trans('downloads::field.draft'),'scheduled':trans('downloads::field.scheduled'),'published':trans('downloads::field.published'),'deleted':trans('downloads::field.deleted')} %}{% set source_labels = {'local':trans('downloads::field.local'),'external':trans('downloads::field.external')} %}
<div class="card nn-golden-card">
 <div class="card-header py-3"><div class="d-flex align-items-center gap-2"><h5 class="mb-0">{{ trans('downloads::title') }}</h5><span class="badge bg-light text-muted">{{ downloads|length }}</span></div><div class="text-muted fs-sm mt-1">{{ trans('downloads::admin.description') }}</div></div>
{% if downloads|length %}
 <div class="table-responsive"><table class="table nn-golden-table mb-0"><thead><tr><th>{{ trans('downloads::admin.download') }}</th><th>{{ trans('downloads::admin.source') }}</th><th>{{ trans('downloads::admin.status') }}</th><th>{{ trans('downloads::admin.access') }}</th><th>{{ trans('downloads::admin.count') }}</th><th class="text-end">{{ trans('downloads::admin.actions') }}</th></tr></thead><tbody>
 {% for item in downloads %}<tr><td class="nn-primary-cell"><div class="fw-semibold text-body">{{ item.name }}</div><div class="text-muted fs-sm mt-1"><i class="ph-folder me-1"></i>{{ item.category_name|default(trans('downloads::uncategorized'), true) }}<span class="mx-1">·</span><i class="ph-link me-1"></i>/downloads/{{ item.slug }}</div></td><td><span class="d-inline-flex align-items-center gap-1"><i class="{{ item.source_type == 'external' ? 'ph-link-simple' : 'ph-file-arrow-down' }} text-muted"></i>{{ source_labels[item.source_type]|default(item.source_type) }}</span></td><td><span class="badge {{ item.status == 'published' ? 'bg-success bg-opacity-10 text-success' : 'bg-secondary bg-opacity-10 text-secondary' }}"><span class="nn-status-dot me-1"></span>{{ status_labels[item.status]|default(item.status) }}</span></td><td><i class="{{ item.access_type == 'public' ? 'ph-globe' : (item.access_type == 'vip' ? 'ph-star' : 'ph-users') }} text-muted me-1"></i>{{ audience_labels[item.access_type]|default(item.access_type) }}</td><td><span class="badge bg-light text-body"><i class="ph-download-simple me-1"></i>{{ item.download_count }}</span></td><td class="text-end"><div class="d-inline-flex gap-1"><a class="btn btn-light btn-icon btn-sm" href="/admin/downloads/{{ item.id }}/edit" title="{{ trans('downloads::admin.edit') }}"><i class="ph-pencil-simple"></i></a>{% if item.status == 'published' %}<a class="btn btn-light btn-icon btn-sm" href="/downloads/{{ item.slug }}" title="{{ trans('downloads::admin.view') }}"><i class="ph-arrow-square-out"></i></a>{% endif %}<details class="nn-more-actions d-inline-block"><summary class="btn btn-light btn-icon btn-sm"><i class="ph-dots-three-vertical"></i></summary><div class="nn-more-menu"><a href="/admin/downloads/{{ item.id }}/edit"><i class="ph-pencil-simple"></i>{{ trans('downloads::admin.edit') }}</a>{% if item.status == 'published' %}<a href="/downloads/{{ item.slug }}"><i class="ph-arrow-square-out"></i>{{ trans('downloads::admin.view') }}</a>{% endif %}</div></details></div></td></tr>{% endfor %}
 </tbody></table></div><div class="card-footer bg-white border-top text-muted fs-sm">{{ downloads|length }} {{ trans('downloads::title') }}</div>
{% else %}
<div class="card-body text-center py-5 nn-admin-empty-state"><span class="nn-taxonomy-icon bg-primary bg-opacity-10 text-primary mx-auto mb-3"><i class="ph-download-simple"></i></span><h5 class="mb-1">{{ trans('downloads::admin.empty') }}</h5><p class="text-muted mb-3">{{ trans('downloads::admin.empty_help') }}</p><a class="btn btn-primary" href="/admin/downloads/new"><i class="ph-plus me-2"></i>{{ trans('downloads::admin.create') }}</a></div>
{% endif %}
</div>
<div class="row g-4 mt-0 nn-admin-secondary-cards">
 <div class="col-xl-6"><div class="card nn-taxonomy-card h-100"><div class="card-body p-4"><div class="d-flex gap-3 align-items-start mb-3"><span class="nn-taxonomy-icon bg-primary bg-opacity-10 text-primary"><i class="ph-folder"></i></span><div><h5 class="mb-1">{{ trans('downloads::admin.create_category') }}</h5><div class="text-muted fs-sm">{{ trans('downloads::admin.create_category') }}</div></div></div><form method="post" action="/admin/downloads/category"><input type="hidden" name="_token" value="{{ csrf_token }}"><label class="form-label">{{ trans('downloads::field.name') }}</label><div class="d-flex gap-2"><input class="form-control" name="name" required maxlength="120"><button class="btn btn-primary text-nowrap" type="submit"><i class="ph-plus me-1"></i>{{ trans('downloads::admin.add_category') }}</button></div><details class="mt-3"><summary class="text-muted fs-sm nn-advanced-summary">{{ trans('downloads::field.slug') }} / {{ trans('downloads::field.parent') }} / {{ trans('downloads::field.description') }}</summary><div class="row g-3 mt-1"><div class="col-md-6"><label class="form-label">{{ trans('downloads::field.slug') }}</label><input class="form-control" name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*"></div><div class="col-md-6"><label class="form-label">{{ trans('downloads::field.parent') }}</label><select class="form-select" name="parent_id"><option value="">{{ trans('downloads::field.none') }}</option>{% for category in categories %}<option value="{{ category.id }}">{{ category.parent_name ? category.parent_name ~ ' / ' : '' }}{{ category.name }}</option>{% endfor %}</select></div><div class="col-12"><label class="form-label">{{ trans('downloads::field.description') }}</label><textarea class="form-control" name="description" maxlength="500"></textarea></div></div></details></form></div></div></div>
 <div class="col-xl-6"><div class="card nn-taxonomy-card h-100"><div class="card-body p-4"><div class="d-flex gap-3 align-items-start mb-3"><span class="nn-taxonomy-icon nn-report-icon"><i class="ph-flag"></i></span><div><h5 class="mb-1">{{ trans('downloads::admin.open_reports') }}</h5><div class="text-muted fs-sm">{{ reports|length }} {{ trans('downloads::admin.open_reports') }}</div></div></div>{% for report in reports %}<div class="nn-report-row d-flex justify-content-between gap-3 py-3"><div><div class="fw-semibold">{{ report.name }}</div><div class="text-muted fs-sm">{{ report.reporter }} · {{ report.reason }}</div><div class="text-muted fs-sm">{{ report.created_at }}</div></div><form method="post" action="/admin/download-reports/{{ report.id }}/resolve"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="btn btn-light btn-sm" type="submit"><i class="ph-check me-1"></i>{{ trans('downloads::admin.resolve') }}</button></form></div>{% else %}<div class="nn-empty-mini text-center py-4"><i class="ph-check-circle fs-1 text-success"></i><div class="fw-semibold mt-2">{{ trans('downloads::admin.no_reports') }}</div><div class="text-muted fs-sm mt-1">{{ trans('downloads::admin.no_reports_help') }}</div></div>{% endfor %}</div></div></div>
</div>
{% endblock %}
