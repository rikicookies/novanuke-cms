{% extends "layouts/default.twig" %}{% block title %}{{ trans('private-messages::blocked.title') }} — {{ trans('private-messages::title') }}{% endblock %}{% block content %}
<section class="messages-page module-page">{% include 'components/breadcrumbs.twig' with {items: [{label: trans('private-messages::home'), url: '/'}, {label: trans('private-messages::title'), url: '/messages'}, {label: trans('private-messages::blocked.title')}]} only %}{% include 'components/page-header.twig' with {eyebrow: trans('private-messages::account'), title: trans('private-messages::blocked.title'), description: trans('private-messages::blocked.description')} only %}{% include "@private-messages/_nav.twig" %}{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if blocks %}<div class="surface-list">{% for item in blocks %}<article class="surface-card"><div class="module-section-heading"><div><h2>{{ item.username }}</h2><div class="surface-card-meta"><span>{{ trans('private-messages::blocked.since', {date: item.created_at}) }}</span></div></div><form method="post" action="/messages/users/{{ item.id }}/unblock"><input type="hidden" name="_token" value="{{ csrf_token }}"><button>{{ trans('private-messages::blocked.unblock') }}</button></form></div></article>{% endfor %}</div>{% else %}{% include 'components/empty-state.twig' with {title: trans('private-messages::blocked.empty'), message: trans('private-messages::blocked.empty_help')} only %}{% endif %}</section>
{% endblock %}
