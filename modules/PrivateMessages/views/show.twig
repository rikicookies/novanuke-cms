{% extends "layouts/default.twig" %}{% block title %}{{ thread.subject }} — {{ trans('private-messages::title') }}{% endblock %}{% block content %}
<section class="messages-page module-page">{% include 'components/breadcrumbs.twig' with {items: [{label: trans('private-messages::home'), url: '/'}, {label: trans('private-messages::title'), url: '/messages'}, {label: thread.subject}]} only %}{% include 'components/page-header.twig' with {eyebrow: trans('private-messages::thread.with', {name: thread.other.username}), title: thread.subject, description: trans('private-messages::thread.description')} only %}{% include "@private-messages/_nav.twig" %}{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}<div class="conversation surface-list">{% for item in thread.messages %}<article class="private-message surface-card"><header class="module-section-heading"><div><strong>{{ item.username }}</strong><div class="surface-card-meta"><span>{{ item.created_at }}</span></div></div></header><div class="message-body">{{ item.body_html }}</div>{% if item.sender_id == thread.other.id %}<details><summary>{{ trans('private-messages::report_abuse') }}</summary><form class="form-surface" method="post" action="/messages/{{ item.id }}/report"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="conversation_id" value="{{ thread.id }}"><label>{{ trans('private-messages::reason') }}<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><button>{{ trans('private-messages::report') }}</button></form></details>{% endif %}</article>{% endfor %}</div><section class="module-section"><div class="module-section-heading"><div><h2>{{ trans('private-messages::reply') }}</h2><p>{{ trans('private-messages::reply.help') }}</p></div></div><form class="message-form" method="post" action="/messages/{{ thread.id }}/reply"><input type="hidden" name="_token" value="{{ csrf_token }}"><label>{{ trans('private-messages::field.format') }}<select name="body_format"><option value="markdown">{{ trans('private-messages::field.markdown') }}</option><option value="html">{{ trans('private-messages::field.html') }}</option></select></label><label>{{ trans('private-messages::reply') }}<textarea name="body" required minlength="2" maxlength="5000" rows="8"></textarea></label><button class="module-button-primary">{{ trans('private-messages::send_reply') }}</button></form></section><section class="module-section"><div class="module-section-heading"><div><h2>{{ trans('private-messages::actions') }}</h2><p>{{ trans('private-messages::actions.help') }}</p></div></div><div class="module-action-row"><form method="post" action="/messages/users/{{ thread.other.id }}/block"><input type="hidden" name="_token" value="{{ csrf_token }}"><button>{{ trans('private-messages::block', {name: thread.other.username}) }}</button></form><form method="post" action="/messages/{{ thread.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="danger-button">{{ trans('private-messages::remove') }}</button></form></div></section></section>
{% endblock %}
