{% extends "layouts/default.twig" %}{% block title %}{{ trans('private-messages::title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}
<section class="messages-page module-page">{% include 'components/breadcrumbs.twig' with {items: [{label: trans('private-messages::home'), url: '/'}, {label: trans('private-messages::title')}]} only %}{% include 'components/page-header.twig' with {eyebrow: trans('private-messages::account'), title: trans('private-messages::title'), description: trans('private-messages::inbox.description')} only %}{% include "@private-messages/_nav.twig" %}{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}{% if conversations %}<div class="message-list surface-list">{% for item in conversations %}<a class="message-row {{ item.unread ? 'unread' : '' }}" href="/messages/{{ item.id }}"><strong>{{ item.subject }}</strong><span>{{ item.other_username }}</span><small>{{ item.last_message_at }}</small></a>{% endfor %}</div>{% else %}{% include 'components/empty-state.twig' with {title: trans('private-messages::inbox.empty'), message: trans('private-messages::inbox.empty_help'), action_url: '/messages/compose', action_label: trans('private-messages::inbox.start')} only %}{% endif %}</section>
{% endblock %}
