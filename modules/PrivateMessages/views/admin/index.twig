{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('private-messages::admin.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<div class="nn-pm-admin-v2">
{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('private-messages::admin.title')}]} only %}
{% include 'components/admin-page-heading.twig' with {eyebrow: trans('private-messages::admin.eyebrow'), title: trans('private-messages::admin.title'), description: trans('private-messages::admin.description')} only %}

{% if message %}<div class="alert alert-success alert-icon-start"><span class="alert-icon bg-success text-white"><i class="ph-check"></i></span>{{ message }}</div>{% endif %}
{% if error %}<div class="alert alert-danger alert-icon-start"><span class="alert-icon bg-danger text-white"><i class="ph-warning"></i></span>{{ error }}</div>{% endif %}

<div class="row g-3 mb-4">
  <div class="col-md-5 col-xl-4"><div class="card h-100 nn-pm-summary"><div class="card-body d-flex align-items-center gap-3"><span class="nn-pm-summary-icon"><i class="ph-flag"></i></span><div><div class="text-muted fs-sm">{{ trans('private-messages::admin.metric.open_reports') }}</div><div class="fs-3 fw-bold">{{ reports|length }}</div><div class="text-muted fs-sm mt-1">{{ trans('private-messages::admin.metric.open_help') }}</div></div></div></div></div>
  <div class="col-md-7 col-xl-8"><div class="card h-100 nn-pm-privacy"><div class="card-body d-flex gap-3 align-items-start"><span class="nn-pm-privacy-icon"><i class="ph-shield-check"></i></span><div><h6 class="mb-1">{{ trans('private-messages::admin.privacy_title') }}</h6><p class="text-muted mb-0">{{ trans('private-messages::admin.privacy_help') }}</p></div></div></div></div>
</div>

<div class="card nn-pm-queue">
  <div class="card-header py-3 d-flex flex-column flex-md-row gap-2 align-items-md-center"><div class="me-auto"><h5 class="mb-1">{{ trans('private-messages::admin.queue_title') }}</h5><div class="text-muted fs-sm">{{ trans('private-messages::admin.queue_help') }}</div></div><span class="badge rounded-pill bg-danger bg-opacity-10 text-danger">{{ reports|length }} {{ trans('private-messages::admin.open') }}</span></div>
  {% if reports|length %}
  <div class="table-responsive"><table class="table table-hover align-middle mb-0 nn-pm-table"><thead><tr><th>{{ trans('private-messages::admin.users') }}</th><th>{{ trans('private-messages::admin.excerpt') }}</th><th>{{ trans('private-messages::reason') }}</th><th>{{ trans('private-messages::admin.reported_at') }}</th><th class="text-end">{{ trans('private-messages::admin.action') }}</th></tr></thead><tbody>
  {% for item in reports %}<tr>
    <td><div class="nn-pm-users"><span class="nn-pm-avatar"><i class="ph-user"></i></span><div><strong>{{ item.sender }}</strong><small><i class="ph-arrow-right me-1"></i>{{ trans('private-messages::admin.reported_by', {name:item.reporter}) }}</small></div></div></td>
    <td class="nn-pm-excerpt"><span>{{ item.body|striptags|slice(0,180) }}{% if item.body|striptags|length > 180 %}…{% endif %}</span></td>
    <td><span class="nn-pm-reason"><i class="ph-warning-circle"></i>{{ item.reason }}</span></td>
    <td class="text-nowrap text-muted fs-sm">{{ item.created_at }}</td>
    <td class="text-end"><form method="post" action="/admin/private-message-reports/{{ item.id }}/resolve"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="btn btn-success btn-sm text-nowrap" type="submit"><i class="ph-check-circle me-1"></i>{{ trans('private-messages::admin.resolve') }}</button></form></td>
  </tr>{% endfor %}
  </tbody></table></div>
  <div class="card-footer bg-white text-muted fs-sm"><i class="ph-info me-1"></i>{{ trans('private-messages::admin.queue_footer') }}</div>
  {% else %}
  <div class="nn-pm-empty"><span><i class="ph-check-circle"></i></span><h5>{{ trans('private-messages::admin.empty') }}</h5><p>{{ trans('private-messages::admin.empty_help') }}</p></div>
  {% endif %}
</div>
</div>
{% endblock %}
