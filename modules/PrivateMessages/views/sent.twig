{% extends "layouts/default.twig" %}{% block title %}{{ trans('private-messages::sent.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}
<section class="messages-page module-page">{% include 'components/breadcrumbs.twig' with {items: [{label: trans('private-messages::home'), url: '/'}, {label: trans('private-messages::title'), url: '/messages'}, {label: trans('private-messages::nav.sent')}]} only %}{% include 'components/page-header.twig' with {eyebrow: trans('private-messages::account'), title: trans('private-messages::sent.title'), description: trans('private-messages::sent.description')} only %}{% include "@private-messages/_nav.twig" %}{% if messages %}<div class="message-list surface-list">{% for item in messages %}<a class="message-row" href="/messages/{{ item.conversation_id }}"><strong>{{ item.subject }}</strong><span>{{ trans('private-messages::sent.to', {name: item.recipient}) }}</span><small>{{ item.created_at }}</small></a>{% endfor %}</div>{% else %}{% include 'components/empty-state.twig' with {title: trans('private-messages::sent.empty'), message: trans('private-messages::sent.empty_help'), action_url: '/messages/compose', action_label: trans('private-messages::sent.write')} only %}{% endif %}</section>
{% endblock %}
