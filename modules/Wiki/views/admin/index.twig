{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('wiki::admin.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="admin-page nn-admin-workspace nn-wiki-admin nn-wiki-v29">
{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('admin.title'), url: '/admin'}, {label: trans('wiki::index.title')}]} only %}
{% include 'components/admin-page-heading.twig' with {eyebrow: trans('wiki::admin.eyebrow'), title: trans('wiki::index.title'), description: trans('wiki::admin.description'), actions: [{label: trans('wiki::action.create'), url: '/admin/wiki/new'}, {label: trans('wiki::admin.missing_links'), url: '/admin/wiki/missing-links'}, {label: trans('wiki::admin.export_all'), url: '/admin/wiki/export-all'}]} only %}
{% if message %}<div class="nn-wiki-alert is-success"><i class="ph-check-circle"></i><span>{{ message }}</span></div>{% endif %}{% if import_error %}<div class="nn-wiki-alert is-danger"><i class="ph-warning-circle"></i><span>{{ import_error }}</span></div>{% endif %}
<section class="nn-wiki-tools"><div class="nn-wiki-section-title"><div><span>{{ trans('wiki::admin.eyebrow') }}</span><h2>{{ trans('wiki::admin.import_draft') }}</h2><p>{{ trans('wiki::admin.import_draft_help') }}</p></div></div><div class="nn-wiki-tool-grid">
<form class="nn-wiki-tool-card" method="post" action="/admin/wiki/import" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token }}"><div class="nn-wiki-tool-head"><span class="nn-wiki-tool-icon is-blue"><i class="ph-file-md"></i></span><div><h3>{{ trans('wiki::admin.import_draft') }}</h3><p>{{ trans('wiki::admin.import_draft_help') }}</p></div></div><label class="nn-wiki-file-field"><span>{{ trans('wiki::admin.import_draft') }}</span><input type="file" name="markdown_file" accept=".md,text/markdown,text/plain" required></label><button class="nn-wiki-primary" type="submit"><i class="ph-pencil-simple"></i>{{ trans('wiki::admin.open_editor') }}</button></form>
<form class="nn-wiki-tool-card" method="post" action="/admin/wiki/import-folder" enctype="multipart/form-data" data-wiki-folder-form data-empty-label="{{ trans('wiki::admin.folder_empty') }}" data-ignored-label="{{ trans('wiki::admin.js.ignored') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="markdown_expected_count" value="0" data-wiki-folder-count><div class="nn-wiki-tool-head"><span class="nn-wiki-tool-icon is-violet"><i class="ph-folder-open"></i></span><div><h3>{{ trans('wiki::admin.import_folder') }}</h3><p>{{ trans('wiki::admin.folder_help') }}</p></div></div><div class="nn-wiki-dropzone" tabindex="0" data-wiki-folder-drop><i class="ph-cloud-arrow-up"></i><span>{{ trans('wiki::admin.folder_drop') }}</span></div><label class="nn-wiki-file-field"><span>{{ trans('wiki::admin.folder_label') }}</span><input type="file" name="markdown_files[]" accept=".md,text/markdown,text/plain" webkitdirectory directory multiple required data-wiki-folder-input></label><div data-wiki-folder-paths></div><ol class="nn-wiki-folder-preview" data-wiki-folder-preview><li>{{ trans('wiki::admin.folder_empty') }}</li></ol><label class="nn-wiki-confirm"><input type="checkbox" name="confirm_import" value="1" required><span>{{ trans('wiki::admin.folder_confirm') }}</span></label><button class="nn-wiki-primary" type="submit"><i class="ph-folder-notch-open"></i>{{ trans('wiki::admin.import_folder') }}</button></form>
</div></section>
{% set audience_labels = {'public':trans('wiki::admin.audience.public'),'member':trans('wiki::admin.audience.member'),'vip':trans('wiki::admin.audience.vip')} %}{% set status_labels = {'draft':trans('wiki::admin.status.draft'),'published':trans('wiki::admin.status.published')} %}
<section class="nn-wiki-library"><header class="nn-wiki-library-head"><div><span>{{ trans('wiki::admin.page') }}</span><h2>{{ trans('wiki::index.title') }}</h2><p>{{ trans('wiki::admin.description') }}</p></div><span class="nn-wiki-total">{{ result.total }}</span></header>
<form class="nn-wiki-filters" method="get" action="/admin/wiki"><label>{{ trans('wiki::admin.search') }}<input type="search" name="q" value="{{ filters.q }}" maxlength="100" placeholder="{{ trans('wiki::admin.search_placeholder') }}"></label><label>{{ trans('wiki::admin.status') }}<select name="status"><option value="all"{{ filters.status == 'all' ? ' selected' : '' }}>{{ trans('wiki::admin.filter_all') }}</option><option value="published"{{ filters.status == 'published' ? ' selected' : '' }}>{{ trans('wiki::admin.status.published') }}</option><option value="draft"{{ filters.status == 'draft' ? ' selected' : '' }}>{{ trans('wiki::admin.status.draft') }}</option></select></label><label>{{ trans('wiki::admin.namespace') }}<select name="namespace"><option value="__all__"{{ filters.namespace is null ? ' selected' : '' }}>{{ trans('wiki::admin.all_namespaces') }}</option>{% for value in namespaces %}<option value="{{ value }}"{{ filters.namespace is not null and filters.namespace == value ? ' selected' : '' }}>{{ value == '' ? trans('wiki::admin.root_namespace') : value }}</option>{% endfor %}</select></label><label>{{ trans('wiki::admin.sort') }}<select name="sort"><option value="path"{{ filters.sort == 'path' ? ' selected' : '' }}>{{ trans('wiki::admin.sort_path') }}</option><option value="title_asc"{{ filters.sort == 'title_asc' ? ' selected' : '' }}>{{ trans('wiki::admin.sort_title_asc') }}</option><option value="title_desc"{{ filters.sort == 'title_desc' ? ' selected' : '' }}>{{ trans('wiki::admin.sort_title_desc') }}</option><option value="newest"{{ filters.sort == 'newest' ? ' selected' : '' }}>{{ trans('wiki::admin.sort_newest') }}</option><option value="oldest"{{ filters.sort == 'oldest' ? ' selected' : '' }}>{{ trans('wiki::admin.sort_oldest') }}</option><option value="updated"{{ filters.sort == 'updated' ? ' selected' : '' }}>{{ trans('wiki::admin.sort_updated') }}</option></select></label><label>{{ trans('wiki::admin.page_size') }}<select name="per_page">{% for size in [10,20,50,100] %}<option value="{{ size }}"{{ filters.per_page == size ? ' selected' : '' }}>{{ size }}</option>{% endfor %}</select></label><input type="hidden" name="page" value="1"><button class="nn-wiki-primary is-auto" type="submit"><i class="ph-funnel"></i>{{ trans('wiki::admin.apply_filters') }}</button></form>
<div class="nn-wiki-counts"><span>{{ trans('wiki::admin.count_all', {count: result.counts.all}) }}</span><span>{{ trans('wiki::admin.count_published', {count: result.counts.published}) }}</span><span>{{ trans('wiki::admin.count_draft', {count: result.counts.draft}) }}</span></div>
<form method="post" action="/admin/wiki/bulk" data-wiki-bulk-form data-select-label="{{ trans('wiki::admin.js.select_page') }}" data-delete-label="{{ trans('wiki::admin.js.delete_selected') }}" data-delete-plural-label="{{ trans('wiki::admin.js.delete_selected_plural') }}"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="page" value="{{ filters.page }}"><input type="hidden" name="per_page" value="{{ filters.per_page }}"><input type="hidden" name="status" value="{{ filters.status }}"><input type="hidden" name="q" value="{{ filters.q }}"><input type="hidden" name="sort" value="{{ filters.sort }}">{% if filters.namespace is not null %}<input type="hidden" name="namespace" value="{{ filters.namespace }}">{% endif %}<div class="nn-wiki-bulkbar"><label class="nn-wiki-bulk-select"><span>{{ trans('wiki::admin.bulk_action') }}</span><select name="bulk_action" required><option value="">{{ trans('wiki::admin.select_action') }}</option>{% if can_publish %}<option value="publish">{{ trans('wiki::admin.publish') }}</option>{% endif %}<option value="draft">{{ trans('wiki::admin.move_draft') }}</option>{% if can_publish %}<option value="audience_public">{{ trans('wiki::admin.audience_public') }}</option><option value="audience_member">{{ trans('wiki::admin.audience_member') }}</option><option value="audience_vip">{{ trans('wiki::admin.audience_vip') }}</option>{% endif %}<option value="delete">{{ trans('wiki::admin.delete') }}</option></select></label><label class="nn-wiki-confirm"><input type="checkbox" name="confirm_bulk" value="1" required><span>{{ trans('wiki::admin.bulk_confirm') }}</span></label><button class="nn-wiki-primary is-auto" type="submit"><i class="ph-check-square-offset"></i>{{ trans('wiki::admin.apply_selected') }}</button></div><div class="nn-wiki-table-wrap"><table class="nn-wiki-table"><thead><tr><th class="is-check"><label class="nn-wiki-check"><input type="checkbox" data-wiki-select-all><span>{{ trans('wiki::admin.current_page') }}</span></label></th><th>{{ trans('wiki::admin.page') }}</th><th>{{ trans('wiki::admin.status') }}</th><th>{{ trans('wiki::admin.audience') }}</th><th>{{ trans('wiki::admin.updated') }}</th><th></th></tr></thead><tbody>
{% for page in pages %}{% set path = page.namespace ? page.namespace ~ ':' ~ page.slug : page.slug %}<tr><td><input type="checkbox" name="page_ids[]" value="{{ page.id }}" data-wiki-page-checkbox aria-label="{{ trans('wiki::admin.select_page', {title: page.title}) }}"></td><td><div class="nn-wiki-page-cell"><strong>{{ page.title }}</strong><small>/wiki/{{ path }} · {{ page.username }} · {{ page.namespace ? page.namespace : trans('wiki::admin.root_namespace') }}</small></div></td><td><span class="nn-wiki-badge {{ page.status == 'published' ? 'is-published' : 'is-draft' }}">{{ status_labels[page.status]|default(page.status) }}</span></td><td><span class="nn-wiki-audience"><i class="{{ page.audience == 'vip' ? 'ph-crown' : (page.audience == 'member' ? 'ph-users' : 'ph-globe') }}"></i>{{ audience_labels[page.audience]|default(page.audience) }}</span></td><td class="nn-wiki-date">{{ page.updated_at }}</td><td><div class="nn-wiki-row-actions"><a href="/admin/wiki/{{ page.id }}/edit">{{ trans('wiki::action.edit') }}</a><a href="/admin/wiki/{{ page.id }}/history">{{ trans('wiki::admin.history') }}</a></div></td></tr>{% else %}<tr><td colspan="6"><div class="nn-wiki-empty"><i class="ph-notebook"></i><span>{{ trans('wiki::admin.empty_filtered') }}</span></div></td></tr>{% endfor %}
</tbody></table></div></form>
{% set pagination_url = '/admin/wiki?page={page}&per_page=' ~ filters.per_page ~ '&status=' ~ (filters.status|url_encode) ~ '&sort=' ~ (filters.sort|url_encode) ~ '&q=' ~ (filters.q|url_encode) ~ (filters.namespace is not null ? '&namespace=' ~ (filters.namespace|url_encode) : '') %}{% include 'components/pagination.twig' with {current_page: result.page, total_pages: result.pages, url_template: pagination_url, label: trans('wiki::admin.pagination')} only %}
</section></section><script src="/wiki-assets/folder-import.js" defer></script><script src="/wiki-assets/bulk-actions.js" defer></script>
{% endblock %}
