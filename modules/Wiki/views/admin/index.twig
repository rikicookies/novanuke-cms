{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('wiki::admin.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
<section class="admin-page nn-admin-workspace nn-wiki-admin nn-wiki-v29">
    {% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('admin.title'), url: '/admin'}, {label: trans('wiki::index.title')}]} only %}
    {% include 'components/admin-page-heading.twig' with {eyebrow: trans('wiki::admin.eyebrow'), title: trans('wiki::index.title'), description: trans('wiki::admin.description'), actions: [{label: trans('wiki::action.create'), url: '/admin/wiki/new'}, {label: trans('wiki::admin.export_all'), url: '/admin/wiki/export-all'}]} only %}

    {% if message %}<div class="nn-wiki-alert is-success"><i class="ph-check-circle"></i><span>{{ message }}</span></div>{% endif %}
    {% if import_error %}<div class="nn-wiki-alert is-danger"><i class="ph-warning-circle"></i><span>{{ import_error }}</span></div>{% endif %}

    <section class="nn-wiki-tools">
      <div class="nn-wiki-section-title"><div><span>{{ trans('wiki::admin.eyebrow') }}</span><h2>{{ trans('wiki::admin.import_draft') }}</h2><p>{{ trans('wiki::admin.import_draft_help') }}</p></div></div>
      <div class="nn-wiki-tool-grid">
        <form class="nn-wiki-tool-card" method="post" action="/admin/wiki/import" enctype="multipart/form-data">
          <input type="hidden" name="_token" value="{{ csrf_token }}">
          <div class="nn-wiki-tool-head"><span class="nn-wiki-tool-icon is-blue"><i class="ph-file-md"></i></span><div><h3>{{ trans('wiki::admin.import_draft') }}</h3><p>{{ trans('wiki::admin.import_draft_help') }}</p></div></div>
          <label class="nn-wiki-file-field"><span>{{ trans('wiki::admin.import_draft') }}</span><input type="file" name="markdown_file" accept=".md,text/markdown,text/plain" required></label>
          <button class="nn-wiki-primary" type="submit"><i class="ph-pencil-simple"></i>{{ trans('wiki::admin.open_editor') }}</button>
        </form>

        <form class="nn-wiki-tool-card" method="post" action="/admin/wiki/import-folder" enctype="multipart/form-data" data-wiki-folder-form data-empty-label="{{ trans('wiki::admin.folder_empty') }}" data-ignored-label="{{ trans('wiki::admin.js.ignored') }}">
          <input type="hidden" name="_token" value="{{ csrf_token }}">
          <input type="hidden" name="markdown_expected_count" value="0" data-wiki-folder-count>
          <div class="nn-wiki-tool-head"><span class="nn-wiki-tool-icon is-violet"><i class="ph-folder-open"></i></span><div><h3>{{ trans('wiki::admin.import_folder') }}</h3><p>{{ trans('wiki::admin.folder_help') }}</p></div></div>
          <div class="nn-wiki-dropzone" tabindex="0" data-wiki-folder-drop><i class="ph-cloud-arrow-up"></i><span>{{ trans('wiki::admin.folder_drop') }}</span></div>
          <label class="nn-wiki-file-field"><span>{{ trans('wiki::admin.folder_label') }}</span><input type="file" name="markdown_files[]" accept=".md,text/markdown,text/plain" webkitdirectory directory multiple required data-wiki-folder-input></label>
          <div data-wiki-folder-paths></div><ol class="nn-wiki-folder-preview" data-wiki-folder-preview><li>{{ trans('wiki::admin.folder_empty') }}</li></ol>
          <label class="nn-wiki-confirm"><input type="checkbox" name="confirm_import" value="1" required><span>{{ trans('wiki::admin.folder_confirm') }}</span></label>
          <button class="nn-wiki-primary" type="submit"><i class="ph-folder-notch-open"></i>{{ trans('wiki::admin.import_folder') }}</button>
        </form>
      </div>
    </section>

    {% set audience_labels = {'public':trans('wiki::admin.audience.public'),'member':trans('wiki::admin.audience.member'),'vip':trans('wiki::admin.audience.vip')} %}
    {% set status_labels = {'draft':trans('wiki::admin.status.draft'),'published':trans('wiki::admin.status.published')} %}
    <section class="nn-wiki-library">
      <header class="nn-wiki-library-head"><div><span>{{ trans('wiki::admin.page') }}</span><h2>{{ trans('wiki::index.title') }}</h2><p>{{ trans('wiki::admin.description') }}</p></div><span class="nn-wiki-total">{{ pages|length }}</span></header>
      <form method="post" action="/admin/wiki/bulk" data-wiki-bulk-form data-select-label="{{ trans('wiki::admin.js.select_page') }}" data-delete-label="{{ trans('wiki::admin.js.delete_selected') }}" data-delete-plural-label="{{ trans('wiki::admin.js.delete_selected_plural') }}">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <div class="nn-wiki-bulkbar">
          <label class="nn-wiki-bulk-select"><span>{{ trans('wiki::admin.bulk_action') }}</span><select name="bulk_action" required><option value="">{{ trans('wiki::admin.select_action') }}</option>{% if can_publish %}<option value="publish">{{ trans('wiki::admin.publish') }}</option>{% endif %}<option value="draft">{{ trans('wiki::admin.move_draft') }}</option>{% if can_publish %}<option value="audience_public">{{ trans('wiki::admin.audience_public') }}</option><option value="audience_member">{{ trans('wiki::admin.audience_member') }}</option><option value="audience_vip">{{ trans('wiki::admin.audience_vip') }}</option>{% endif %}<option value="delete">{{ trans('wiki::admin.delete') }}</option></select></label>
          <label class="nn-wiki-confirm"><input type="checkbox" name="confirm_bulk" value="1" required><span>{{ trans('wiki::admin.bulk_confirm') }}</span></label>
          <button class="nn-wiki-primary is-auto" type="submit"><i class="ph-check-square-offset"></i>{{ trans('wiki::admin.apply_selected') }}</button>
        </div>
        <div class="nn-wiki-table-wrap"><table class="nn-wiki-table"><thead><tr><th class="is-check"><label class="nn-wiki-check"><input type="checkbox" data-wiki-select-all><span>{{ trans('wiki::admin.all') }}</span></label></th><th>{{ trans('wiki::admin.page') }}</th><th>{{ trans('wiki::admin.status') }}</th><th>{{ trans('wiki::admin.audience') }}</th><th>{{ trans('wiki::admin.updated') }}</th><th></th></tr></thead><tbody>
          {% for page in pages %}<tr><td><input type="checkbox" name="page_ids[]" value="{{ page.id }}" data-wiki-page-checkbox aria-label="{{ trans('wiki::admin.select_page', {title: page.title}) }}"></td><td><div class="nn-wiki-page-cell"><strong>{{ page.title }}</strong><small>/wiki/{{ page.namespace ? page.namespace ~ ':' : '' }}{{ page.slug }} · {{ page.username }}</small></div></td><td><span class="nn-wiki-badge {{ page.status == 'published' ? 'is-published' : 'is-draft' }}">{{ status_labels[page.status]|default(page.status) }}</span></td><td><span class="nn-wiki-audience"><i class="{{ page.audience == 'vip' ? 'ph-crown' : (page.audience == 'member' ? 'ph-users' : 'ph-globe') }}"></i>{{ audience_labels[page.audience]|default(page.audience) }}</span></td><td class="nn-wiki-date">{{ page.updated_at }}</td><td><div class="nn-wiki-row-actions"><a href="/admin/wiki/{{ page.id }}/edit">{{ trans('wiki::action.edit') }}</a><a href="/admin/wiki/{{ page.id }}/history">{{ trans('wiki::admin.history') }}</a></div></td></tr>{% else %}<tr><td colspan="6"><div class="nn-wiki-empty"><i class="ph-notebook"></i><span>{{ trans('wiki::admin.empty') }}</span></div></td></tr>{% endfor %}
        </tbody></table></div>
      </form>
    </section>

    <section class="nn-wiki-missing">
      <header><div><span>{{ trans('wiki::admin.missing_links') }}</span><h2>{{ trans('wiki::admin.missing_links') }}</h2><p>{{ trans('wiki::admin.missing_links_help') }}</p></div><span class="nn-wiki-total is-amber">{{ missing_links|length }}</span></header>
      {% if missing_links %}<div class="nn-wiki-table-wrap"><table class="nn-wiki-table"><thead><tr><th>{{ trans('wiki::admin.missing_path') }}</th><th>{{ trans('wiki::admin.references') }}</th><th></th></tr></thead><tbody>{% for link in missing_links %}<tr><td><code>{{ link.target_path }}</code></td><td>{{ link.references }}</td><td><div class="nn-wiki-row-actions"><a href="/admin/wiki/new?path={{ link.target_path|url_encode }}">{{ trans('wiki::admin.create_page') }}</a></div></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="nn-wiki-empty is-good"><i class="ph-check-circle"></i><span>{{ trans('wiki::admin.no_missing_links') }}</span></div>{% endif %}
    </section>
</section>
<script src="/wiki-assets/folder-import.js" defer></script>
<script src="/wiki-assets/bulk-actions.js" defer></script>
{% endblock %}
