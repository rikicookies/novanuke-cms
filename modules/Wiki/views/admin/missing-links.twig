{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('wiki::admin.missing_links') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}<section class="admin-page nn-admin-workspace nn-wiki-admin">{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('admin.title'), url: '/admin'}, {label: trans('wiki::index.title'), url: '/admin/wiki'}, {label: trans('wiki::admin.missing_links')}]} only %}{% include 'components/admin-page-heading.twig' with {eyebrow: trans('wiki::admin.eyebrow'), title: trans('wiki::admin.missing_links'), description: trans('wiki::admin.missing_links_help'), actions: [{label: trans('wiki::admin.back_to_pages'), url: '/admin/wiki'}]} only %}{% if missing_links %}<div class="nn-wiki-table-wrap"><table class="nn-wiki-table"><thead><tr><th>{{ trans('wiki::admin.missing_path') }}</th><th>{{ trans('wiki::admin.references') }}</th><th></th></tr></thead><tbody>{% for link in missing_links %}<tr><td><code>{{ link.target_path }}</code></td><td>{{ link.references }}</td><td><div class="nn-wiki-row-actions"><a href="/admin/wiki/new?path={{ link.target_path|url_encode }}">{{ trans('wiki::admin.create_page') }}</a></div></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="nn-wiki-empty is-good"><i class="ph-check-circle"></i><span>{{ trans('wiki::admin.no_missing_links') }}</span></div>{% endif %}</section>{% endblock %}
