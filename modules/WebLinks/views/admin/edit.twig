{% extends "layouts/admin.twig" %}{% set editor_title = trans(link.id|default(null) ? 'web-links::editor.edit' : 'web-links::editor.create') %}{% block title %}{{ editor_title }} — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}
{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('admin.title'), url: '/admin'}, {label: trans('web-links::title'), url: '/admin/web-links'}, {label: editor_title}]} only %}
{% include 'components/admin-page-heading.twig' with {eyebrow: trans('web-links::title'), title: editor_title, description: trans(link.id|default(null) ? 'web-links::editor.edit_help' : 'web-links::editor.create_help'), actions: [{label: trans('web-links::editor.back'), url:'/admin/web-links', icon:'ph-arrow-left', variant:'light'}]} only %}
{% if error %}<div class="alert alert-danger d-flex gap-2"><i class="ph-warning-circle mt-1"></i><div>{{ error }}</div></div>{% endif %}
<form class="nn-admin-editor nn-golden-form" method="post" action="/admin/web-links/save"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ link.id|default('') }}">
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon"><i class="ph-link"></i></span><div><h2>{{ trans('web-links::editor.section_details') }}</h2><p>{{ trans('web-links::editor.section_details_help') }}</p></div></div><div class="nn-form-section-body"><div class="form-grid nn-form-grid"><label>{{ trans('web-links::field.title') }}<input name="title" required maxlength="200" value="{{ link.title|default('') }}"></label><label>{{ trans('web-links::field.slug') }}<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ link.slug|default('') }}"></label><label class="nn-span-2">{{ trans('web-links::field.url') }}<input type="url" name="url" required maxlength="2048" value="{{ link.url|default('') }}"></label><label>{{ trans('web-links::field.category') }}<select name="category_id"><option value="">{{ trans('web-links::field.none') }}</option>{% for category in categories %}<option value="{{ category.id }}" {{ link.category_id|default(null) == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></label><label>{{ trans('web-links::field.image_path') }}<input name="image_path" maxlength="255" value="{{ link.image_path|default('') }}"></label></div></div></section>
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon is-publish"><i class="ph-text-aa"></i></span><div><h2>{{ trans('web-links::editor.section_content') }}</h2><p>{{ trans('web-links::editor.section_content_help') }}</p></div></div><div class="nn-form-section-body"><div class="mb-3"><label class="form-label">{{ trans('web-links::field.content_format') }}</label><select class="form-select nn-field-compact" name="description_format"><option value="html">{{ trans('web-links::field.html') }}</option><option value="markdown" {{ link.description_format|default('html') == 'markdown' ? 'selected' : '' }}>{{ trans('web-links::field.markdown') }}</option></select></div><label class="wide-field nn-wide-field">{{ trans('web-links::field.description') }}<textarea name="description" required rows="10">{{ link.description|default('') }}</textarea><small>{{ trans('web-links::field.sanitized_help') }}</small></label><label class="nn-feature-check"><input type="checkbox" name="is_featured" value="1" {{ link.is_featured|default(false) ? 'checked' : '' }}> {{ trans('web-links::featured') }}</label></div></section>
<section class="nn-form-section"><div class="nn-form-section-header"><span class="nn-form-section-icon is-access"><i class="ph-shield-check"></i></span><div><h2>{{ trans('web-links::editor.section_publish') }}</h2><p>{{ trans('web-links::editor.section_publish_help') }}</p></div></div><div class="nn-form-section-body"><div class="form-grid nn-form-grid"><label>{{ trans('web-links::field.status') }}<select name="status"><option value="pending">{{ trans('web-links::field.pending') }}</option><option value="published" {{ link.status|default('') == 'published' ? 'selected' : '' }}>{{ trans('web-links::field.published') }}</option><option value="rejected" {{ link.status|default('') == 'rejected' ? 'selected' : '' }}>{{ trans('web-links::field.rejected') }}</option></select></label></div><fieldset class="editor-panel nn-editor-panel mt-3"><legend>{{ trans('web-links::field.audience') }}</legend><label><input type="radio" name="audience" value="public" {{ link.audience|default('public') == 'public' ? 'checked' : '' }}> {{ trans('web-links::field.public') }}</label><label><input type="radio" name="audience" value="member" {{ link.audience|default('public') == 'member' ? 'checked' : '' }}> {{ trans('web-links::field.members') }}</label><label><input type="radio" name="audience" value="vip" {{ link.audience|default('public') == 'vip' ? 'checked' : '' }}> {{ trans('web-links::field.vip') }}</label></fieldset></div></section>
<div class="nn-editor-actions"><a href="/admin/web-links" class="btn btn-light"><i class="ph-x me-2"></i>{{ trans('web-links::editor.cancel') }}</a><button class="btn btn-primary" type="submit"><i class="ph-floppy-disk me-2"></i>{{ trans('web-links::editor.save') }}</button></div></form>
{% if link.id|default(false) %}<form class="nn-delete-card" method="post" action="/admin/web-links/{{ link.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><div><div class="fw-semibold text-danger">{{ trans('web-links::editor.delete_zone') }}</div><div class="text-muted fs-sm">{{ trans('web-links::editor.delete_help') }}</div></div><label class="ms-auto"><input type="checkbox" name="confirm_delete" value="1" required> {{ trans('web-links::admin.confirm') }}</label><button class="btn btn-danger" type="submit">{{ trans('web-links::admin.delete') }}</button></form>{% endif %}
{% endblock %}
