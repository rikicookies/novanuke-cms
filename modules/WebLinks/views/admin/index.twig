{% extends "layouts/admin.twig" %}
{% block title %}{{ trans('web-links::admin.title') }} — {{ cms_name|default('NovaNuke') }}{% endblock %}
{% block content %}
{% include 'components/admin-breadcrumb.twig' with {items: [{label: trans('admin.title'), url: '/admin'}, {label: trans('web-links::title')}]} only %}
{% include 'components/admin-page-heading.twig' with {eyebrow: trans('web-links::admin.eyebrow'), title: trans('web-links::title'), description: trans('web-links::admin.description'), actions: [{label: trans('web-links::admin.create'), url: '/admin/web-links/new', icon:'ph-plus'}, {label: trans('web-links::admin.view'), url: '/links', icon:'ph-arrow-square-out'}]} only %}
{% if message %}<div class="alert alert-success border-0 shadow-sm"><i class="ph-check-circle me-2"></i>{{ message }}</div>{% endif %}
{% if error %}<div class="alert alert-danger border-0 shadow-sm"><i class="ph-warning-circle me-2"></i>{{ error }}</div>{% endif %}
{% set published_count = 0 %}{% set pending_count = 0 %}{% for item in links %}{% if item.status == 'published' %}{% set published_count = published_count + 1 %}{% elseif item.status == 'pending' %}{% set pending_count = pending_count + 1 %}{% endif %}{% endfor %}
<div class="row g-3 mb-4 nn-content-metrics">
 <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="nn-metric-icon"><i class="ph-link"></i></span><div><div class="text-muted fs-sm">{{ trans('web-links::admin.total') }}</div><div class="fs-3 fw-semibold">{{ links|length }}</div></div></div></div></div>
 <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="nn-metric-icon is-success"><i class="ph-check-circle"></i></span><div><div class="text-muted fs-sm">{{ trans('web-links::admin.published_count') }}</div><div class="fs-3 fw-semibold">{{ published_count }}</div></div></div></div></div>
 <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="nn-metric-icon is-warning"><i class="ph-clock"></i></span><div><div class="text-muted fs-sm">{{ trans('web-links::admin.pending_count') }}</div><div class="fs-3 fw-semibold">{{ pending_count }}</div></div></div></div></div>
 <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="nn-metric-icon is-danger"><i class="ph-flag"></i></span><div><div class="text-muted fs-sm">{{ trans('web-links::admin.open_reports_count') }}</div><div class="fs-3 fw-semibold">{{ reports|length }}</div></div></div></div></div>
</div>
{% set audience_labels = {'public':trans('web-links::field.public'),'member':trans('web-links::field.members'),'vip':trans('web-links::field.vip')} %}
{% set status_labels = {'pending':trans('web-links::field.pending'),'published':trans('web-links::field.published'),'rejected':trans('web-links::field.rejected')} %}
<div class="card mb-4 nn-golden-card">
 <div class="card-header py-3"><h5 class="mb-0">{{ trans('web-links::admin.directory') }}</h5><div class="text-muted fs-sm mt-1">{{ trans('web-links::admin.directory_help') }}</div></div>
 {% if links|length %}<div class="table-responsive"><table class="table table-hover mb-0 nn-golden-table"><thead><tr><th>{{ trans('web-links::admin.link') }}</th><th>{{ trans('web-links::admin.status') }}</th><th>{{ trans('web-links::admin.audience') }}</th><th>{{ trans('web-links::visits') }}</th><th>{{ trans('web-links::admin.submitted_by') }}</th><th class="text-end">{{ trans('web-links::admin.actions') }}</th></tr></thead><tbody>
 {% for item in links %}<tr><td class="nn-primary-cell"><div class="fw-semibold">{{ item.title }} {% if item.is_featured %}<span class="badge bg-warning bg-opacity-10 text-warning ms-1">{{ trans('web-links::admin.featured_badge') }}</span>{% endif %}</div><div class="text-muted fs-sm mt-1"><i class="ph-folder me-1"></i>{{ item.category_name|default(trans('web-links::admin.no_category'),true) }}<span class="mx-1">·</span><i class="ph-link-simple me-1"></i>{{ item.url }}</div></td><td><span class="badge {{ item.status == 'published' ? 'bg-success bg-opacity-10 text-success' : (item.status == 'pending' ? 'bg-warning bg-opacity-10 text-warning' : 'bg-danger bg-opacity-10 text-danger') }}">{{ status_labels[item.status]|default(item.status) }}</span></td><td><i class="{{ item.audience == 'public' ? 'ph-globe' : (item.audience == 'vip' ? 'ph-crown' : 'ph-users') }} text-muted me-1"></i>{{ audience_labels[item.audience]|default(item.audience) }}</td><td><span class="badge bg-light text-body"><i class="ph-cursor-click me-1"></i>{{ item.visit_count }}</span></td><td>{{ item.submitter }}</td><td class="text-end"><div class="d-inline-flex gap-1"><a class="btn btn-light btn-icon btn-sm" href="/admin/web-links/{{ item.id }}/edit" title="{{ trans('web-links::admin.edit') }}"><i class="ph-pencil-simple"></i></a>{% if item.status == 'published' %}<a class="btn btn-light btn-icon btn-sm" href="/links/{{ item.slug }}" title="{{ trans('web-links::admin.view') }}"><i class="ph-arrow-square-out"></i></a>{% endif %}</div></td></tr>{% endfor %}
 </tbody></table></div>{% else %}<div class="card-body text-center py-5 nn-admin-empty-state"><i class="ph-link fs-1 text-muted"></i><h5 class="mt-3 mb-1">{{ trans('web-links::admin.empty') }}</h5><p class="text-muted">{{ trans('web-links::admin.empty_help') }}</p><a class="btn btn-primary" href="/admin/web-links/new"><i class="ph-plus me-2"></i>{{ trans('web-links::admin.create') }}</a></div>{% endif %}
</div>
<div class="row g-4 nn-admin-secondary-cards">
 <div class="col-xl-5"><form class="card h-100 nn-taxonomy-card" method="post" action="/admin/web-links/category"><input type="hidden" name="_token" value="{{ csrf_token }}"><div class="card-body p-4"><div class="d-flex gap-3 mb-3"><span class="nn-taxonomy-icon bg-primary bg-opacity-10 text-primary"><i class="ph-folder-plus"></i></span><div><h5 class="mb-1">{{ trans('web-links::admin.create_category') }}</h5><div class="text-muted fs-sm">{{ trans('web-links::admin.category_help') }}</div></div></div><div class="mb-3"><label class="form-label">{{ trans('web-links::admin.name') }}</label><input class="form-control" name="name" required maxlength="120"></div><div class="mb-3"><label class="form-label">{{ trans('web-links::field.slug') }}</label><input class="form-control" name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*"></div><div class="mb-3"><label class="form-label">{{ trans('web-links::field.description') }}</label><textarea class="form-control" name="description" maxlength="500" rows="3"></textarea></div><button class="btn btn-primary" type="submit"><i class="ph-plus me-2"></i>{{ trans('web-links::admin.add_category') }}</button></div></form></div>
 <div class="col-xl-7"><div class="card h-100"><div class="card-header py-3"><h5 class="mb-0">{{ trans('web-links::admin.broken_reports') }}</h5><div class="text-muted fs-sm mt-1">{{ trans('web-links::admin.reports_help') }}</div></div><div class="card-body p-0">{% for item in reports %}<div class="nn-report-row d-flex justify-content-between align-items-start gap-3 p-3"><div><div class="fw-semibold">{{ item.title }}</div><div class="text-muted fs-sm">{{ item.reporter }} · {{ item.reason }}</div><div class="text-muted fs-sm mt-1">{{ item.created_at }}</div></div><form method="post" action="/admin/web-link-reports/{{ item.id }}/resolve"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="btn btn-light btn-sm" type="submit"><i class="ph-check me-1"></i>{{ trans('web-links::admin.resolve') }}</button></form></div>{% else %}<div class="text-center py-5"><i class="ph-check-circle fs-1 text-success"></i><div class="fw-semibold mt-2">{{ trans('web-links::admin.no_reports') }}</div><div class="text-muted fs-sm">{{ trans('web-links::admin.no_reports_help') }}</div></div>{% endfor %}</div></div></div>
</div>
{% endblock %}
