{% extends "layouts/default.twig" %}{% block title %}{{ link.title }} — {{ trans('web-links::title') }}{% endblock %}{% block content %}
<article class="link-detail">
{% include 'components/breadcrumbs.twig' with {items: [{label: trans('web-links::title'), url: '/links'}, {label: link.title}]} only %}
{% include 'components/content-actions.twig' with {edit_url: edit_url|default(null), delete_url: delete_url|default(null), csrf_token: content_csrf_token|default(null), return_to: delete_return_to|default(null)} only %}
<p class="eyebrow">{{ link.category_name|default(trans('web-links::detail_fallback'),true) }}</p><h1>{{ link.title }}</h1>{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}{% if link.image_path %}<img src="{{ link.image_path }}" alt="">{% endif %}<div class="article-content">{{ link.description_html }}</div><p><a class="download-button" href="/links/{{ link.slug }}/visit" target="_blank" rel="noopener noreferrer nofollow external">{{ trans('web-links::visit_website') }}</a></p><small>{{ trans('web-links::recorded_visits', {count: link.visit_count}) }}</small><details class="report-download"><summary>{{ trans('web-links::report') }}</summary><form method="post" action="/links/{{ link.id }}/report"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="slug" value="{{ link.slug }}"><label>{{ trans('web-links::reason') }}<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><button>{{ trans('web-links::submit_report') }}</button></form></details>
</article>
{% endblock %}
