if ($command === 'rc:deployment') {
    try{
        $checks=$application->container()->get(ReleaseCandidateDeploymentCheck::class)->run();
        $passed=true;
        fwrite(STDOUT,'NovaNuke '.Version::CURRENT." RC deployment preflight\n\n");
        $currentGroup=null;
        foreach($checks as $check){
            if($currentGroup!==$check['group']){
                $currentGroup=$check['group'];
                fwrite(STDOUT,"\n[".strtoupper($currentGroup)."]\n");
            }
            if($check['required']) $passed=$passed&&$check['passed'];
            $status=$check['passed']?'PASS':($check['required']?'FAIL':'WARN');
            fwrite($check['required']&&!$check['passed']?STDERR:STDOUT,"[{$status}] {$check['name']}: {$check['detail']}\n");
        }
        exit($passed?0:1);
    }catch(Throwable $error){
        fwrite(STDERR,"RC deployment preflight failed: {$error->getMessage()}\n");
        exit(1);
    }
}

