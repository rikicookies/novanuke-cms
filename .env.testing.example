# Used only by tests/run-integration.php. Copy to .env.testing and adjust the
# disposable test-server credentials for local development; never use a live
# application database or production credentials here.
NOVANUKE_RUN_INTEGRATION=1
NOVANUKE_TEST_DB_HOST=127.0.0.1
NOVANUKE_TEST_DB_PORT=3306
NOVANUKE_TEST_DB_USERNAME=root
NOVANUKE_TEST_DB_PASSWORD=
